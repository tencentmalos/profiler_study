<suki:SukiWindow
    x:Class="ProfilerStudy.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProfilerStudy.Avalonia"
    xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:stats="clr-namespace:ProfilerStudy.Avalonia.ProfilerStats"
    Title="ProfilerStudy"
    Width="1180"
    Height="760"
    WindowState="Maximized"
    Icon="/Assets/AppIcon.ico"
    IsMenuVisible="False"
    MinWidth="860"
    MinHeight="560">
  <suki:SukiWindow.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenSessionCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSessionCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenFindScopeCommand}" />
    <KeyBinding Gesture="Home" Command="{Binding ResetTimelineCommand}" />
    <KeyBinding Gesture="End" Command="{Binding SelectLastFrameCommand}" />
    <KeyBinding Gesture="PageUp" Command="{Binding SelectPreviousSpikeCommand}" />
    <KeyBinding Gesture="PageDown" Command="{Binding SelectNextSpikeCommand}" />
    <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding PanTimelineLeftCommand}" />
    <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding PanTimelineRightCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomTimelineInCommand}" />
    <KeyBinding Gesture="Ctrl+-" Command="{Binding ZoomTimelineOutCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding TrackSelectedFrameCommand}" />
  </suki:SukiWindow.KeyBindings>
  <suki:SukiWindow.Styles>
    <Style Selector="Button.toolbar-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="#1F2933" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.toolbar-button:pointerover">
      <Setter Property="Background" Value="#E7EEF7" />
    </Style>
    <Style Selector="Button.toolbar-button:pressed">
      <Setter Property="Background" Value="#D9E4F2" />
    </Style>
    <Style Selector="Button.toolbar-button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.toolbar-button StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar-button Border">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="#1F2933" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:pointerover">
      <Setter Property="Background" Value="#E7EEF7" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:checked">
      <Setter Property="Background" Value="#D7E7FA" />
      <Setter Property="Foreground" Value="#0E5CAD" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:checked:pointerover">
      <Setter Property="Background" Value="#CFE0F5" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button Border">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.toolbar-gap">
      <Setter Property="Background" Value="#D6DEE8" />
    </Style>
    <Style Selector="Border.toolbar-panel">
      <Setter Property="Background" Value="#F4F7FA" />
      <Setter Property="BorderBrush" Value="#CCD6E2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.toolbox-section">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7DEE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.toolbox-section-header">
      <Setter Property="Background" Value="#EEF3F8" />
      <Setter Property="BorderBrush" Value="#D7DEE8" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="6,6,0,0" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Button.toolbox-action">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="#26323F" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.toolbox-action:pointerover">
      <Setter Property="Background" Value="#E7EEF7" />
    </Style>
    <Style Selector="Button.panel-command">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CCD6E2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="Foreground" Value="#26323F" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.panel-command:pointerover">
      <Setter Property="Background" Value="#E7EEF7" />
    </Style>
    <Style Selector="TextBlock.panel-caption">
      <Setter Property="Foreground" Value="#607083" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.panel-title">
      <Setter Property="Foreground" Value="#18222D" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.startup-action">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="#E0E0E0" />
      <Setter Property="BorderBrush" Value="#8C8C8C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="#101010" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.startup-action:pointerover">
      <Setter Property="Background" Value="#EFEFEF" />
      <Setter Property="BorderBrush" Value="#666666" />
    </Style>
    <Style Selector="Border.status-cell">
      <Setter Property="Background" Value="#D4D0C8" />
      <Setter Property="BorderBrush" Value="#8A8A8A" />
      <Setter Property="BorderThickness" Value="1,1,0,0" />
      <Setter Property="Padding" Value="5,1" />
    </Style>
    <Style Selector="TextBlock.status-label">
      <Setter Property="Foreground" Value="#404040" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.status-value">
      <Setter Property="Foreground" Value="#202020" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.document-tab">
      <Setter Property="Background" Value="#DADADA" />
      <Setter Property="BorderBrush" Value="#7E7E7E" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.document-info-cell">
      <Setter Property="Background" Value="#CFCFCF" />
      <Setter Property="BorderBrush" Value="#8A8A8A" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="TextBlock.document-label">
      <Setter Property="Foreground" Value="#505050" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="TextBlock.document-value">
      <Setter Property="Foreground" Value="#151515" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </suki:SukiWindow.Styles>
  <Grid Background="#C8C8C8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="{Binding OutputWindowHeight}" />
      <RowDefinition Height="22" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1">
      <Menu Background="#EFEFEF" FontSize="12" Padding="2,0">
        <MenuItem Header="_File">
          <MenuItem Header="_Open" InputGesture="Ctrl+O" Command="{Binding OpenSessionCommand}" />
          <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveSessionCommand}" />
          <MenuItem Header="Save _As..." Command="{Binding SaveSessionAsCommand}" />
          <MenuItem Header="_Close" Command="{Binding CloseSessionCommand}" />
          <MenuItem Header="Close A_ll" Command="{Binding CloseSessionCommand}" />
          <Separator />
          <MenuItem Header="_Export to CSV" Command="{Binding ExportFramesToCsvCommand}" />
          <MenuItem Header="Export _Frame Graph to CSV" Command="{Binding ExportFramesToCsvCommand}" />
          <Separator />
          <MenuItem Header="_Recent Files" ItemsSource="{Binding RecentFiles}">
            <MenuItem.ItemTemplate>
              <DataTemplate>
                <MenuItem Header="{Binding}"
                          Command="{Binding $parent[Window].DataContext.OpenRecentSessionCommand}"
                          CommandParameter="{Binding}" />
              </DataTemplate>
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="_Threads View" ToggleType="Radio" IsChecked="{Binding IsThreadsViewActive, Mode=OneWay}" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" />
          <MenuItem Header="_Cores View" ToggleType="Radio" IsChecked="{Binding IsCoresViewActive, Mode=OneWay}" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" />
          <MenuItem Header="_Scopes View" ToggleType="Radio" IsChecked="{Binding IsScopesViewActive, Mode=OneWay}" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" />
          <Separator />
          <MenuItem Header="_Threads View">
            <MenuItem Header="_Info" ToggleType="CheckBox" IsChecked="{Binding IsThreadsInfoPanelVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="Info" />
            <MenuItem Header="_Frame Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsFrameGraphVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="FrameGraph" />
            <MenuItem Header="_Scope Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsScopeGraphVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="ScopeGraph" />
            <MenuItem Header="_CPU Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsCoreGraphVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CoreGraph" />
            <MenuItem Header="_Custom Stats Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsCustomStatsVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CustomStats" />
          </MenuItem>
          <MenuItem Header="Scope _Colouring">
            <MenuItem Header="Colour by _Thread" ToggleType="Radio" IsChecked="{Binding IsScopeColorModeThread, Mode=OneWay}" Command="{Binding SetScopeColorModeCommand}" CommandParameter="Thread" />
            <MenuItem Header="Colour by _Scope" ToggleType="Radio" IsChecked="{Binding IsScopeColorModeScope, Mode=OneWay}" Command="{Binding SetScopeColorModeCommand}" CommandParameter="Scope" />
          </MenuItem>
          <Separator />
          <MenuItem Header="_Output Window" ToggleType="CheckBox" IsChecked="{Binding IsOutputWindowVisible, Mode=OneWay}" Command="{Binding ToggleOutputWindowCommand}" />
        </MenuItem>
        <MenuItem Header="_Connection">
          <MenuItem Header="_New Connection..." Command="{Binding OpenConnectionCommand}" />
          <MenuItem Header="_Connect..." Command="{Binding OpenConnectionCommand}" />
          <MenuItem Header="_Disconnect" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
        </MenuItem>
        <MenuItem Header="_Tools">
          <Separator />
          <MenuItem Header="_Find" InputGesture="Ctrl+F" Command="{Binding OpenFindScopeCommand}" />
          <Separator />
          <MenuItem Header="_Create Session from Selection" Command="{Binding CreateSessionFromSelectionCommand}" />
          <Separator />
          <MenuItem Header="_Android">
            <MenuItem Header="_Start Recording Context Switches..." Command="{Binding AndroidActionCommand}" CommandParameter="RecordContextSwitches" />
            <MenuItem Header="_Load Context Switch File" Command="{Binding AndroidActionCommand}" CommandParameter="LoadContextSwitchFile" />
          </MenuItem>
          <Separator />
          <MenuItem Header="_Settings" Command="{Binding OpenSettingsCommand}" />
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="_Registration..." Command="{Binding OpenRegistrationCommand}" />
          <MenuItem Header="_Check for Updates" Command="{Binding OpenUpdateCheckCommand}" />
          <Separator />
          <MenuItem Header="_Demo">
            <MenuItem Header="_Launch FramePro Game Simulator" Command="{Binding DemoActionCommand}" CommandParameter="LaunchGameSimulator" />
            <MenuItem Header="_Playback Recording File..." Command="{Binding DemoActionCommand}" CommandParameter="PlaybackRecordingFile" />
          </MenuItem>
          <MenuItem Header="_Show Startup Page" Command="{Binding ShowStartupPageCommand}" />
          <Separator />
          <MenuItem Header="_About" Command="{Binding OpenAboutCommand}" />
        </MenuItem>
      </Menu>
    </Border>

    <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#D6DEE8" BorderThickness="0,0,0,1" Height="54">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="10,5" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <material:MaterialIcon Kind="Speedometer" Width="24" Height="24" Foreground="#0E5CAD" />
          <TextBlock Text="Profiler" FontSize="16" FontWeight="Bold" Foreground="#18222D" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Column="1" Width="1" Background="#D6DEE8" Margin="2,6" />
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding OpenConnectionCommand}" ToolTip.Tip="Open FramePro connection settings">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Tools" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Connect" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding OpenAndroidCommand}" ToolTip.Tip="Open Android profiler connection and context switch tools">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Android" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Android" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" ToolTip.Tip="Disconnect the active FramePro session">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="AlertCircle" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Disconnect" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Classes="toolbar-gap" Width="1" Margin="6,8" />
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding ResetTimelineCommand}" ToolTip.Tip="Jump to the start of the frame timeline">
              <material:MaterialIcon Kind="FirstPage" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding TrackSelectedFrameCommand}" ToolTip.Tip="Track the currently selected frame in the visible timeline">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Timer" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Track" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding SelectLastFrameCommand}" ToolTip.Tip="Jump to the latest frame in the session">
              <material:MaterialIcon Kind="LastPage" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding SelectPreviousSpikeCommand}" ToolTip.Tip="Select the previous frame spike">
              <material:MaterialIcon Kind="Undo" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding SelectSlowestFrameCommand}" ToolTip.Tip="Select the slowest frame in the current session">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Speedometer" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Max" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding SelectNextSpikeCommand}" ToolTip.Tip="Select the next frame spike">
              <material:MaterialIcon Kind="Redo" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Border Classes="toolbar-gap" Width="1" Margin="6,8" />
            <ToggleButton Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="Info" IsChecked="{Binding IsThreadsInfoPanelVisible, Mode=OneWay}" ToolTip.Tip="Show or hide the thread info panel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Information" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Info" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="FrameGraph" IsChecked="{Binding IsThreadsFrameGraphVisible, Mode=OneWay}" ToolTip.Tip="Show or hide the frame graph">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="ChartBar" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Frames" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CoreGraph" IsChecked="{Binding IsThreadsCoreGraphVisible, Mode=OneWay}" ToolTip.Tip="Show or hide the CPU core graph">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Cpu64Bit" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Cores" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="DataGrid" IsChecked="{Binding IsThreadsDataGridVisible, Mode=OneWay}" ToolTip.Tip="Show or hide the profiler data grids">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="DatabaseEdit" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Details" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <Border Classes="toolbar-gap" Width="1" Margin="6,8" />
            <Button Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding ToggleScopeColorModeCommand}" ToolTip.Tip="Toggle scope colouring between thread and scope modes">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Theme" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ScopeColorModeText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="toolbar-button" Height="40" Padding="8,0" Command="{Binding OpenCallstacksCommand}" ToolTip.Tip="Open callstack capture and symbol tools">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="CodeBraces" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Callstacks" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="3" Classes="toolbar-panel" Padding="8,5" MinWidth="280">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
            <material:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="#607083" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ScopeFilterText}" PlaceholderText="Find scope" MinWidth="110" />
            <Button Grid.Column="2" Classes="panel-command" Content="Prev" Command="{Binding FindPreviousScopeCommand}" />
            <Button Grid.Column="3" Classes="panel-command" Content="Next" Command="{Binding FindNextScopeCommand}" />
            <Button Grid.Column="4" Classes="panel-command" Content="Clear" Command="{Binding ClearScopeFindCommand}" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Background="#C8C8C8">
      <Grid.RowDefinitions>
        <RowDefinition Height="0" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding ToolboxColumnWidth}" />
        <ColumnDefinition Width="{Binding ToolboxSplitterWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#D4D0C8" BorderBrush="#868686" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="document-tab" Margin="3,3,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="Profiler Session" Classes="document-value" FontWeight="SemiBold" />
              <TextBlock Text="-" Classes="document-label" />
              <TextBlock Text="{Binding ActiveSessionView}" Classes="document-value" />
            </StackPanel>
          </Border>
          <Grid Grid.Column="1" ColumnDefinitions="2*,Auto,Auto,Auto" Height="26" Margin="0,1,3,0">
            <Border Classes="document-info-cell">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Session:" Classes="document-label" />
                <TextBlock Text="{Binding Summary.SourceName}" Classes="document-value" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="document-info-cell" MinWidth="210">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Range:" Classes="document-label" />
                <TextBlock Text="{Binding TimelineRangeText}" Classes="document-value" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="document-info-cell" MinWidth="175">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Frame:" Classes="document-label" />
                <TextBlock Text="{Binding SelectedFrameStatusText}" Classes="document-value" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#CFCFCF" Padding="7,2">
              <TextBlock Text="{Binding StatusText}" Classes="document-value" />
            </Border>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Row="1" Grid.Column="0" Background="#CFCFCF" BorderBrush="#868686" BorderThickness="0,0,1,0" IsVisible="{Binding IsToolboxMinimizedTabVisible}">
        <Button
            Background="#CFCFCF"
            BorderBrush="#868686"
            BorderThickness="0"
            Padding="2"
            Command="{Binding RestoreToolboxCommand}"
            ToolTip.Tip="Restore toolbox">
          <TextBlock Text="Toolbox" TextAlignment="Center" TextWrapping="Wrap" Foreground="#101010" FontSize="10" />
        </Button>
      </Border>
      <Border Grid.Row="1" Grid.Column="0" Background="#D4D4D4" BorderBrush="#868686" BorderThickness="0,0,1,0" IsVisible="{Binding IsToolboxExpanded}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="#D4D0C8" BorderBrush="#868686" BorderThickness="0,0,0,1" Padding="5,3" IsVisible="False">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                <TextBlock Text="{Binding ActiveSessionView}" Foreground="#505050" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="_" Width="22" Height="20" Padding="0" FontSize="10" Command="{Binding MinimizeToolboxCommand}" ToolTip.Tip="Minimize toolbox" />
                <Button Content="□" Width="22" Height="20" Padding="0" FontSize="10" Command="{Binding FloatToolboxCommand}" ToolTip.Tip="Float toolbox" />
                <Button Content="x" Width="22" Height="20" Padding="0" FontSize="11" Command="{Binding ToggleToolboxCommand}" ToolTip.Tip="Close toolbox" />
              </StackPanel>
              <TextBlock Text="Toolbox" Foreground="#101010" FontSize="12" FontWeight="SemiBold" />
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5" Spacing="5">
              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Session Info" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="7" Margin="6">
                    <TextBlock Text="Frames" Foreground="#404040" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.FrameCount}" Foreground="#101010" />
                    <TextBlock Grid.Row="1" Text="Average" Foreground="#404040" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.AverageFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="2" Text="Max" Foreground="#404040" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="3" Text="Budget" Foreground="#404040" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.TargetFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="4" Text="Threads" Foreground="#404040" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.ThreadCount}" Foreground="#101010" />
                    <TextBlock Grid.Row="5" Text="Source" Foreground="#404040" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="#101010" TextWrapping="Wrap" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="6" ColumnSpacing="4" RowSpacing="4">
                    <Button Classes="toolbox-action" Content="Connect..." Command="{Binding OpenConnectionCommand}" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Android..." Command="{Binding OpenAndroidCommand}" />
                    <Button Grid.Row="1" Grid.ColumnSpan="2" Classes="toolbox-action" Content="Disconnect" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Frame Navigation" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="6" ColumnSpacing="4" RowSpacing="4">
                    <Button Classes="toolbox-action" Content="Start" Command="{Binding ResetTimelineCommand}" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Track" Command="{Binding TrackSelectedFrameCommand}" />
                    <Button Grid.Column="2" Classes="toolbox-action" Content="End" Command="{Binding SelectLastFrameCommand}" />
                    <Button Grid.Row="1" Classes="toolbox-action" Content="Prev Spike" Command="{Binding SelectPreviousSpikeCommand}" />
                    <Button Grid.Row="1" Grid.Column="1" Classes="toolbox-action" Content="Max" Command="{Binding SelectSlowestFrameCommand}" />
                    <Button Grid.Row="1" Grid.Column="2" Classes="toolbox-action" Content="Next Spike" Command="{Binding SelectNextSpikeCommand}" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Window Layout" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="6" Spacing="3">
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}">Threads View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" Foreground="{Binding CoresViewBrush}">Cores View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" Foreground="{Binding ScopesViewBrush}">Scopes View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" Foreground="{Binding CustomStatsViewBrush}">Custom Stats View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" Foreground="{Binding LogViewBrush}">Log View</Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Dock Windows" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="6" ColumnSpacing="4" RowSpacing="4">
                    <TextBlock Text="Main" Foreground="#404040" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreMainSessionDockCommand}" />
                    <Button Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatMainSessionDockCommand}" />
                    <Button Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockMainSessionDockCommand}" />
                    <TextBlock Grid.Row="1" Text="Toolbox" Foreground="#404040" VerticalAlignment="Center" />
                    <Button Grid.Row="1" Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreToolboxCommand}" />
                    <Button Grid.Row="1" Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatToolboxCommand}" />
                    <Button Grid.Row="1" Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockToolboxCommand}" />
                    <TextBlock Grid.Row="2" Text="Output" Foreground="#404040" VerticalAlignment="Center" />
                    <Button Grid.Row="2" Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreOutputWindowCommand}" />
                    <Button Grid.Row="2" Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatOutputWindowCommand}" />
                    <Button Grid.Row="2" Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockOutputWindowCommand}" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Threads View Panels" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="6" Spacing="3">
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="Info" Foreground="{Binding ThreadsViewBrush}">Info</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="FrameGraph" Foreground="{Binding ThreadsViewBrush}">Frame Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="ScopeGraph" Foreground="{Binding ThreadsViewBrush}">Scope Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CoreGraph" Foreground="{Binding CoresViewBrush}">Core Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CustomStats" Foreground="{Binding CustomStatsViewBrush}">Custom Stats Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="DataGrid" Foreground="{Binding ThreadsViewBrush}">Data Grid</Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Find Scope" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="6" RowSpacing="4">
                    <TextBox Text="{Binding ScopeFilterText}" PlaceholderText="scope text" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="4">
                      <Button Classes="toolbox-action" Content="Prev" Command="{Binding FindPreviousScopeCommand}" />
                      <Button Grid.Column="1" Classes="toolbox-action" Content="Next" Command="{Binding FindNextScopeCommand}" />
                      <Button Grid.Column="2" Classes="toolbox-action" Content="Clear" Command="{Binding ClearScopeFindCommand}" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="6" Spacing="4">
                    <TextBlock Text="Captured root" Foreground="#404040" />
                    <TextBox Text="{Binding CapturedSourceRoot}" PlaceholderText="/buildbot/workspace/project" />
                    <TextBlock Text="Local root" Foreground="#404040" Margin="0,4,0,0" />
                    <TextBox Text="{Binding LocalSourceRoot}" PlaceholderText="/Users/me/project" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1"
                    Grid.Column="1"
                    Background="#9A9A9A"
                    BorderBrush="#767676"
                    BorderThickness="1,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsVisible="False"
                    ResizeDirection="Columns" />

      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="1" Height="28" VerticalAlignment="Top" IsVisible="{Binding IsMainSessionDockMinimizedBarVisible}">
        <DockPanel LastChildFill="True" Margin="7,3">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding ActiveSessionViewTitle}" Foreground="#505050" FontSize="11" VerticalAlignment="Center" />
            <Button Content="Restore" Width="70" Height="20" Padding="0" Command="{Binding RestoreMainSessionDockCommand}" />
            <Button Content="x" Width="22" Height="20" Padding="0" Command="{Binding ToggleMainSessionDockCommand}" />
          </StackPanel>
          <TextBlock Text="Main Session View" FontWeight="SemiBold" Foreground="#101010" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" RowDefinitions="*,47" Margin="0" Background="#D4D0C8" IsVisible="{Binding IsMainSessionDockExpanded}">
        <Grid Grid.Row="0" IsVisible="{Binding IsThreadsViewActive}" Background="#D4D0C8">
          <Grid.RowDefinitions>
            <RowDefinition Height="{Binding ThreadsInfoPanelHeight}" />
            <RowDefinition Height="{Binding ThreadsFrameScrollbarHeight}" />
            <RowDefinition Height="{Binding ThreadsFrameGraphHeight}" />
            <RowDefinition Height="{Binding ThreadsFrameGraphSplitterHeight}" />
            <RowDefinition Height="{Binding ThreadsScopeGraphHeight}" />
            <RowDefinition Height="{Binding ThreadsScopeGraphSplitterHeight}" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding ThreadsDataGridSplitterWidth}" />
            <ColumnDefinition Width="{Binding ThreadsDataGridColumnWidth}" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Row="0" ColumnDefinitions="32,*" IsVisible="{Binding IsThreadsInfoPanelVisible}">
            <Border Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
              <TextBlock Text="INFO"
                         Foreground="#202020"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Width="96"
                         TextAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </Border>

            <Border Grid.Column="1" Background="#F5F5F5" BorderBrush="#7D7D7D" BorderThickness="1" Padding="8,6">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="6" RowSpacing="5">
                <TextBlock Text="Session" Foreground="#505050" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="Frames" Foreground="#505050" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="{Binding StatusBarSessionText}" Foreground="#101010" />
                <TextBlock Grid.Column="4" Text="Threads" Foreground="#505050" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="{Binding Summary.ThreadCount}" Foreground="#101010" />

                <TextBlock Grid.Row="1" Text="Range" Foreground="#505050" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.RangeText}" Foreground="#101010" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Avg" Foreground="#505050" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Summary.AverageFrameTimeText}" Foreground="#101010" />
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Max" Foreground="#505050" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding Summary.MaxFrameTimeText}" Foreground="#101010" />

                <TextBlock Grid.Row="2" Text="Target" Foreground="#505050" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.TargetFrameTimeText}" Foreground="#101010" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Selected" Foreground="#505050" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedFrameStatusText}" Foreground="#101010" />
                <TextBlock Grid.Row="2" Grid.Column="4" Text="Visible" Foreground="#505050" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding TimelineRangeText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Row="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsInfoPanelCollapsed}">
            <Grid ColumnDefinitions="32,*">
              <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                <TextBlock Text="INFO" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>
              <TextBlock Grid.Column="1" Text="Info hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
            </Grid>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsFrameGraphVisible}">
            <Border Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
              <TextBlock Text="Frame"
                         Foreground="#202020"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Width="96"
                         TextAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </Border>

            <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="0">
              <Grid ColumnDefinitions="193,32">
                <Grid RowDefinitions="60,*">
                  <Border Background="#D0D0D0" Padding="6,5">
                    <StackPanel Spacing="1">
                      <TextBlock Text="Average Frame" Foreground="#202020" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Text="{Binding Summary.AverageFrameTimeText}" Foreground="#101010" FontFamily="Consolas,Menlo" FontSize="12" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Background="#EBEBEB" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,58">
                      <TextBlock Text="FPS" Margin="5,0" VerticalAlignment="Center" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Column="1" Text="{Binding Summary.AverageFpsText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Row="1" Text="Max" Margin="5,0" VerticalAlignment="Center" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Row="2" Text="In Budget" Margin="5,0" VerticalAlignment="Center" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.FramesInBudgetText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                    </Grid>
                  </Border>
                </Grid>
                <Border Grid.Column="1" Background="#D3D3D3" BorderBrush="#101010" BorderThickness="0,0,1,0">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="ms" Foreground="#101010" FontFamily="Arial" FontSize="9" HorizontalAlignment="Right" Margin="0,2,5,0" />
                    <Canvas Grid.Row="1">
                      <Line StartPoint="27,4" EndPoint="31,4" Stroke="#101010" StrokeThickness="1" />
                      <Line StartPoint="27,44" EndPoint="31,44" Stroke="#101010" StrokeThickness="1" />
                      <Line StartPoint="27,84" EndPoint="31,84" Stroke="#101010" StrokeThickness="1" />
                      <Ellipse Width="6" Height="6" Fill="#D00000" Canvas.Left="26" Canvas.Top="56" />
                    </Canvas>
                    <TextBlock Grid.Row="2" Text="0" Foreground="#101010" FontFamily="Arial" FontSize="9" HorizontalAlignment="Right" Margin="0,0,5,2" />
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1" MinHeight="120">
              <stats:ucProfilerStats x:Name="ThreadsProfilerStatsControl"
                                     IsCompactMode="True" />
            </Border>
          </Grid>

          <Border Grid.Row="2" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsFrameGraphCollapsed}">
            <Grid ColumnDefinitions="32,*">
              <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                <TextBlock Text="Frame" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>
              <TextBlock Grid.Column="1" Text="Frame Graph hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsFrameGraphVisible}">
            <Border Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,0,0,1" />
            <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1,0,1,1" Padding="3,1">
              <Grid ColumnDefinitions="22,22,*,22,22" ColumnSpacing="3">
                <Button Content="◀" Padding="0" Command="{Binding PanTimelineLeftCommand}" />
                <Button Grid.Column="1" Content="-" Padding="0" Command="{Binding ZoomTimelineOutCommand}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding TimelineRangeText}"
                           Foreground="#303030"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="3" Content="+" Padding="0" Command="{Binding ZoomTimelineInCommand}" />
                <Button Grid.Column="4" Content="▶" Padding="0" Command="{Binding PanTimelineRightCommand}" />
            </Grid>
          </Border>

            <Border Grid.Column="2" Background="#CFCFCF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,1" Padding="3,1">
              <local:SessionScrollbarControl Viewport="{Binding Viewport}" />
            </Border>
          </Grid>

          <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,0,1,1" IsVisible="{Binding IsThreadsFrameGraphCollapsed}">
            <TextBlock Text="Session scrollbar hidden with Frame Graph" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
          </Border>

          <GridSplitter Grid.Row="3"
                        Background="#9A9A9A"
                        BorderBrush="#767676"
                        BorderThickness="0,1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Rows"
                        IsVisible="{Binding IsThreadsFrameGraphVisible}" />

          <Grid Grid.Row="4" ColumnDefinitions="34,225,*,17" IsVisible="{Binding IsThreadsScopeGraphVisible}">
            <Border Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
              <TextBlock Text="Time"
                         Foreground="#202020"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Width="96"
                         TextAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </Border>

            <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="5">
              <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Text="Time Spans" Foreground="#202020" FontFamily="Microsoft Sans Serif, Segoe UI" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="{Binding SelectedFrameScopeSummaryText}" Foreground="#505050" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                <TextBlock Grid.Row="2" Text="{Binding TimelineRangeText}" Foreground="#505050" FontSize="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="0,1,0,1">
              <local:ThreadTimelineLaneControl
                  Rows="{Binding VisibleThreadScopes}"
                  Samples="{Binding FrameSamples}"
                  Viewport="{Binding Viewport}"
                  Selection="{Binding Selection}"
                  ColorMode="{Binding ScopeColorMode}"
                  OpenScopeSourceCommand="{Binding OpenScopeSourceCommand}"
                  FocusThreadCommand="{Binding FocusThreadCommand}" />
            </Border>

            <Border Grid.Column="3" Background="#D7D7D7" BorderBrush="#7D7D7D" BorderThickness="1" />
          </Grid>

          <Border Grid.Row="4" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsScopeGraphCollapsed}">
            <Grid ColumnDefinitions="32,*">
              <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                <TextBlock Text="Time" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>
              <TextBlock Grid.Column="1" Text="Time Spans hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
            </Grid>
          </Border>

          <GridSplitter Grid.Row="5"
                        Background="#9A9A9A"
                        BorderBrush="#767676"
                        BorderThickness="0,1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Rows"
                        IsVisible="{Binding IsThreadsScopeGraphVisible}" />

          <Grid Grid.Row="6" RowDefinitions="88,4,32,4,69,4,*,0,0,0,0,0,0" Margin="0,3,0,0" Background="#D4D0C8">
            <Grid Grid.Row="4" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsScopeGraphVisible}">
              <Border Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1" />

              <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="0">
                <Grid RowDefinitions="39,30" ColumnDefinitions="*,46">
                  <Button Grid.Column="0"
                          Content="Filter Threads..."
                          HorizontalContentAlignment="Left"
                          Padding="6,2"
                          Command="{Binding SelectSessionViewCommand}"
                          CommandParameter="Threads" />
                  <Button Grid.Column="1"
                          Content="Name"
                          Padding="0"
                          ToolTip.Tip="Show threads by name or by id" />
                  <TextBox Grid.Row="1"
                           Grid.Column="0"
                           Text="{Binding ThreadFilterText}"
                           Margin="0,2,1,0" />
                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Content="X"
                          Padding="0"
                          Margin="0,2,0,0"
                          Command="{Binding ClearThreadFilterCommand}" />
                </Grid>
              </Border>

              <Border Grid.Column="2" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1">
                <local:FrameTimelineControl
                    Samples="{Binding FrameSamples}"
                    TargetFrameMs="{Binding Summary.TargetFrameTimeMs}"
                    Selection="{Binding Selection}"
                    Viewport="{Binding Viewport}" />
              </Border>
            </Grid>

            <GridSplitter Grid.Row="5"
                          Background="#9A9A9A"
                          BorderBrush="#767676"
                          BorderThickness="0,1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsScopeGraphVisible}" />

            <Grid Grid.Row="6" ColumnDefinitions="34,225,*,17" IsVisible="{Binding IsThreadsScopeGraphVisible}">
              <Border Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
                <TextBlock Text="Threads"
                           Foreground="#202020"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="120"
                           TextAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>

              <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="5">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                  <TextBlock Text="Thread Activity" Foreground="#202020" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Text="{Binding ThreadTimelineSummaryText}" Foreground="#505050" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="2" Text="{Binding Summary.ThreadCountLabel}" Foreground="#505050" FontSize="10" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="4" Text="{Binding TimelineRangeText}" Foreground="#505050" FontSize="10" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>

              <Border Grid.Column="2" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="0,1,0,1">
                <local:ThreadTimelineLaneControl
                    Rows="{Binding VisibleThreadScopes}"
                    Samples="{Binding FrameSamples}"
                    Viewport="{Binding Viewport}"
                    Selection="{Binding Selection}"
                    ColorMode="{Binding ScopeColorMode}"
                    OpenScopeSourceCommand="{Binding OpenScopeSourceCommand}"
                    FocusThreadCommand="{Binding FocusThreadCommand}">
                  <local:ThreadTimelineLaneControl.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Hide" Command="{Binding HideFocusedThreadCommand}" />
                      <Separator />
                      <MenuItem Header="Collapse All" Command="{Binding CollapseAllThreadsCommand}" />
                      <MenuItem Header="Expand All" Command="{Binding ExpandAllThreadsCommand}" />
                      <Separator />
                      <MenuItem Header="Move Up" Command="{Binding MoveFocusedThreadUpCommand}" />
                      <MenuItem Header="Move Down" Command="{Binding MoveFocusedThreadDownCommand}" />
                      <Separator />
                      <MenuItem Header="Settings..." Command="{Binding ThreadSettingsCommand}" />
                    </ContextMenu>
                  </local:ThreadTimelineLaneControl.ContextMenu>
                </local:ThreadTimelineLaneControl>
              </Border>

              <Border Grid.Column="3" Background="#D7D7D7" BorderBrush="#7D7D7D" BorderThickness="1">
                <Grid RowDefinitions="18,*,18">
                  <Button Content="▲"
                          FontSize="8"
                          Padding="0"
                          BorderThickness="0"
                          Background="#D7D7D7"
                          Command="{Binding ScrollThreadTimelineUpCommand}" />
                  <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1" Margin="2,20,2,20" />
                  <Button Grid.Row="2"
                          Content="▼"
                          FontSize="8"
                          Padding="0"
                          BorderThickness="0"
                          Background="#D7D7D7"
                          Command="{Binding ScrollThreadTimelineDownCommand}" />
                </Grid>
              </Border>
            </Grid>

            <Border Grid.Row="6" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsScopeGraphCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                  <TextBlock Text="Threads" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <TextBlock Grid.Column="1" Text="Scope Graph hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="7"
                          Background="#9A9A9A"
                          BorderBrush="#767676"
                          BorderThickness="0,1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="False" />

            <Grid Grid.Row="0" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsCoreGraphVisible}">
              <Border Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
                <TextBlock Text="Cores"
                           Foreground="#202020"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="96"
                           TextAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>

              <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Core Activity" Foreground="#202020" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Text="{Binding CoreSummaryText}" Foreground="#505050" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  <ItemsControl Grid.Row="2" ItemsSource="{Binding CoreRows}" Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding CoreText}" Foreground="#202020" FontSize="10" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>

              <Border Grid.Column="2" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1">
                <local:CoreTimelineStripControl
                    Rows="{Binding CoreRows}"
                    SummaryText="{Binding CoreSummaryText}" />
              </Border>
            </Grid>

            <Border Grid.Row="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsCoreGraphCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                  <TextBlock Text="Cores" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <TextBlock Grid.Column="1" Text="Core Graph hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="1"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsCoreGraphVisible}" />

            <Grid Grid.Row="2" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsCustomStatsVisible}">
              <Border Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
                <TextBlock Text="" />
              </Border>

              <Border Grid.Column="1" Background="#C4C4C4" BorderBrush="#7D7D7D" BorderThickness="1">
                <Button Content="Custom Stat..."
                        Padding="6,0"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Command="{Binding SelectSessionViewCommand}"
                        CommandParameter="CustomStats" />
              </Border>

              <Border Grid.Column="2" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1" Padding="6,0">
                <Grid ColumnDefinitions="*,120,120">
                  <stats:ucProfilerStats x:Name="ProfilerStatsControl"
                                          IsVisible="False"
                                          Width="0"
                                          Height="0" />
                  <TextBlock Text="{Binding SelectedFrameCounterSummaryText}"
                             Foreground="#202020"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding TimelineRangeText}"
                             Foreground="#404040"
                             VerticalAlignment="Center"
                             TextAlignment="Right"
                             TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2"
                          Background="#A5A5A5"
                          BorderBrush="#7A7A7A"
                          BorderThickness="1"
                          Margin="8,7,0,7" />
                </Grid>
              </Border>
            </Grid>

            <Border Grid.Row="2" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsCustomStatsCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                  <TextBlock Text="Stats" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <TextBlock Grid.Column="1" Text="Custom Stats hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="9"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="False" />

            <Border Grid.Row="10" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="False">
              <Grid RowDefinitions="Auto,96,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Scope Hotspots"
                             Foreground="#101010"
                             FontSize="12"
                             FontWeight="SemiBold" />
                  <TextBox DockPanel.Dock="Right"
                           Text="{Binding ScopeFilterText}"
                           Width="180"
                           Margin="10,0,0,0"
                           PlaceholderText="Filter scopes" />
                  <TextBlock Text="{Binding ScopeHotspotSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="5,3">
                  <Grid ColumnDefinitions="*,90,90,90,90,90">
                    <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Total ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Avg ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Average" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Max/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="5" Content="Calls/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxCount" Padding="0" HorizontalContentAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="3,1">
                          <Grid ColumnDefinitions="*,90,90,90,90,90">
                            <TextBlock Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding AverageTimeText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding MaxTimePerFrameText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{Binding MaxCountPerFrameText}" Foreground="#101010" TextAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="3"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsCustomStatsVisible}" />

            <Border Grid.Row="8" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="False">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Scopes"
                             Foreground="#101010"
                             FontSize="12"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameScopeSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#CFCFCF" BorderBrush="#7D7D7D" BorderThickness="1" Margin="0,5,0,5">
                  <local:SelectedFrameThreadLaneControl Rows="{Binding SelectedFrameScopes}" ColorMode="{Binding ScopeColorMode}" />
                </Border>

                <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="5,3">
                  <Grid ColumnDefinitions="140,*,80,80,220,64">
                    <Button Content="Thread" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Thread" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Scope" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Start ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Start" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Dur ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Duration" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Source" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Source" Padding="0" HorizontalContentAlignment="Left" />
                    <TextBlock Grid.Column="5" Text="Open" Foreground="#202020" FontWeight="SemiBold" TextAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameScopes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="3,1">
                          <Grid ColumnDefinitions="140,*,80,80,220,64">
                            <TextBlock Text="{Binding ThreadName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding IndentedName}" Foreground="#101010" TextTrimming="CharacterEllipsis" FontFamily="Menlo,Consolas,monospace" />
                            <TextBlock Grid.Column="2" Text="{Binding StartOffsetText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding SourceText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="5"
                                    Content="Open"
                                    Padding="6,1"
                                    HorizontalAlignment="Right"
                                    IsEnabled="{Binding CanOpenSource}"
                                    Command="{Binding $parent[Window].DataContext.OpenScopeSourceCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <Border Grid.Row="8" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="False">
              <Grid ColumnDefinitions="32,*">
                <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                  <TextBlock Text="Data" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <TextBlock Grid.Column="1" Text="Data Grid hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="11"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="False" />

            <Border Grid.Row="12" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="False">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Counters"
                             Foreground="#101010"
                             FontSize="12"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameCounterSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="5,3">
                  <Grid ColumnDefinitions="150,*,90,90,80">
                    <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Count" Command="{Binding SortTableCommand}" CommandParameter="Counter:Count" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Unit" Command="{Binding SortTableCommand}" CommandParameter="Counter:Unit" Padding="0" HorizontalContentAlignment="Left" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="3,1">
                          <Grid ColumnDefinitions="150,*,90,90,80">
                            <TextBlock Text="{Binding GraphName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding UnitText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <GridSplitter Grid.Column="1"
                        Grid.RowSpan="7"
                        Width="4"
                        Background="#636363"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Columns"
                        IsVisible="{Binding IsThreadsDataGridVisible}" />

          <Border Grid.Column="2"
                  Grid.RowSpan="7"
                  Background="#D0D0D0"
                  BorderBrush="#7D7D7D"
                  BorderThickness="1"
                  IsVisible="{Binding IsThreadsDataGridVisible}">
            <Grid RowDefinitions="28,*,4,*,4,*">
              <Border Grid.Row="0" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="3,1">
                <DockPanel LastChildFill="True">
                  <TextBox DockPanel.Dock="Right"
                           Text="{Binding ScopeFilterText}"
                           Width="140"
                           Margin="6,0,0,0" />
                  <TextBlock Text="Scope Data Grid" Foreground="#101010" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>

              <Border Grid.Row="1" Background="#D0D0D0" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Scope Hotspots" Foreground="#101010" FontWeight="SemiBold" />
                  <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="3,1">
                    <Grid ColumnDefinitions="*,70,64">
                      <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="1" Content="Total" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                      <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="3,1">
                            <Grid ColumnDefinitions="*,70,64">
                              <TextBlock Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="#101010" TextAlignment="Right" />
                              <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="#101010" TextAlignment="Right" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <GridSplitter Grid.Row="2" Background="#636363" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

              <Border Grid.Row="3" Background="#D0D0D0" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Selected Frame Scopes" Foreground="#101010" FontWeight="SemiBold" />
                  <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="3,1">
                    <Grid ColumnDefinitions="110,*,70">
                      <Button Content="Thread" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Thread" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="1" Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Scope" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="2" Content="Dur" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Duration" Padding="0" HorizontalContentAlignment="Right" />
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedFrameScopes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="3,1">
                            <Grid ColumnDefinitions="110,*,70">
                              <TextBlock Text="{Binding ThreadName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding IndentedName}" Foreground="#101010" TextTrimming="CharacterEllipsis" FontFamily="Menlo,Consolas,monospace" />
                              <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#101010" TextAlignment="Right" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <GridSplitter Grid.Row="4" Background="#636363" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

              <Border Grid.Row="5" Background="#D0D0D0" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Selected Frame Counters" Foreground="#101010" FontWeight="SemiBold" />
                  <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="3,1">
                    <Grid ColumnDefinitions="120,*,70">
                      <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="3,1">
                            <Grid ColumnDefinitions="120,*,70">
                              <TextBlock Text="{Binding GraphName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#101010" TextAlignment="Right" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="0" RowDefinitions="139,24,4,*" ColumnDefinitions="34,225,*" Background="#D4D0C8" IsVisible="{Binding IsCoresViewActive}">
          <Border Grid.Row="0" Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
            <TextBlock Text="Frame" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform Angle="-90" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="0">
            <Grid ColumnDefinitions="193,32">
              <Grid RowDefinitions="60,*">
                <Border Background="#D0D0D0" Padding="6,5">
                  <StackPanel Spacing="1">
                    <TextBlock Text="Average Frame" Foreground="#202020" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Text="{Binding Summary.AverageFrameTimeText}" Foreground="#101010" FontFamily="Consolas,Menlo" FontSize="12" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#EBEBEB" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0">
                  <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,58">
                    <TextBlock Text="FPS" Margin="5,0" VerticalAlignment="Center" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.AverageFpsText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Row="1" Text="Max" Margin="5,0" VerticalAlignment="Center" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Row="2" Text="In Budget" Margin="5,0" VerticalAlignment="Center" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.FramesInBudgetText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="#101010" FontFamily="Monaco,Consolas" FontSize="10" />
                  </Grid>
                </Border>
              </Grid>
              <Border Grid.Column="1" Background="#D3D3D3" BorderBrush="#101010" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                  <TextBlock Text="ms" Foreground="#101010" FontFamily="Arial" FontSize="9" HorizontalAlignment="Right" Margin="0,2,5,0" />
                  <Canvas Grid.Row="1">
                    <Line StartPoint="27,4" EndPoint="31,4" Stroke="#101010" StrokeThickness="1" />
                    <Line StartPoint="27,44" EndPoint="31,44" Stroke="#101010" StrokeThickness="1" />
                    <Line StartPoint="27,84" EndPoint="31,84" Stroke="#101010" StrokeThickness="1" />
                    <Ellipse Width="6" Height="6" Fill="#D00000" Canvas.Left="26" Canvas.Top="56" />
                  </Canvas>
                  <TextBlock Grid.Row="2" Text="0" Foreground="#101010" FontFamily="Arial" FontSize="9" HorizontalAlignment="Right" Margin="0,0,5,2" />
                </Grid>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1">
            <stats:ucProfilerStats x:Name="CoresProfilerStatsControl"
                                   IsCompactMode="True" />
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,0,0,1" />
          <Border Grid.Row="1" Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1,0,1,1" Padding="3,1">
            <Grid ColumnDefinitions="22,22,*,22,22" ColumnSpacing="3">
              <Button Content="◀" Padding="0" Command="{Binding PanTimelineLeftCommand}" />
              <Button Grid.Column="1" Content="-" Padding="0" Command="{Binding ZoomTimelineOutCommand}" />
              <TextBlock Grid.Column="2" Text="{Binding TimelineRangeText}" Foreground="#303030" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="3" Content="+" Padding="0" Command="{Binding ZoomTimelineInCommand}" />
              <Button Grid.Column="4" Content="▶" Padding="0" Command="{Binding PanTimelineRightCommand}" />
            </Grid>
          </Border>
          <Border Grid.Row="1" Grid.Column="2" Background="#CFCFCF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,1" Padding="3,1">
            <local:SessionScrollbarControl Viewport="{Binding Viewport}" />
          </Border>

          <GridSplitter Grid.Row="2" Grid.ColumnSpan="3" Background="#9A9A9A" BorderBrush="#767676" BorderThickness="0,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

          <Border Grid.Row="3" Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
            <TextBlock Text="Cores" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform Angle="-90" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Border>
          <Border Grid.Row="3" Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="5">
            <Grid RowDefinitions="Auto,Auto,*">
              <TextBlock Text="Cores" Foreground="#202020" FontWeight="SemiBold" FontSize="11" />
              <TextBlock Grid.Row="1" Text="{Binding CoreSummaryText}" Foreground="#505050" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
              <ItemsControl Grid.Row="2" ItemsSource="{Binding CoreRows}" Margin="0,5,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding CoreText}" Foreground="#202020" FontSize="10" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
          <Border Grid.Row="3" Grid.Column="2" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1">
            <local:CoreTimelineStripControl Rows="{Binding CoreRows}" SummaryText="{Binding CoreSummaryText}" />
          </Border>
        </Grid>

        <Border Grid.Row="0" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="0" IsVisible="{Binding IsScopesViewActive}">
          <Grid RowDefinitions="196,4,*">
            <Grid Grid.Row="0" ColumnDefinitions="34,225,*">
              <Border Grid.Column="0" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
                <TextBlock Text="Scopes" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>
              <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Scope Graph" Foreground="#202020" FontWeight="SemiBold" FontSize="11" />
                  <TextBlock Grid.Row="1" Text="{Binding ScopeHotspotSummaryText}" Foreground="#505050" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="2" Text="{Binding TimelineRangeText}" Foreground="#505050" FontSize="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
              <Border Grid.Column="2" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1">
                <stats:ucProfilerStats x:Name="ScopesProfilerStatsControl"
                                       IsCompactMode="True" />
              </Border>
            </Grid>
            <GridSplitter Grid.Row="1" Background="#9A9A9A" BorderBrush="#767676" BorderThickness="0,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" Margin="6">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Scopes" Foreground="#101010" FontSize="11" FontWeight="SemiBold" />
              <TextBox DockPanel.Dock="Right"
                       Text="{Binding ScopeFilterText}"
                       Width="220"
                       Margin="10,0,0,0"
                       />
              <TextBlock Text="{Binding ScopeHotspotSummaryText}" Foreground="#404040" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,4,0,0" Padding="3,1">
              <Grid ColumnDefinitions="*,90,90,90,90,90">
                <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="Total ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="3" Content="Avg ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Average" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="4" Content="Max/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxTime" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="5" Content="Calls/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxCount" Padding="0" HorizontalContentAlignment="Right" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="#FFFFFF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="3,1">
                      <Grid ColumnDefinitions="*,90,90,90,90,90">
                        <TextBlock Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding AverageTimeText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding MaxTimePerFrameText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{Binding MaxCountPerFrameText}" Foreground="#101010" TextAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="0" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="{Binding IsCustomStatsViewActive}">
          <Grid RowDefinitions="Auto,Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Custom Stats" Foreground="#101010" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedFrameCounterSummaryText}" Foreground="#404040" FontSize="11" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,4,0,0" Padding="3,1">
              <Grid ColumnDefinitions="150,*,90,90,80">
                <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="3" Content="Count" Command="{Binding SortTableCommand}" CommandParameter="Counter:Count" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="4" Content="Unit" Command="{Binding SortTableCommand}" CommandParameter="Counter:Unit" Padding="0" HorizontalContentAlignment="Left" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="#FFFFFF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="3,1">
                      <Grid ColumnDefinitions="150,*,90,90,80">
                        <TextBlock Text="{Binding GraphName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding UnitText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="0" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="{Binding IsLogViewActive}">
          <Grid RowDefinitions="Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Log" Foreground="#101010" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LogSummaryText}" Foreground="#404040" FontSize="11" HorizontalAlignment="Right" />
            </DockPanel>
            <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,4,0,0">
              <Border Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Padding="3,1">
                <Grid ColumnDefinitions="58,130,*">
                  <TextBlock Text="#" Foreground="#202020" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="Time" Foreground="#202020" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="Message" Foreground="#202020" FontWeight="SemiBold" />
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" Background="#FFFFFF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LogRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="3,1">
                        <Grid ColumnDefinitions="58,130,*">
                          <TextBlock Text="{Binding Index}" Foreground="#101010" />
                          <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#101010" />
                          <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#EDEDED" BorderBrush="#5A5A5A" BorderThickness="0,1,0,0" Margin="0">
          <Grid RowDefinitions="8,*" ColumnDefinitions="Auto,Auto,Auto,*">
            <Polygon Grid.Row="0" Grid.Column="0" Points="53,0 71,0 62,8" Fill="#5A5A5A" IsVisible="{Binding IsThreadsViewActive}" />
            <Polygon Grid.Row="0" Grid.Column="1" Points="42,0 60,0 51,8" Fill="#5A5A5A" IsVisible="{Binding IsCoresViewActive}" />
            <Polygon Grid.Row="0" Grid.Column="2" Points="47,0 65,0 56,8" Fill="#5A5A5A" IsVisible="{Binding IsScopesViewActive}" />

            <Button Grid.Row="1" Grid.Column="0"
                    Content="Threads"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Threads"
                    Width="124"
                    Padding="10,0"
                    FontFamily="Monaco,Consolas"
                    FontSize="12"
                    Foreground="{Binding ThreadsViewBrush}"
                    Background="Transparent"
                    BorderThickness="0" />
            <Button Grid.Row="1" Grid.Column="1"
                    Content="Cores"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Cores"
                    Width="102"
                    Padding="10,0"
                    FontFamily="Monaco,Consolas"
                    FontSize="12"
                    Foreground="{Binding CoresViewBrush}"
                    Background="Transparent"
                    BorderThickness="0" />
            <Button Grid.Row="1" Grid.Column="2"
                    Content="Scopes"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Scopes"
                    Width="112"
                    Padding="10,0"
                    FontFamily="Monaco,Consolas"
                    FontSize="12"
                    Foreground="{Binding ScopesViewBrush}"
                    Background="Transparent"
                    BorderThickness="0" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Background="#D4D0C8"
            IsVisible="{Binding IsStartupPageVisible}">
      <Grid Margin="12">
        <Border
            Width="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D4D0C8"
            BorderBrush="#7D7D7D"
            BorderThickness="1">
          <Grid RowDefinitions="Auto,1,Auto" ColumnDefinitions="*,220">
            <Border Grid.ColumnSpan="2" Background="#D4D0C8" BorderBrush="#7D7D7D" BorderThickness="0,0,0,1" Padding="10,6">
              <DockPanel>
                <TextBlock Text="ProfilerStudy" FontSize="12" FontWeight="SemiBold" Foreground="#101010" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Startup Page" Foreground="#404040" VerticalAlignment="Center" />
                  <Button Content="x" Width="22" Height="20" Padding="0" Command="{Binding CloseStartupPageCommand}" />
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#8A8A8A" />

            <Grid Grid.Row="2" ColumnDefinitions="*,220">
              <StackPanel Margin="10" Spacing="6">
                <TextBlock Text="Open a profiler capture." Foreground="#202020" FontSize="11" TextWrapping="Wrap" />
                <Button Classes="startup-action" Content="Open Profiler Session..." Command="{Binding OpenSessionCommand}" />
                <Button Classes="startup-action" Content="Load Generated Sample" Command="{Binding LoadSampleCommand}" />
                <Button Classes="startup-action" Content="Connect to FramePro..." Command="{Binding OpenConnectionCommand}" />
                <Button Classes="startup-action" Content="Connect to Android..." Command="{Binding OpenAndroidCommand}" />
                <Button Classes="startup-action" Content="Close Startup Page" Command="{Binding CloseStartupPageCommand}" />
                <TextBlock Text="Views are available after a session is loaded." Foreground="#505050" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>

              <Border Grid.Column="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="1,0,0,0" Padding="6">
                <Grid RowDefinitions="Auto,*">
                  <TextBlock Text="Recent Files" FontWeight="SemiBold" Foreground="#101010" />
                  <ScrollViewer Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Recent profiler captures." Foreground="#505050" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button
                                Classes="startup-action"
                                Content="{Binding}"
                                Command="{Binding $parent[Window].DataContext.OpenRecentSessionCommand}"
                                CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="330"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="36,38,0,0"
            Background="#D4D4D4"
            BorderBrush="#676767"
            BorderThickness="1"
            IsVisible="{Binding IsToolboxFloatingVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#D4D0C8" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="3,1">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
              <Button Content="Dock" Width="48" Height="20" Padding="0" Command="{Binding DockToolboxCommand}" />
              <Button Content="x" Width="22" Height="20" Padding="0" Command="{Binding ToggleToolboxCommand}" />
            </StackPanel>
            <TextBlock Text="Toolbox" FontWeight="SemiBold" Foreground="#101010" />
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8" Spacing="6">
            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveSessionView}" Foreground="#505050" FontSize="11" />
                    <TextBlock Text="Session Info" FontWeight="SemiBold" Foreground="#101010" />
                  </DockPanel>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="7" Margin="6">
                  <TextBlock Text="Frames" Foreground="#404040" />
                  <TextBlock Grid.Column="1" Text="{Binding Summary.FrameCount}" Foreground="#101010" />
                  <TextBlock Grid.Row="1" Text="Average" Foreground="#404040" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.AverageFrameTimeText}" Foreground="#101010" />
                  <TextBlock Grid.Row="2" Text="Max" Foreground="#404040" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Foreground="#101010" />
                  <TextBlock Grid.Row="3" Text="Threads" Foreground="#404040" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.ThreadCount}" Foreground="#101010" />
                  <TextBlock Grid.Row="4" Text="Source" Foreground="#404040" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="#101010" TextWrapping="Wrap" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="#101010" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="6" ColumnSpacing="5" RowSpacing="5">
                  <Button Classes="toolbox-action" Content="Connect..." Command="{Binding OpenConnectionCommand}" />
                  <Button Grid.Column="1" Classes="toolbox-action" Content="Android..." Command="{Binding OpenAndroidCommand}" />
                  <Button Grid.Row="1" Grid.ColumnSpan="2" Classes="toolbox-action" Content="Disconnect" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Frame Navigation" FontWeight="SemiBold" Foreground="#101010" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="6" ColumnSpacing="5" RowSpacing="5">
                  <Button Classes="toolbox-action" Content="Start" Command="{Binding ResetTimelineCommand}" />
                  <Button Grid.Column="1" Classes="toolbox-action" Content="Track" Command="{Binding TrackSelectedFrameCommand}" />
                  <Button Grid.Column="2" Classes="toolbox-action" Content="End" Command="{Binding SelectLastFrameCommand}" />
                  <Button Grid.Row="1" Classes="toolbox-action" Content="Prev Spike" Command="{Binding SelectPreviousSpikeCommand}" />
                  <Button Grid.Row="1" Grid.Column="1" Classes="toolbox-action" Content="Max" Command="{Binding SelectSlowestFrameCommand}" />
                  <Button Grid.Row="1" Grid.Column="2" Classes="toolbox-action" Content="Next Spike" Command="{Binding SelectNextSpikeCommand}" />
                  <Button Grid.Row="2" Classes="toolbox-action" Content="Pan Left" Command="{Binding PanTimelineLeftCommand}" />
                  <Button Grid.Row="2" Grid.Column="1" Classes="toolbox-action" Content="Zoom In" Command="{Binding ZoomTimelineInCommand}" />
                  <Button Grid.Row="2" Grid.Column="2" Classes="toolbox-action" Content="Pan Right" Command="{Binding PanTimelineRightCommand}" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Window Layout" FontWeight="SemiBold" Foreground="#101010" />
                </Border>
                <UniformGrid Grid.Row="1" Columns="2" Margin="6" RowSpacing="5" ColumnSpacing="5">
                  <Button Classes="toolbox-action" Content="Threads" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}" />
                  <Button Classes="toolbox-action" Content="Cores" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" Foreground="{Binding CoresViewBrush}" />
                  <Button Classes="toolbox-action" Content="Scopes" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" Foreground="{Binding ScopesViewBrush}" />
                  <Button Classes="toolbox-action" Content="Stats" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" Foreground="{Binding CustomStatsViewBrush}" />
                  <Button Classes="toolbox-action" Content="Log" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" Foreground="{Binding LogViewBrush}" />
                  <Button Classes="toolbox-action" Content="Output" Command="{Binding ToggleOutputWindowCommand}" />
                </UniformGrid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Dock Windows" FontWeight="SemiBold" Foreground="#101010" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="6" ColumnSpacing="5" RowSpacing="5">
                  <TextBlock Text="Main" Foreground="#404040" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreMainSessionDockCommand}" />
                  <Button Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatMainSessionDockCommand}" />
                  <Button Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockMainSessionDockCommand}" />
                  <TextBlock Grid.Row="1" Text="Toolbox" Foreground="#404040" VerticalAlignment="Center" />
                  <Button Grid.Row="1" Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreToolboxCommand}" />
                  <Button Grid.Row="1" Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatToolboxCommand}" />
                  <Button Grid.Row="1" Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockToolboxCommand}" />
                  <TextBlock Grid.Row="2" Text="Output" Foreground="#404040" VerticalAlignment="Center" />
                  <Button Grid.Row="2" Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreOutputWindowCommand}" />
                  <Button Grid.Row="2" Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatOutputWindowCommand}" />
                  <Button Grid.Row="2" Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockOutputWindowCommand}" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Find Scope" FontWeight="SemiBold" Foreground="#101010" />
                </Border>
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="6" RowSpacing="5">
                  <TextBox Text="{Binding ScopeFilterText}" PlaceholderText="scope text" />
                  <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="5">
                    <Button Classes="toolbox-action" Content="Prev" Command="{Binding FindPreviousScopeCommand}" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Next" Command="{Binding FindNextScopeCommand}" />
                    <Button Grid.Column="2" Classes="toolbox-action" Content="Clear" Command="{Binding ClearScopeFindCommand}" />
                  </Grid>
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="#101010" />
                </Border>
                <StackPanel Grid.Row="1" Margin="6" Spacing="4">
                  <TextBlock Text="Captured root" Foreground="#404040" />
                  <TextBox Text="{Binding CapturedSourceRoot}" PlaceholderText="/buildbot/workspace/project" />
                  <TextBlock Text="Local root" Foreground="#404040" Margin="0,4,0,0" />
                  <TextBox Text="{Binding LocalSourceRoot}" PlaceholderText="/Users/me/project" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsRegistrationPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Registration" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseRegistrationCommand}" />
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="ProfilerStudy Registration" FontWeight="SemiBold" Foreground="#101010" />
          <Border Grid.Row="1" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8">
            <StackPanel Spacing="7">
              <TextBlock Text="This viewer preserves the original FramePro registration entry point." Foreground="#101010" TextWrapping="Wrap" />
              <TextBlock Text="No license verification service is bundled with this macOS shell. Existing profiler files and sample data can be opened without registration." Foreground="#404040" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="About" Width="86" Command="{Binding OpenAboutCommand}" />
            <Button Content="Close" Width="86" Command="{Binding CloseRegistrationCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsUpdateCheckPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Check for Updates" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseUpdateCheckCommand}" />
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="Update Status" FontWeight="SemiBold" Foreground="#101010" />
          <Border Grid.Row="1" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8">
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
              <TextBlock Text="Current version" Foreground="#404040" />
              <TextBlock Grid.Column="1" Text="{Binding AboutVersionText}" Foreground="#101010" />
              <TextBlock Grid.Row="1" Text="Update channel" Foreground="#404040" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="Manual builds from this workspace" Foreground="#101010" />
              <TextBlock Grid.Row="2" Text="Network check" Foreground="#404040" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="Not configured in this build" Foreground="#101010" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="About" Width="86" Command="{Binding OpenAboutCommand}" />
            <Button Content="Close" Width="86" Command="{Binding CloseUpdateCheckCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="560"
            Height="300"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D4D4D4"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            IsVisible="{Binding IsMainSessionDockFloatingVisible}">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
              <Button Content="Dock" Width="48" Height="20" Padding="0" Command="{Binding DockMainSessionDockCommand}" />
              <Button Content="x" Width="22" Height="20" Padding="0" Command="{Binding ToggleMainSessionDockCommand}" />
            </StackPanel>
            <TextBlock Text="Main Session View" FontWeight="SemiBold" Foreground="#101010" />
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#D7D7D7" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="4,3">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Button Content="Threads" Width="70" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}" />
            <Button Content="Cores" Width="58" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" Foreground="{Binding CoresViewBrush}" />
            <Button Content="Scopes" Width="64" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" Foreground="{Binding ScopesViewBrush}" />
            <Button Content="Custom Stats" Width="92" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" Foreground="{Binding CustomStatsViewBrush}" />
            <Button Content="Log" Width="44" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" Foreground="{Binding LogViewBrush}" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="6" RowSpacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ActiveSessionViewTitle}" Foreground="#101010" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#404040" FontSize="11" />
          </Grid>
          <Border Grid.Row="1" Background="#C5C5C5" BorderBrush="#8A8A8A" BorderThickness="1" Padding="8">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="7">
              <TextBlock Text="Session" Foreground="#505050" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Text="Range" Foreground="#505050" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TimelineRangeText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Text="Frame" Foreground="#505050" FontWeight="SemiBold" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFrameStatusText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="3" Text="Scope Graph" Foreground="#505050" FontWeight="SemiBold" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedFrameScopeSummaryText}" Foreground="#101010" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="Custom Stats" Foreground="#505050" FontWeight="SemiBold" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedFrameCounterSummaryText}" Foreground="#101010" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            Height="220"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,36,36"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            IsVisible="{Binding IsOutputWindowFloatingVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
              <Button Content="Dock" Width="48" Height="20" Padding="0" Command="{Binding DockOutputWindowCommand}" />
              <Button Content="x" Width="22" Height="20" Padding="0" Command="{Binding ToggleOutputWindowCommand}" />
            </StackPanel>
            <TextBlock Text="Output Window" FontWeight="SemiBold" Foreground="#101010" />
          </DockPanel>
        </Border>
        <TextBox Grid.Row="1"
                 Text="{Binding OutputLogText}"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="#FFFFFF"
                 Foreground="#101010"
                 FontFamily="Microsoft Sans Serif, Segoe UI"
                 FontSize="11" />
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsHelpPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="ProfilerStudy Help" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseHelpCommand}" />
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="Common actions" FontWeight="SemiBold" Foreground="#101010" />

          <Border Grid.Row="1" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
              <TextBlock Text="Open session" Foreground="#404040" />
              <TextBlock Grid.Column="1" Text="File > Open or Ctrl+O" Foreground="#101010" />
              <TextBlock Grid.Row="1" Text="Save session" Foreground="#404040" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="File > Save or Ctrl+S" Foreground="#101010" />
              <TextBlock Grid.Row="2" Text="Find scope" Foreground="#404040" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="Tools > Find or Ctrl+F" Foreground="#101010" />
              <TextBlock Grid.Row="3" Text="Switch views" Foreground="#404040" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="Use the View menu, toolbar, or bottom tabs" Foreground="#101010" />
              <TextBlock Grid.Row="4" Text="Timeline" Foreground="#404040" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="Mouse wheel zooms; drag pans in the ScottPlot timeline controls" Foreground="#101010" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="2"
                     Text="This viewer reuses the legacy FramePro session core. The toolbar, startup page, and timeline controls map to the original profiler entry points."
                     Foreground="#404040"
                     TextWrapping="Wrap" />

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Startup Page" Width="104" Command="{Binding ShowStartupPageCommand}" />
            <Button Content="Close" Width="86" Command="{Binding CloseHelpCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsSettingsPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Settings" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseSettingsCommand}" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="#101010" />
          <TextBlock Text="These settings are used when opening captured source paths from profiler scope rows." Foreground="#404040" TextWrapping="Wrap" />
          <TextBlock Text="Captured root" Foreground="#303030" Margin="0,4,0,0" />
          <TextBox Text="{Binding CapturedSourceRoot}" PlaceholderText="/buildbot/workspace/project" />
          <TextBlock Text="Local root" Foreground="#303030" />
          <TextBox Text="{Binding LocalSourceRoot}" PlaceholderText="/Users/me/project" />
          <Border Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8" Margin="0,6,0,0">
            <TextBlock Text="Changes are saved automatically and reused by the source navigation commands." Foreground="#303030" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" Width="86" Command="{Binding CloseSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsThreadSettingsPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Thread View Settings" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseThreadSettingsCommand}" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Threads View Panels" FontWeight="SemiBold" Foreground="#101010" />
          <TextBlock Text="Show or hide the docked panels used by the Threads view. These controls mirror the View menu and toolbar buttons." Foreground="#404040" TextWrapping="Wrap" />
          <UniformGrid Columns="2" RowSpacing="7" ColumnSpacing="7" Margin="0,4,0,0">
            <ToggleButton Content="Info"
                          IsChecked="{Binding IsThreadsInfoPanelVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="Info" />
            <ToggleButton Content="Frame Graph"
                          IsChecked="{Binding IsThreadsFrameGraphVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="FrameGraph" />
            <ToggleButton Content="Scope Graph"
                          IsChecked="{Binding IsThreadsScopeGraphVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="ScopeGraph" />
            <ToggleButton Content="CPU Graph"
                          IsChecked="{Binding IsThreadsCoreGraphVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="CoreGraph" />
            <ToggleButton Content="Custom Stats Graph"
                          IsChecked="{Binding IsThreadsCustomStatsVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="CustomStats" />
            <ToggleButton Content="Data Grid"
                          IsChecked="{Binding IsThreadsDataGridVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="DataGrid" />
          </UniformGrid>
          <Border Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8" Margin="0,6,0,0">
            <TextBlock Text="Lane context commands still operate from the thread graph right-click menu: Hide, Move Up, Move Down, Collapse All, and Expand All." Foreground="#303030" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Collapse All" Width="92" Command="{Binding CollapseAllThreadsCommand}" />
            <Button Content="Expand All" Width="88" Command="{Binding ExpandAllThreadsCommand}" />
            <Button Content="Close" Width="86" Command="{Binding CloseThreadSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsCallstacksPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Callstacks" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseCallstacksCommand}" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Callstack Tools" FontWeight="SemiBold" Foreground="#101010" />
          <TextBlock Text="Enable or disable callstack capture for a live session, then request a module symbol reload for captured sessions." Foreground="#404040" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,4,0,0">
            <Border Width="42" Height="34" Background="#B0B0B0" BorderBrush="#606060" BorderThickness="1">
              <TextBlock Text="stk" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#303030" />
            </Border>
            <Button Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Toggle Live Callstack Recording"
                    Command="{Binding CallstacksActionCommand}"
                    CommandParameter="Capture" />
            <Border Grid.Row="1" Width="42" Height="34" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1">
              <TextBlock Text="sym" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#202020" />
            </Border>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Reload Module Symbols"
                    Command="{Binding CallstacksActionCommand}"
                    CommandParameter="Resolve" />
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8">
              <TextBlock Text="{Binding CallstacksPanelStatusText}" Foreground="#303030" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" Width="86" Command="{Binding CloseCallstacksCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsConnectionPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseConnectionCommand}" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="FramePro Connection" FontWeight="SemiBold" Foreground="#101010" />
          <TextBlock Text="Connection controls are represented here to match the original profiler entry points." Foreground="#404040" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="84,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,4,0,0">
            <TextBlock Text="Host" Foreground="#303030" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ConnectionHost}" PlaceholderText="localhost" />
            <TextBlock Grid.Row="1" Text="Port" Foreground="#303030" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionPort}" PlaceholderText="8428" />
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8">
              <TextBlock Text="{Binding ConnectionPanelStatusText}" Foreground="#303030" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="New" Width="74" Command="{Binding ConnectionActionCommand}" CommandParameter="New" />
            <Button Content="Connect" Width="86" Command="{Binding ConnectionActionCommand}" CommandParameter="Connect" />
            <Button Content="Disconnect" Width="92" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
            <Button Content="Close" Width="74" Command="{Binding CloseConnectionCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsAndroidPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Android" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseAndroidCommand}" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Context Switch Tools" FontWeight="SemiBold" Foreground="#101010" />
          <TextBlock Text="Connect to the FramePro socket exposed by the Android app, or load a recorded context switch file into the active session." Foreground="#404040" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,4,0,0">
            <Border Width="42" Height="34" Background="#9EBB9C" BorderBrush="#4E6F4D" BorderThickness="1">
              <TextBlock Text="ADB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#253725" />
            </Border>
            <Grid Grid.Column="1" ColumnDefinitions="*,64,68" ColumnSpacing="6">
              <TextBox Text="{Binding AndroidEndpoint}" PlaceholderText="localfilesystem:/data/user_de/0/.../files/framepro" />
              <Button Grid.Column="1"
                      Content="Debug"
                      Command="{Binding AndroidActionCommand}"
                      CommandParameter="UseDebugEndpoint" />
              <Button Grid.Column="2"
                      Content="Release"
                      Command="{Binding AndroidActionCommand}"
                      CommandParameter="UseReleaseEndpoint" />
            </Grid>
            <Border Grid.Row="1" Width="42" Height="34" Background="#9EBB9C" BorderBrush="#4E6F4D" BorderThickness="1">
              <TextBlock Text="tcp" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#253725" />
            </Border>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Connect Android"
                    Command="{Binding AndroidActionCommand}"
                    CommandParameter="ConnectAndroid" />
            <Border Grid.Row="2" Width="42" Height="34" Background="#9EBB9C" BorderBrush="#4E6F4D" BorderThickness="1">
              <TextBlock Text="rec" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#253725" />
            </Border>
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,72,*" ColumnSpacing="6">
              <TextBlock Text="Duration (seconds)" Foreground="#303030" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding AndroidRecordingDuration}" />
              <Button Grid.Column="2"
                      HorizontalContentAlignment="Left"
                      Content="Start Recording Context Switches..."
                      Command="{Binding AndroidActionCommand}"
                      CommandParameter="RecordContextSwitches" />
            </Grid>
            <Border Grid.Row="3" Width="42" Height="34" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1">
              <TextBlock Text="ctx" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#202020" />
            </Border>
            <Button Grid.Row="3"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Load Context Switch File"
                    Command="{Binding AndroidActionCommand}"
                    CommandParameter="LoadContextSwitchFile" />
            <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8">
              <TextBlock Text="{Binding AndroidPanelStatusText}" Foreground="#303030" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" Width="86" Command="{Binding CloseAndroidCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsAboutPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="About" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseAboutCommand}" />
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
            <Border Width="64" Height="64" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1">
              <TextBlock Text="FP"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="#203246" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Binding AboutProductText}" FontSize="20" FontWeight="SemiBold" Foreground="#101010" />
              <TextBlock Text="FramePro profiler viewer" Foreground="#303030" />
              <TextBlock Text="{Binding AboutCopyrightText}" Foreground="#303030" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="10">
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
              <TextBlock Text="Version" Foreground="#404040" />
              <TextBlock Grid.Column="1" Text="{Binding AboutVersionText}" Foreground="#101010" />
              <TextBlock Grid.Row="1" Text="Website" Foreground="#404040" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AboutWebsiteText}" Foreground="#101010" />
              <TextBlock Grid.Row="2" Text="E-mail" Foreground="#404040" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AboutEmailText}" Foreground="#101010" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="2"
                     Text="This Avalonia shell reuses the legacy FramePro session core and preserves the original profiler entry points while bringing the UI to macOS."
                     Foreground="#404040"
                     TextWrapping="Wrap" />

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Close" Width="86" Command="{Binding CloseAboutCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,1,0,0" IsVisible="{Binding IsOutputWindowMinimizedBarVisible}">
      <DockPanel LastChildFill="True" Margin="7,3">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding SessionStatusText}" Foreground="#505050" FontSize="11" VerticalAlignment="Center" />
          <Button Content="Restore" Width="70" Height="20" Padding="0" Command="{Binding RestoreOutputWindowCommand}" />
          <Button Content="x" Width="22" Height="20" Padding="0" Command="{Binding ToggleOutputWindowCommand}" />
        </StackPanel>
        <TextBlock Text="Output Window" FontWeight="SemiBold" Foreground="#101010" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="0,1,0,0" MinHeight="120" IsVisible="{Binding IsOutputWindowExpanded}">
      <TextBox Text="{Binding OutputLogText}"
               AcceptsReturn="True"
               IsReadOnly="True"
               BorderThickness="0"
               Background="#EFEFEF"
               Foreground="#101010"
               FontFamily="Microsoft Sans Serif, Segoe UI"
               FontSize="11"
               TextWrapping="NoWrap"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Border>

    <Border Grid.Row="4" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="2*,160,180,180,240">
        <Border Classes="status-cell">
          <TextBlock Text="{Binding StatusText}" Classes="status-value" />
        </Border>
        <Border Grid.Column="1" Classes="status-cell">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Session:" Classes="status-label" />
            <TextBlock Text="{Binding StatusBarSessionText}" Classes="status-value" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="status-cell">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Selected:" Classes="status-label" />
            <TextBlock Text="{Binding StatusBarSelectedFrameText}" Classes="status-value" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="status-cell">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Hovered:" Classes="status-label" />
            <TextBlock Text="{Binding StatusBarHoveredFrameText}" Classes="status-value" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="status-cell" BorderThickness="1,1,1,0">
          <TextBlock Text="{Binding TimelineRangeText}" Classes="status-value" TextAlignment="Right" />
        </Border>
      </Grid>
    </Border>

  </Grid>
</suki:SukiWindow>
