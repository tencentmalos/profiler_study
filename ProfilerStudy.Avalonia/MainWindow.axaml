<Window
    x:Class="ProfilerStudy.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProfilerStudy.Avalonia"
    xmlns:stats="clr-namespace:ProfilerStudy.Avalonia.ProfilerStats"
    Title="ProfilerStudy"
    Width="1180"
    Height="760"
    MinWidth="860"
    MinHeight="560">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Background="#C8C8C8">
    <Border Grid.Row="0" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1">
      <Menu Background="#EFEFEF" FontSize="12" Padding="2,0">
        <MenuItem Header="_File">
          <MenuItem Header="_Open" Command="{Binding OpenSessionCommand}" />
          <MenuItem Header="_Save" IsEnabled="False" />
          <MenuItem Header="Save _As..." IsEnabled="False" />
          <MenuItem Header="_Close" IsEnabled="False" />
          <MenuItem Header="Close A_ll" IsEnabled="False" />
          <Separator />
          <MenuItem Header="_Export to CSV" IsEnabled="False" />
          <MenuItem Header="Export _Frame Graph to CSV" IsEnabled="False" />
          <Separator />
          <MenuItem Header="_Recent Files" Command="{Binding OpenRecentSessionCommand}" />
          <MenuItem Header="Load _Sample" Command="{Binding LoadSampleCommand}" />
          <Separator />
          <MenuItem Header="E_xit" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="_Threads View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" />
          <MenuItem Header="_Cores View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" />
          <MenuItem Header="_Scopes View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" />
          <MenuItem Header="Custom _Stats View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" />
          <MenuItem Header="_Log View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" />
          <Separator />
          <MenuItem Header="_Threads View">
            <MenuItem Header="_Info" />
            <MenuItem Header="_Frame Graph" />
            <MenuItem Header="_Scope Graph" />
            <MenuItem Header="_CPU Graph" IsEnabled="False" />
            <MenuItem Header="_Custom Stats Graph" />
          </MenuItem>
          <MenuItem Header="Scope _Colouring">
            <MenuItem Header="Colour by _Thread" IsEnabled="False" />
            <MenuItem Header="Colour by _Scope" IsEnabled="False" />
          </MenuItem>
          <Separator />
          <MenuItem Header="_Output Window" />
        </MenuItem>
        <MenuItem Header="_Connection">
          <MenuItem Header="_New Connection..." IsEnabled="False" />
          <MenuItem Header="_Connect..." IsEnabled="False" />
          <MenuItem Header="_Disconnect" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="_Tools">
          <Separator />
          <MenuItem Header="_Find" IsEnabled="False" />
          <Separator />
          <MenuItem Header="_Create Session from Selection" IsEnabled="False" />
          <Separator />
          <MenuItem Header="_Android">
            <MenuItem Header="_Start Recording Context Switches..." IsEnabled="False" />
            <MenuItem Header="_Load Context Switch File" IsEnabled="False" />
          </MenuItem>
          <Separator />
          <MenuItem Header="_Settings" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="_Registration..." IsEnabled="False" />
          <MenuItem Header="_Check for Updates" IsEnabled="False" />
          <Separator />
          <MenuItem Header="_Demo">
            <MenuItem Header="_Launch FramePro Game Simulator" IsEnabled="False" />
            <MenuItem Header="_Playback Recording File..." IsEnabled="False" />
          </MenuItem>
          <Separator />
          <MenuItem Header="_About" IsEnabled="False" />
        </MenuItem>
      </Menu>
    </Border>

    <Border Grid.Row="1" Background="#D5D5D5" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" MinHeight="120">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="0">
          <Button Command="{Binding OpenSessionCommand}" Width="88" MinHeight="118" Padding="4">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#E9D08A" BorderBrush="#6E5B23" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Open" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="88" MinHeight="118" Padding="4" IsEnabled="False">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#9EB8D8" BorderBrush="#3F5F85" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Connect" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="88" MinHeight="118" Padding="4" IsEnabled="False">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#8FAF8D" BorderBrush="#3F6B3D" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Android" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="88" MinHeight="118" Padding="4" IsEnabled="False">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#B96B62" BorderBrush="#72342E" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Disconnect" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="74" MinHeight="118" Padding="4" Command="{Binding ResetTimelineCommand}">
            <StackPanel Spacing="5">
              <Border Width="28" Height="30" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Start" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="74" MinHeight="118" Padding="4" IsEnabled="False">
            <StackPanel Spacing="5">
              <Border Width="28" Height="30" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Track" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="74" MinHeight="118" Padding="4" IsEnabled="False">
            <StackPanel Spacing="5">
              <Border Width="28" Height="30" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="End" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="88" MinHeight="118" Padding="4">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Info" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="88" MinHeight="118" Padding="4" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Frames" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="88" MinHeight="118" Padding="4" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Scope" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="88" MinHeight="118" Padding="4" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Cores" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="104" MinHeight="118" Padding="4" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Custom Stats" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
          <Button Width="88" MinHeight="118" Padding="4">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Details" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="74" MinHeight="118" Padding="4" IsEnabled="False">
            <StackPanel Spacing="5">
              <Border Width="28" Height="30" Background="#D8B08D" BorderBrush="#7A4E2D" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Prev" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="74" MinHeight="118" Padding="4" Command="{Binding SelectSlowestFrameCommand}">
            <StackPanel Spacing="5">
              <Border Width="28" Height="30" Background="#D8B08D" BorderBrush="#7A4E2D" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Max" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Width="74" MinHeight="118" Padding="4" IsEnabled="False">
            <StackPanel Spacing="5">
              <Border Width="28" Height="30" Background="#D8B08D" BorderBrush="#7A4E2D" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Next" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="300" MinHeight="118" Background="#CCCCCC" BorderBrush="#8A8A8A" BorderThickness="1,0" Padding="8">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="4">
              <TextBlock Text="Find" FontWeight="SemiBold" />
              <TextBox Grid.Row="1" Watermark="Scope text" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                <Button Content="Prev" Width="58" IsEnabled="False" />
                <Button Content="Next" Width="58" IsEnabled="False" />
                <Button Content="Clear" Width="58" IsEnabled="False" />
              </StackPanel>
            </Grid>
          </Border>
          <Button Width="104" MinHeight="118" Padding="4" IsEnabled="False">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#BCA0C8" BorderBrush="#6B4878" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Colour Mode" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
          <Border Width="220" MinHeight="118" Background="#CCCCCC" BorderBrush="#8A8A8A" BorderThickness="1,0" Padding="8">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
              <TextBlock Text="Conditional Scope Time" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Text="Filter threshold" Foreground="#404040" />
              <Border Grid.Row="2" Height="18" Background="#B8B8B8" BorderBrush="#808080" BorderThickness="1">
                <Border Width="82" Background="#909090" HorizontalAlignment="Left" />
              </Border>
            </Grid>
          </Border>
          <Button Width="104" MinHeight="118" Padding="4" IsEnabled="False">
            <StackPanel Spacing="5">
              <Border Width="34" Height="30" Background="#B0B0B0" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center" />
              <TextBlock Text="Callstacks" TextAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="240,4,*">
      <Border Grid.Column="0" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="7,4">
            <TextBlock Text="Toolbox" Foreground="#101010" FontSize="13" FontWeight="SemiBold" />
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="7" Spacing="7">
              <Border Background="#CFCFCF" BorderBrush="#8A8A8A" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                  <Border Background="#B8B8B8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="6,3">
                    <TextBlock Text="Session" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="8" Margin="7">
                    <TextBlock Text="Frames" Foreground="#404040" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.FrameCount}" Foreground="#101010" />
                    <TextBlock Grid.Row="1" Text="Average" Foreground="#404040" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.AverageFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="2" Text="Max" Foreground="#404040" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="3" Text="Budget" Foreground="#404040" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.TargetFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="4" Text="Threads" Foreground="#404040" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.ThreadCount}" Foreground="#101010" />
                    <TextBlock Grid.Row="5" Text="Source" Foreground="#404040" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="#101010" TextWrapping="Wrap" />
                  </Grid>
                </Grid>
              </Border>

              <Border Background="#CFCFCF" BorderBrush="#8A8A8A" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                  <Border Background="#B8B8B8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="6,3">
                    <TextBlock Text="Views" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="7" Spacing="4">
                    <Button HorizontalContentAlignment="Left" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}">Frame Graph</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}">Profiler Scopes</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" Foreground="{Binding ScopesViewBrush}">Scope Hotspots</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}">Selected Frame</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" Foreground="{Binding CustomStatsViewBrush}">Counters</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" Foreground="{Binding CoresViewBrush}">Cores</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" Foreground="{Binding LogViewBrush}">Log</Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Background="#CFCFCF" BorderBrush="#8A8A8A" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                  <Border Background="#B8B8B8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="6,3">
                    <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="7" Spacing="5">
                    <TextBlock Text="Captured root" Foreground="#404040" />
                    <TextBox Text="{Binding CapturedSourceRoot}" Watermark="/buildbot/workspace/project" />
                    <TextBlock Text="Local root" Foreground="#404040" Margin="0,4,0,0" />
                    <TextBox Text="{Binding LocalSourceRoot}" Watermark="/Users/me/project" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Background="#9A9A9A"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*,47" Margin="6">
        <Border Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Margin="0,0,0,8">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="8,6">
            <TextBlock Text="{Binding ActiveSessionViewTitle}" Foreground="#101010" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#404040" VerticalAlignment="Center" />
            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*" ColumnSpacing="8" Margin="0,5,0,0">
              <TextBlock Text="Info" Foreground="#5A5A5A" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Summary.RangeText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="Frame Graph" Foreground="#5A5A5A" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="{Binding TimelineRangeText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="4" Text="Scope Graph" Foreground="#5A5A5A" FontWeight="SemiBold" />
              <TextBlock Grid.Column="5" Text="{Binding SelectedFrameScopeSummaryText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="6" Text="Custom Stats" Foreground="#5A5A5A" FontWeight="SemiBold" />
              <TextBlock Grid.Column="7" Text="{Binding SelectedFrameCounterSummaryText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="180,6,*" IsVisible="{Binding IsThreadsViewActive}">
          <Grid Grid.Row="0" ColumnDefinitions="34,225,*">
            <Border Grid.Column="0" Background="#BEBEBE" BorderBrush="#808080" BorderThickness="1,1,0,1">
              <TextBlock Text="Frame"
                         Foreground="#202020"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </Border>

            <Border Grid.Column="1" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*,46">
                <Button Grid.Column="0"
                        Content="Filter Threads..."
                        HorizontalContentAlignment="Left"
                        Padding="6,2"
                        Command="{Binding SelectSessionViewCommand}"
                        CommandParameter="Threads" />
                <Button Grid.Column="1"
                        Content="Name"
                        Padding="0"
                        ToolTip.Tip="Show threads by name or by id" />
                <TextBox Grid.Row="1"
                         Grid.Column="0"
                         Text="{Binding ThreadFilterText}"
                         Watermark="thread or scope text"
                         Margin="0,3,2,0" />
                <Button Grid.Row="1"
                        Grid.Column="1"
                        Content="X"
                        Padding="0"
                        Margin="0,3,0,0"
                        Command="{Binding ClearThreadFilterCommand}" />
                <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,4" />
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding TimelineRangeText}" Foreground="#404040" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding Selection.SelectedFrameLabel}" Foreground="#101010" />
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="#C8C8C8" BorderBrush="#808080" BorderThickness="0,1,1,1" MinHeight="120">
              <local:FrameTimelineControl
                  Samples="{Binding FrameSamples}"
                  TargetFrameMs="{Binding Summary.TargetFrameTimeMs}"
                  Selection="{Binding Selection}"
                  Viewport="{Binding Viewport}" />
            </Border>
          </Grid>

          <GridSplitter Grid.Row="1"
                        Background="#9A9A9A"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Rows" />

          <Grid Grid.Row="2" RowDefinitions="220,6,92,6,*,6,180,6,160,6,150" Margin="0,8,0,0">
            <Grid Grid.Row="0" ColumnDefinitions="34,225,*,17">
              <Border Grid.Column="0" Background="#BEBEBE" BorderBrush="#808080" BorderThickness="1,1,0,1">
                <TextBlock Text="Threads"
                           Foreground="#202020"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </Border>

              <Border Grid.Column="1" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="Thread Activity" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ThreadTimelineSummaryText}" Foreground="#404040" TextWrapping="Wrap" />
                  <Separator Margin="0,4" />
                  <TextBlock Text="{Binding TimelineRangeText}" Foreground="#404040" />
                  <TextBlock Text="{Binding Summary.ThreadCountLabel}" Foreground="#404040" />
                  <TextBlock Text="{Binding Summary.CoreCountLabel}" Foreground="#404040" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="0,1,0,1">
                <local:ThreadTimelineLaneControl
                    Rows="{Binding VisibleThreadScopes}"
                    Samples="{Binding FrameSamples}"
                    Viewport="{Binding Viewport}"
                    Selection="{Binding Selection}"
                    OpenScopeSourceCommand="{Binding OpenScopeSourceCommand}"
                    FocusThreadCommand="{Binding FocusThreadCommand}">
                  <local:ThreadTimelineLaneControl.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Hide" Command="{Binding HideFocusedThreadCommand}" />
                      <Separator />
                      <MenuItem Header="Collapse All" Command="{Binding CollapseAllThreadsCommand}" />
                      <MenuItem Header="Expand All" Command="{Binding ExpandAllThreadsCommand}" />
                      <Separator />
                      <MenuItem Header="Move Up" Command="{Binding MoveFocusedThreadUpCommand}" />
                      <MenuItem Header="Move Down" Command="{Binding MoveFocusedThreadDownCommand}" />
                      <Separator />
                      <MenuItem Header="Settings..." Command="{Binding ThreadSettingsCommand}" />
                    </ContextMenu>
                  </local:ThreadTimelineLaneControl.ContextMenu>
                </local:ThreadTimelineLaneControl>
              </Border>

              <Border Grid.Column="3" Background="#D7D7D7" BorderBrush="#808080" BorderThickness="1">
                <Grid RowDefinitions="18,*,18">
                  <Button Content="▲"
                          FontSize="8"
                          Padding="0"
                          BorderThickness="0"
                          Background="#D7D7D7"
                          Command="{Binding ScrollThreadTimelineUpCommand}" />
                  <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1" Margin="2,20,2,20" />
                  <Button Grid.Row="2"
                          Content="▼"
                          FontSize="8"
                          Padding="0"
                          BorderThickness="0"
                          Background="#D7D7D7"
                          Command="{Binding ScrollThreadTimelineDownCommand}" />
                </Grid>
              </Border>
            </Grid>

            <GridSplitter Grid.Row="1"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Grid Grid.Row="2" ColumnDefinitions="34,225,*">
              <Border Grid.Column="0" Background="#BEBEBE" BorderBrush="#808080" BorderThickness="1,1,0,1">
                <TextBlock Text="Cores"
                           Foreground="#202020"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </Border>

              <Border Grid.Column="1" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="Core Activity" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CoreSummaryText}" Foreground="#404040" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="0,1,1,1">
                <local:CoreTimelineStripControl
                    Rows="{Binding CoreRows}"
                    SummaryText="{Binding CoreSummaryText}" />
              </Border>
            </Grid>

            <GridSplitter Grid.Row="3"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Grid Grid.Row="4" ColumnDefinitions="34,225,*">
              <Border Grid.Column="0" Background="#BEBEBE" BorderBrush="#808080" BorderThickness="1,1,0,1">
                <TextBlock Text="Stats"
                           Foreground="#202020"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </Border>

              <Border Grid.Column="1" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="Custom Stats" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameCounterSummaryText}" Foreground="#404040" TextWrapping="Wrap" />
                  <Separator Margin="0,4" />
                  <TextBlock Text="Scope Hotspots" Foreground="#101010" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ScopeHotspotSummaryText}" Foreground="#404040" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="0,1,1,1">
                <stats:ucProfilerStats x:Name="ProfilerStatsControl" MinHeight="260" />
              </Border>
            </Grid>

            <GridSplitter Grid.Row="7"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Border Grid.Row="8" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,96,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Scope Hotspots"
                             Foreground="#101010"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBox DockPanel.Dock="Right"
                           Text="{Binding ScopeFilterText}"
                           Width="180"
                           Margin="10,0,0,0"
                           Watermark="Filter scopes" />
                  <TextBlock Text="{Binding ScopeHotspotSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,7,0,0" Padding="6,4">
                  <Grid ColumnDefinitions="*,90,90,90,90,90">
                    <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Total ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Avg ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Average" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Max/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="5" Content="Calls/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxCount" Padding="0" HorizontalContentAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,3">
                          <Grid ColumnDefinitions="*,90,90,90,90,90">
                            <TextBlock Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding AverageTimeText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding MaxTimePerFrameText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{Binding MaxCountPerFrameText}" Foreground="#101010" TextAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="5"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Border Grid.Row="6" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Scopes"
                             Foreground="#101010"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameScopeSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#CFCFCF" BorderBrush="#808080" BorderThickness="1" Margin="0,7,0,7">
                  <local:SelectedFrameThreadLaneControl Rows="{Binding SelectedFrameScopes}" />
                </Border>

                <Border Grid.Row="2" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="6,4">
                  <Grid ColumnDefinitions="140,*,80,80,220,64">
                    <Button Content="Thread" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Thread" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Scope" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Start ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Start" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Dur ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Duration" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Source" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Source" Padding="0" HorizontalContentAlignment="Left" />
                    <TextBlock Grid.Column="5" Text="Open" Foreground="#202020" FontWeight="SemiBold" TextAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameScopes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,3">
                          <Grid ColumnDefinitions="140,*,80,80,220,64">
                            <TextBlock Text="{Binding ThreadName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding IndentedName}" Foreground="#101010" TextTrimming="CharacterEllipsis" FontFamily="Menlo,Consolas,monospace" />
                            <TextBlock Grid.Column="2" Text="{Binding StartOffsetText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding SourceText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="5"
                                    Content="Open"
                                    Padding="6,1"
                                    HorizontalAlignment="Right"
                                    IsEnabled="{Binding CanOpenSource}"
                                    Command="{Binding $parent[Window].DataContext.OpenScopeSourceCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="9"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Border Grid.Row="10" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Counters"
                             Foreground="#101010"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameCounterSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,7,0,0" Padding="6,4">
                  <Grid ColumnDefinitions="150,*,90,90,80">
                    <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Count" Command="{Binding SortTableCommand}" CommandParameter="Counter:Count" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Unit" Command="{Binding SortTableCommand}" CommandParameter="Counter:Unit" Padding="0" HorizontalContentAlignment="Left" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,3">
                          <Grid ColumnDefinitions="150,*,90,90,80">
                            <TextBlock Text="{Binding GraphName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding UnitText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Border Grid.Row="1" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="12" IsVisible="{Binding IsCoresViewActive}">
          <Grid RowDefinitions="Auto,Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Cores View" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CoreSummaryText}" Foreground="#404040" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,8,0,0" Padding="6,4">
              <Grid ColumnDefinitions="150,*">
                <TextBlock Text="Core" Foreground="#202020" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Context switches in visible range" Foreground="#202020" FontWeight="SemiBold" TextAlignment="Right" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding CoreRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,3">
                      <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{Binding CoreText}" Foreground="#101010" />
                        <TextBlock Grid.Column="1" Text="{Binding ContextSwitchCount}" Foreground="#101010" TextAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="12" IsVisible="{Binding IsScopesViewActive}">
          <Grid RowDefinitions="Auto,Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Scopes View" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
              <TextBox DockPanel.Dock="Right"
                       Text="{Binding ScopeFilterText}"
                       Width="220"
                       Margin="10,0,0,0"
                       Watermark="Filter scopes" />
              <TextBlock Text="{Binding ScopeHotspotSummaryText}" Foreground="#404040" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,8,0,0" Padding="6,4">
              <Grid ColumnDefinitions="*,90,90,90,90,90">
                <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="Total ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="3" Content="Avg ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Average" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="4" Content="Max/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxTime" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="5" Content="Calls/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxCount" Padding="0" HorizontalContentAlignment="Right" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,3">
                      <Grid ColumnDefinitions="*,90,90,90,90,90">
                        <TextBlock Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding AverageTimeText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding MaxTimePerFrameText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{Binding MaxCountPerFrameText}" Foreground="#101010" TextAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="12" IsVisible="{Binding IsCustomStatsViewActive}">
          <Grid RowDefinitions="Auto,Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Custom Stats View" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedFrameCounterSummaryText}" Foreground="#404040" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,8,0,0" Padding="6,4">
              <Grid ColumnDefinitions="150,*,90,90,80">
                <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="3" Content="Count" Command="{Binding SortTableCommand}" CommandParameter="Counter:Count" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="4" Content="Unit" Command="{Binding SortTableCommand}" CommandParameter="Counter:Unit" Padding="0" HorizontalContentAlignment="Left" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,3">
                      <Grid ColumnDefinitions="150,*,90,90,80">
                        <TextBlock Text="{Binding GraphName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding UnitText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="12" IsVisible="{Binding IsLogViewActive}">
          <Grid RowDefinitions="Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Log View" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LogSummaryText}" Foreground="#404040" HorizontalAlignment="Right" />
            </DockPanel>
            <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,8,0,0">
              <Border Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Padding="6,4">
                <Grid ColumnDefinitions="58,130,*">
                  <TextBlock Text="#" Foreground="#202020" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="Time" Foreground="#202020" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="Message" Foreground="#202020" FontWeight="SemiBold" />
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LogRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,3">
                        <Grid ColumnDefinitions="58,130,*">
                          <TextBlock Text="{Binding Index}" Foreground="#101010" />
                          <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#101010" />
                          <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#EDEDED" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,8,0,0">
          <Grid RowDefinitions="8,*" ColumnDefinitions="104,82,96,176,72,*">
            <Polygon Grid.Column="0" Points="42,0 62,0 52,8" Fill="#4169E1" IsVisible="{Binding IsThreadsViewActive}" />
            <Polygon Grid.Column="1" Points="28,0 48,0 38,8" Fill="#4169E1" IsVisible="{Binding IsCoresViewActive}" />
            <Polygon Grid.Column="2" Points="34,0 54,0 44,8" Fill="#4169E1" IsVisible="{Binding IsScopesViewActive}" />
            <Polygon Grid.Column="3" Points="72,0 92,0 82,8" Fill="#4169E1" IsVisible="{Binding IsCustomStatsViewActive}" />
            <Polygon Grid.Column="4" Points="22,0 42,0 32,8" Fill="#4169E1" IsVisible="{Binding IsLogViewActive}" />
            <Button Grid.Row="1" Grid.Column="0" Content="Threads" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" FontFamily="Monaco,Menlo,Consolas,monospace" FontSize="18" Foreground="{Binding ThreadsViewBrush}" Background="Transparent" BorderThickness="0" />
            <Button Grid.Row="1" Grid.Column="1" Content="Cores" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" FontFamily="Monaco,Menlo,Consolas,monospace" FontSize="18" Foreground="{Binding CoresViewBrush}" Background="Transparent" BorderThickness="0" />
            <Button Grid.Row="1" Grid.Column="2" Content="Scopes" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" FontFamily="Monaco,Menlo,Consolas,monospace" FontSize="18" Foreground="{Binding ScopesViewBrush}" Background="Transparent" BorderThickness="0" />
            <Button Grid.Row="1" Grid.Column="3" Content="Custom Stats" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" FontFamily="Monaco,Menlo,Consolas,monospace" FontSize="18" Foreground="{Binding CustomStatsViewBrush}" Background="Transparent" BorderThickness="0" />
            <Button Grid.Row="1" Grid.Column="4" Content="Log" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" FontFamily="Monaco,Menlo,Consolas,monospace" FontSize="18" Foreground="{Binding LogViewBrush}" Background="Transparent" BorderThickness="0" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,1,0,0" MinHeight="120">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="7,3">
          <TextBlock Text="Output Window" FontWeight="SemiBold" Foreground="#101010" />
        </Border>
        <TextBox Grid.Row="1"
                 Text="{Binding StatusText}"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="#EFEFEF"
                 Foreground="#101010"
                 FontFamily="Menlo,Consolas,monospace"
                 FontSize="11" />
      </Grid>
    </Border>

    <Border Grid.Row="4" Background="#E6E6E6" BorderBrush="#8A8A8A" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="2*,*,*,2*" MinHeight="24">
        <Border BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" Padding="7,3">
          <TextBlock Text="{Binding StatusText}" Foreground="#202020" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border Grid.Column="1" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" Padding="7,3">
          <TextBlock Text="{Binding TimelineRangeText}" Foreground="#202020" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border Grid.Column="2" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" Padding="7,3">
          <TextBlock Text="{Binding Summary.SourceName}" Foreground="#202020" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border Grid.Column="3" Padding="7,3">
          <TextBlock Text="{Binding FooterText}" Foreground="#202020" TextTrimming="CharacterEllipsis" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
