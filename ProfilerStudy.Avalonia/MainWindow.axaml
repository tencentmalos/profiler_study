<Window
    x:Class="ProfilerStudy.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProfilerStudy.Avalonia"
    xmlns:stats="clr-namespace:ProfilerStudy.Avalonia.ProfilerStats"
    Title="ProfilerStudy"
    Width="1180"
    Height="760"
    MinWidth="860"
    MinHeight="560">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="#C8C8C8">
    <Border Grid.Row="0" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1">
      <Menu Background="#EFEFEF" FontSize="12" Padding="2,0">
        <MenuItem Header="_File">
          <MenuItem Header="_Open..." Command="{Binding OpenSessionCommand}" />
          <MenuItem Header="Open _Recent" Command="{Binding OpenRecentSessionCommand}" />
          <MenuItem Header="Load _Sample" Command="{Binding LoadSampleCommand}" />
          <Separator />
          <MenuItem Header="E_xit" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="_Frame Graph" />
          <MenuItem Header="_Threads View" />
          <MenuItem Header="_Scopes View" />
          <MenuItem Header="_Custom Stats Graph" />
          <Separator />
          <MenuItem Header="_Reset Zoom" Command="{Binding ResetTimelineCommand}" />
        </MenuItem>
        <MenuItem Header="_Connection">
          <MenuItem Header="_New Connection..." IsEnabled="False" />
          <MenuItem Header="_Connect" IsEnabled="False" />
          <MenuItem Header="_Disconnect" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="_Tools">
          <MenuItem Header="_Find Slowest Frame" Command="{Binding SelectSlowestFrameCommand}" />
          <MenuItem Header="_Create Session From Selection" IsEnabled="False" />
          <Separator />
          <MenuItem Header="_Settings" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="_About ProfilerStudy" IsEnabled="False" />
        </MenuItem>
      </Menu>
    </Border>

    <Border Grid.Row="1" Background="#E3E3E3" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="4,3">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="3">
          <Button Command="{Binding OpenSessionCommand}" Padding="8,2" MinHeight="22">Open</Button>
          <Button Command="{Binding OpenRecentSessionCommand}" Padding="8,2" MinHeight="22">Recent</Button>
          <Button Command="{Binding LoadSampleCommand}" Padding="8,2" MinHeight="22">Sample</Button>
          <Border Width="1" Margin="4,1" Background="#9A9A9A" />
          <Button Command="{Binding SelectSlowestFrameCommand}" Padding="8,2" MinHeight="22">Find Max</Button>
          <Button Command="{Binding ResetTimelineCommand}" Padding="8,2" MinHeight="22">Reset Zoom</Button>
          <Border Width="1" Margin="4,1" Background="#9A9A9A" />
          <TextBlock Text="Recent:" Foreground="#303030" VerticalAlignment="Center" Margin="3,0,0,0" />
          <ComboBox ItemsSource="{Binding RecentFiles}"
                    SelectedItem="{Binding SelectedRecentFile}"
                    Width="260"
                    MinHeight="22"
                    PlaceholderText="Recent files" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="#202020" VerticalAlignment="Center" Margin="12,0,0,0" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="240,4,*">
      <Border Grid.Column="0" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="7,4">
            <TextBlock Text="Toolbox" Foreground="#101010" FontSize="13" FontWeight="SemiBold" />
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="7" Spacing="7">
              <Border Background="#CFCFCF" BorderBrush="#8A8A8A" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                  <Border Background="#B8B8B8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="6,3">
                    <TextBlock Text="Session" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="8" Margin="7">
                    <TextBlock Text="Frames" Foreground="#404040" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.FrameCount}" Foreground="#101010" />
                    <TextBlock Grid.Row="1" Text="Average" Foreground="#404040" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.AverageFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="2" Text="Max" Foreground="#404040" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="3" Text="Budget" Foreground="#404040" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.TargetFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="4" Text="Threads" Foreground="#404040" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.ThreadCount}" Foreground="#101010" />
                    <TextBlock Grid.Row="5" Text="Source" Foreground="#404040" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="#101010" TextWrapping="Wrap" />
                  </Grid>
                </Grid>
              </Border>

              <Border Background="#CFCFCF" BorderBrush="#8A8A8A" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                  <Border Background="#B8B8B8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="6,3">
                    <TextBlock Text="Views" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="7" Spacing="4">
                    <Button HorizontalContentAlignment="Left" Padding="6,2">Frame Graph</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2">Profiler Scopes</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2">Scope Hotspots</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2">Selected Frame</Button>
                    <Button HorizontalContentAlignment="Left" Padding="6,2">Counters</Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Background="#CFCFCF" BorderBrush="#8A8A8A" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                  <Border Background="#B8B8B8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="6,3">
                    <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="7" Spacing="5">
                    <TextBlock Text="Captured root" Foreground="#404040" />
                    <TextBox Text="{Binding CapturedSourceRoot}" Watermark="/buildbot/workspace/project" />
                    <TextBlock Text="Local root" Foreground="#404040" Margin="0,4,0,0" />
                    <TextBox Text="{Binding LocalSourceRoot}" Watermark="/Users/me/project" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Background="#9A9A9A"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="6">
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
          <TextBlock Text="Frame Timeline" Foreground="#101010" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Summary.RangeText}" Foreground="#404040" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TimelineRangeText}" Foreground="#404040" VerticalAlignment="Center" />
        </StackPanel>
        <Grid Grid.Row="1" RowDefinitions="180,6,*">
          <Border Grid.Row="0" Background="#C8C8C8" BorderBrush="#808080" BorderThickness="1" MinHeight="120">
            <local:FrameTimelineControl
                Samples="{Binding FrameSamples}"
                TargetFrameMs="{Binding Summary.TargetFrameTimeMs}"
                Selection="{Binding Selection}"
                Viewport="{Binding Viewport}" />
          </Border>

          <GridSplitter Grid.Row="1"
                        Background="#9A9A9A"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Rows" />

          <Grid Grid.Row="2" RowDefinitions="*,6,180,6,160,6,150" Margin="0,8,0,0">
            <stats:ucProfilerStats x:Name="ProfilerStatsControl" Grid.Row="0" MinHeight="260" />

            <GridSplitter Grid.Row="1"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Border Grid.Row="2" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,96,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Scope Hotspots"
                             Foreground="#101010"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBox DockPanel.Dock="Right"
                           Text="{Binding ScopeFilterText}"
                           Width="180"
                           Margin="10,0,0,0"
                           Watermark="Filter scopes" />
                  <TextBlock Text="{Binding ScopeHotspotSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,7,0,0" Padding="6,4">
                  <Grid ColumnDefinitions="*,90,90,90,90,90">
                    <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Total ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Avg ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Average" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Max/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="5" Content="Calls/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxCount" Padding="0" HorizontalContentAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,3">
                          <Grid ColumnDefinitions="*,90,90,90,90,90">
                            <TextBlock Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding AverageTimeText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding MaxTimePerFrameText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{Binding MaxCountPerFrameText}" Foreground="#101010" TextAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="3"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Border Grid.Row="4" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Scopes"
                             Foreground="#101010"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameScopeSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#CFCFCF" BorderBrush="#808080" BorderThickness="1" Margin="0,7,0,7">
                  <local:SelectedFrameFlameChartControl Rows="{Binding SelectedFrameScopes}" />
                </Border>

                <Border Grid.Row="2" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="6,4">
                  <Grid ColumnDefinitions="140,*,80,80,220,64">
                    <Button Content="Thread" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Thread" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Scope" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Start ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Start" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Dur ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Duration" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Source" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Source" Padding="0" HorizontalContentAlignment="Left" />
                    <TextBlock Grid.Column="5" Text="Open" Foreground="#202020" FontWeight="SemiBold" TextAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameScopes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,3">
                          <Grid ColumnDefinitions="140,*,80,80,220,64">
                            <TextBlock Text="{Binding ThreadName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding IndentedName}" Foreground="#101010" TextTrimming="CharacterEllipsis" FontFamily="Menlo,Consolas,monospace" />
                            <TextBlock Grid.Column="2" Text="{Binding StartOffsetText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding SourceText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="5"
                                    Content="Open"
                                    Padding="6,1"
                                    HorizontalAlignment="Right"
                                    IsEnabled="{Binding CanOpenSource}"
                                    Command="{Binding $parent[Window].DataContext.OpenScopeSourceCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="5"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Border Grid.Row="6" Background="#D1D1D1" BorderBrush="#808080" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Counters"
                             Foreground="#101010"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameCounterSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,7,0,0" Padding="6,4">
                  <Grid ColumnDefinitions="150,*,90,90,80">
                    <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Count" Command="{Binding SortTableCommand}" CommandParameter="Counter:Count" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Unit" Command="{Binding SortTableCommand}" CommandParameter="Counter:Unit" Padding="0" HorizontalContentAlignment="Left" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,3">
                          <Grid ColumnDefinitions="150,*,90,90,80">
                            <TextBlock Text="{Binding GraphName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding UnitText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="#E6E6E6" BorderBrush="#8A8A8A" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="2*,*,*,2*" MinHeight="24">
        <Border BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" Padding="7,3">
          <TextBlock Text="{Binding StatusText}" Foreground="#202020" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border Grid.Column="1" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" Padding="7,3">
          <TextBlock Text="{Binding TimelineRangeText}" Foreground="#202020" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border Grid.Column="2" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" Padding="7,3">
          <TextBlock Text="{Binding Summary.SourceName}" Foreground="#202020" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border Grid.Column="3" Padding="7,3">
          <TextBlock Text="{Binding FooterText}" Foreground="#202020" TextTrimming="CharacterEllipsis" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
