<suki:SukiWindow
    x:Class="ProfilerStudy.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProfilerStudy.Avalonia"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    Title="ProfilerStudy"
    Width="1180"
    Height="760"
    MinWidth="860"
    MinHeight="560"
    CanPin="False"
    ShowBottomBorder="True"
    BackgroundAnimationEnabled="False">
  <Grid RowDefinitions="Auto,*,Auto" Background="#1F2329">
    <Border Grid.Row="0" Background="#2A3038" BorderBrush="#3A424D" BorderThickness="0,0,0,1" Padding="12,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding OpenSessionCommand}" Padding="12,6">Open</Button>
          <Button Command="{Binding LoadSampleCommand}" Padding="12,6">Sample</Button>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="#D8DEE9" VerticalAlignment="Center" Margin="16,0,0,0" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="280,*">
      <Border Grid.Column="0" Background="#252B33" BorderBrush="#3A424D" BorderThickness="0,0,1,0" Padding="16">
        <StackPanel Spacing="14">
          <TextBlock Text="Session" Foreground="#F2F4F8" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
            <TextBlock Text="Frames" Foreground="#9AA4B2" />
            <TextBlock Grid.Column="1" Text="{Binding Summary.FrameCount}" Foreground="#F2F4F8" />
            <TextBlock Grid.Row="1" Text="Average" Foreground="#9AA4B2" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.AverageFrameTimeText}" Foreground="#F2F4F8" />
            <TextBlock Grid.Row="2" Text="Max" Foreground="#9AA4B2" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Foreground="#F2F4F8" />
            <TextBlock Grid.Row="3" Text="Budget" Foreground="#9AA4B2" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.TargetFrameTimeText}" Foreground="#F2F4F8" />
            <TextBlock Grid.Row="4" Text="Source" Foreground="#9AA4B2" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="#F2F4F8" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="20">
        <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,0,0,12">
          <TextBlock Text="Frame Timeline" Foreground="#F2F4F8" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Summary.RangeText}" Foreground="#9AA4B2" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Row="1" Background="#15191F" BorderBrush="#3A424D" BorderThickness="1">
          <local:FrameTimelineControl Samples="{Binding FrameSamples}" TargetFrameMs="{Binding Summary.TargetFrameTimeMs}" />
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#252B33" BorderBrush="#3A424D" BorderThickness="0,1,0,0" Padding="12,8">
      <TextBlock Text="{Binding FooterText}" Foreground="#9AA4B2" />
    </Border>
  </Grid>
</suki:SukiWindow>
