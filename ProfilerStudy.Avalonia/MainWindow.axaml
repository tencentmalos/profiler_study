<Window
    x:Class="ProfilerStudy.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProfilerStudy.Avalonia"
    xmlns:stats="clr-namespace:ProfilerStudy.Avalonia.ProfilerStats"
    Title="ProfilerStudy"
    Width="1180"
    Height="760"
    MinWidth="860"
    MinHeight="560">
  <Window.Styles>
    <Style Selector="Button.toolbar-button">
      <Setter Property="Background" Value="#D3D3D3" />
      <Setter Property="BorderBrush" Value="#B4B4B4" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="#101010" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.toolbar-button:pointerover">
      <Setter Property="Background" Value="#E4E4E4" />
      <Setter Property="BorderBrush" Value="#989898" />
    </Style>
    <Style Selector="Button.toolbar-button:pressed">
      <Setter Property="Background" Value="#C2C2C2" />
      <Setter Property="BorderBrush" Value="#777777" />
    </Style>
    <Style Selector="Button.toolbar-button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.toolbar-button StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar-button Border">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button">
      <Setter Property="Background" Value="#D3D3D3" />
      <Setter Property="BorderBrush" Value="#B4B4B4" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="#101010" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:pointerover">
      <Setter Property="Background" Value="#E4E4E4" />
      <Setter Property="BorderBrush" Value="#989898" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:checked">
      <Setter Property="Background" Value="#BFCBE3" />
      <Setter Property="BorderBrush" Value="#6F82A3" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button Border">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.toolbox-section">
      <Setter Property="Background" Value="#D0D0D0" />
      <Setter Property="BorderBrush" Value="#858585" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.toolbox-section-header">
      <Setter Property="Background" Value="#BCBCBC" />
      <Setter Property="BorderBrush" Value="#858585" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="5,2" />
    </Style>
    <Style Selector="Button.toolbox-action">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Background" Value="#E0E0E0" />
      <Setter Property="BorderBrush" Value="#969696" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="#101010" />
    </Style>
    <Style Selector="Button.toolbox-action:pointerover">
      <Setter Property="Background" Value="#EAEAEA" />
    </Style>
    <Style Selector="Border.status-cell">
      <Setter Property="Background" Value="#D4D0C8" />
      <Setter Property="BorderBrush" Value="#8A8A8A" />
      <Setter Property="BorderThickness" Value="1,1,0,0" />
      <Setter Property="Padding" Value="5,1" />
    </Style>
    <Style Selector="TextBlock.status-label">
      <Setter Property="Foreground" Value="#404040" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.status-value">
      <Setter Property="Foreground" Value="#202020" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.document-tab">
      <Setter Property="Background" Value="#DADADA" />
      <Setter Property="BorderBrush" Value="#7E7E7E" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.document-info-cell">
      <Setter Property="Background" Value="#CFCFCF" />
      <Setter Property="BorderBrush" Value="#8A8A8A" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="TextBlock.document-label">
      <Setter Property="Foreground" Value="#505050" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="TextBlock.document-value">
      <Setter Property="Foreground" Value="#151515" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <Grid Background="#C8C8C8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="{Binding OutputWindowHeight}" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1">
      <Menu Background="#EFEFEF" FontSize="12" Padding="2,0">
        <MenuItem Header="_File">
          <MenuItem Header="_Open" InputGesture="Ctrl+O" Command="{Binding OpenSessionCommand}" />
          <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveSessionCommand}" />
          <MenuItem Header="Save _As..." Command="{Binding SaveSessionAsCommand}" />
          <MenuItem Header="_Close" Command="{Binding CloseSessionCommand}" />
          <MenuItem Header="Close A_ll" Command="{Binding CloseSessionCommand}" />
          <Separator />
          <MenuItem Header="_Export to CSV" Command="{Binding ExportFramesToCsvCommand}" />
          <MenuItem Header="Export _Frame Graph to CSV" Command="{Binding ExportFramesToCsvCommand}" />
          <Separator />
          <MenuItem Header="_Recent Files" Command="{Binding OpenRecentSessionCommand}" />
          <MenuItem Header="Load _Sample" Command="{Binding LoadSampleCommand}" />
          <Separator />
          <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="_Threads View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" />
          <MenuItem Header="_Cores View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" />
          <MenuItem Header="_Scopes View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" />
          <MenuItem Header="Custom _Stats View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" />
          <MenuItem Header="_Log View" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" />
          <Separator />
          <MenuItem Header="_Threads View">
            <MenuItem Header="_Info" ToggleType="CheckBox" IsChecked="{Binding IsThreadsInfoPanelVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="Info" />
            <MenuItem Header="_Frame Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsFrameGraphVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="FrameGraph" />
            <MenuItem Header="_Scope Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsScopeGraphVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="ScopeGraph" />
            <MenuItem Header="_CPU Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsCoreGraphVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CoreGraph" />
            <MenuItem Header="_Custom Stats Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsCustomStatsVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CustomStats" />
            <MenuItem Header="_Data Grid" ToggleType="CheckBox" IsChecked="{Binding IsThreadsDataGridVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="DataGrid" />
          </MenuItem>
          <MenuItem Header="Scope _Colouring">
            <MenuItem Header="Colour by _Thread" ToggleType="Radio" IsChecked="{Binding IsScopeColorModeThread, Mode=OneWay}" Command="{Binding SetScopeColorModeCommand}" CommandParameter="Thread" />
            <MenuItem Header="Colour by _Scope" ToggleType="Radio" IsChecked="{Binding IsScopeColorModeScope, Mode=OneWay}" Command="{Binding SetScopeColorModeCommand}" CommandParameter="Scope" />
          </MenuItem>
          <MenuItem Header="_Toolbox" ToggleType="CheckBox" IsChecked="{Binding IsToolboxVisible, Mode=OneWay}" Command="{Binding ToggleToolboxCommand}" />
          <MenuItem Header="_Output Window" ToggleType="CheckBox" IsChecked="{Binding IsOutputWindowVisible, Mode=OneWay}" Command="{Binding ToggleOutputWindowCommand}" />
        </MenuItem>
        <MenuItem Header="_Connection">
          <MenuItem Header="_New Connection..." Command="{Binding OpenConnectionCommand}" />
          <MenuItem Header="_Connect..." Command="{Binding OpenConnectionCommand}" />
          <MenuItem Header="_Disconnect" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
        </MenuItem>
        <MenuItem Header="_Tools">
          <Separator />
          <MenuItem Header="_Find" Command="{Binding OpenFindScopeCommand}" />
          <Separator />
          <MenuItem Header="_Create Session from Selection" Command="{Binding CreateSessionFromSelectionCommand}" />
          <Separator />
          <MenuItem Header="_Android">
            <MenuItem Header="_Start Recording Context Switches..." Command="{Binding OpenAndroidCommand}" />
            <MenuItem Header="_Load Context Switch File" Command="{Binding OpenAndroidCommand}" />
          </MenuItem>
          <Separator />
          <MenuItem Header="_Settings" Command="{Binding OpenSettingsCommand}" />
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="_Help" Command="{Binding ShowFeatureStatusCommand}" CommandParameter="Help" />
          <MenuItem Header="_Registration..." Command="{Binding ShowFeatureStatusCommand}" CommandParameter="Registration" />
          <MenuItem Header="_Check for Updates" Command="{Binding ShowFeatureStatusCommand}" CommandParameter="Check for Updates" />
          <Separator />
          <MenuItem Header="_Demo">
            <MenuItem Header="_Launch FramePro Game Simulator" Command="{Binding DemoActionCommand}" CommandParameter="LaunchGameSimulator" />
            <MenuItem Header="_Playback Recording File..." Command="{Binding DemoActionCommand}" CommandParameter="PlaybackRecordingFile" />
          </MenuItem>
          <MenuItem Header="_Show Startup Page" Command="{Binding ShowFeatureStatusCommand}" CommandParameter="Show Startup Page" />
          <Separator />
          <MenuItem Header="_About" Command="{Binding ShowFeatureStatusCommand}" CommandParameter="About" />
        </MenuItem>
      </Menu>
    </Border>

    <Border Grid.Row="1" Background="#D1D1D1" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Height="120">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="0" Margin="0">
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding OpenSessionCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#C6C099" BorderBrush="#706A3F" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="open" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Foreground="#332F16" />
              </Border>
              <TextBlock Text="Open" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding SaveSessionCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#A8B4C8" BorderBrush="#4B596F" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="save" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Foreground="#222B38" />
              </Border>
              <TextBlock Text="Save" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding SaveSessionAsCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#A8B4C8" BorderBrush="#4B596F" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="as" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#222B38" />
              </Border>
              <TextBlock Text="Save As" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding LoadSampleCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#B7B7B7" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="demo" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Foreground="#202020" />
              </Border>
              <TextBlock Text="Sample" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="18" Background="#D1D1D1" />
          <Button Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding OpenConnectionCommand}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#9FB6D5" BorderBrush="#4F6584" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="TCP" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#243244" />
              </Border>
              <TextBlock Text="Connect" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar-button" Width="31" MinHeight="118" Padding="2" Command="{Binding OpenConnectionCommand}">
            <StackPanel Spacing="4">
              <Border Width="19" Height="36" Background="#B8B8B8" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#202020" />
              </Border>
            </StackPanel>
          </Button>
          <Border Width="11" Background="#D1D1D1" />
          <Button Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding OpenAndroidCommand}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#9EBB9C" BorderBrush="#4E6F4D" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="ADB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#253725" />
              </Border>
              <TextBlock Text="Android" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="11" Background="#D1D1D1" />
          <Button Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#C16B62" BorderBrush="#73342E" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#3A1111" />
              </Border>
              <TextBlock Text="Disconnect" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="61" Background="#D1D1D1" />
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding ResetTimelineCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="|&lt;" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#202020" />
              </Border>
              <TextBlock Text="Start" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding TrackSelectedFrameCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="||" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#202020" />
              </Border>
              <TextBlock Text="Track" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding SelectLastFrameCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="&gt;|" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#202020" />
              </Border>
              <TextBlock Text="End" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="18" Background="#D1D1D1" />
          <ToggleButton Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="Info" IsChecked="{Binding IsThreadsInfoPanelVisible, Mode=OneWay}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="i" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#203246" />
              </Border>
              <TextBlock Text="Info" TextAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="FrameGraph" IsChecked="{Binding IsThreadsFrameGraphVisible, Mode=OneWay}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="ms" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#203246" />
              </Border>
              <TextBlock Text="Frames" TextAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="ScopeGraph" IsChecked="{Binding IsThreadsScopeGraphVisible, Mode=OneWay}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="{}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#203246" />
              </Border>
              <TextBlock Text="Scope" TextAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CoreGraph" IsChecked="{Binding IsThreadsCoreGraphVisible, Mode=OneWay}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="CPU" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#203246" />
              </Border>
              <TextBlock Text="Cores" TextAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CustomStats" IsChecked="{Binding IsThreadsCustomStatsVisible, Mode=OneWay}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="#" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#203246" />
              </Border>
              <TextBlock Text="Custom Stats" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="DataGrid" IsChecked="{Binding IsThreadsDataGridVisible, Mode=OneWay}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#203246" />
              </Border>
              <TextBlock Text="Details" TextAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Border Width="49" Background="#D1D1D1" />
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding SelectPreviousSpikeCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#D8B08D" BorderBrush="#7A4E2D" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="&lt;" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#3A2818" />
              </Border>
              <TextBlock Text="Prev" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding SelectSlowestFrameCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#D8B08D" BorderBrush="#7A4E2D" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#3A2818" />
              </Border>
              <TextBlock Text="Max" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar-button" Width="73" MinHeight="118" Padding="4" Command="{Binding SelectNextSpikeCommand}">
            <StackPanel Spacing="4">
              <Border Width="28" Height="36" Background="#D8B08D" BorderBrush="#7A4E2D" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="&gt;" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#3A2818" />
              </Border>
              <TextBlock Text="Next" TextAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="629" MinHeight="118" Background="#D1D1D1" Padding="8,9">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
              <DockPanel>
                <TextBlock Text="Find" Foreground="#101010" />
                <TextBlock Text="Find Scope" DockPanel.Dock="Right" Foreground="#505050" />
              </DockPanel>
              <TextBox Grid.Row="1" Watermark="Scope text" Text="{Binding ScopeFilterText}" Background="#E6E6E6" BorderBrush="#8A8A8A" BorderThickness="1" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                <Button Content="Prev" Width="68" Command="{Binding FindPreviousScopeCommand}" />
                <Button Content="Next" Width="68" Command="{Binding FindNextScopeCommand}" />
                <Button Content="Clear" Width="68" Command="{Binding ClearScopeFindCommand}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Width="47" Background="#D1D1D1" />
          <Button Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding ToggleScopeColorModeCommand}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#BCA0C8" BorderBrush="#6B4878" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="RGB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#33203C" />
              </Border>
              <TextBlock Text="Colour Mode" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ScopeColorModeText}" TextAlignment="Center" FontSize="10" Foreground="#505050" />
            </StackPanel>
          </Button>
          <Border Width="358" MinHeight="118" Background="#D1D1D1" Padding="8,9">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Text="Conditional Scope Time" Foreground="#101010" />
              <DockPanel Grid.Row="1">
                <TextBlock Text="{Binding ConditionalScopeTimeText}" Foreground="#404040" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                  <Button Content="-" Width="26" Padding="0" Command="{Binding AdjustConditionalScopeTimeCommand}" CommandParameter="Down" />
                  <Button Content="+" Width="26" Padding="0" Command="{Binding AdjustConditionalScopeTimeCommand}" CommandParameter="Up" />
                </StackPanel>
              </DockPanel>
              <Border Grid.Row="2" Height="18" Background="#C2C2C2" BorderBrush="#8A8A8A" BorderThickness="1">
                <Border Width="{Binding ConditionalScopeTimeWidth}" Background="#8F8F8F" HorizontalAlignment="Left" />
              </Border>
            </Grid>
          </Border>
          <Button Classes="toolbar-button" Width="119" MinHeight="118" Padding="4" Command="{Binding OpenCallstacksCommand}">
            <StackPanel Spacing="4">
              <Border Width="42" Height="36" Background="#B0B0B0" BorderBrush="#606060" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="stk" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#303030" />
              </Border>
              <TextBlock Text="Callstacks" TextAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Background="#BEBEBE">
      <Grid.RowDefinitions>
        <RowDefinition Height="27" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding ToolboxColumnWidth}" />
        <ColumnDefinition Width="{Binding ToolboxSplitterWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#BEBEBE" BorderBrush="#868686" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="document-tab" Margin="3,3,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="Profiler Session" Classes="document-value" FontWeight="SemiBold" />
              <TextBlock Text="-" Classes="document-label" />
              <TextBlock Text="{Binding ActiveSessionView}" Classes="document-value" />
            </StackPanel>
          </Border>
          <Grid Grid.Column="1" ColumnDefinitions="2*,Auto,Auto,Auto" Height="26" Margin="0,1,3,0">
            <Border Classes="document-info-cell">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Session:" Classes="document-label" />
                <TextBlock Text="{Binding Summary.SourceName}" Classes="document-value" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="document-info-cell" MinWidth="210">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Range:" Classes="document-label" />
                <TextBlock Text="{Binding TimelineRangeText}" Classes="document-value" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="document-info-cell" MinWidth="175">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Frame:" Classes="document-label" />
                <TextBlock Text="{Binding SelectedFrameStatusText}" Classes="document-value" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#CFCFCF" Padding="7,2">
              <TextBlock Text="{Binding StatusText}" Classes="document-value" />
            </Border>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Row="1" Grid.Column="0" Background="#D4D4D4" BorderBrush="#868686" BorderThickness="0,0,1,0" IsVisible="{Binding IsToolboxVisible}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="#BDBDBD" BorderBrush="#868686" BorderThickness="0,0,0,1" Padding="5,3">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Toolbox" Foreground="#101010" FontSize="12" FontWeight="SemiBold" />
              <Button DockPanel.Dock="Right"
                      Content="x"
                      Width="22"
                      Height="20"
                      Padding="0"
                      FontSize="11"
                      Command="{Binding ToggleToolboxCommand}" />
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5" Spacing="5">
              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Session Info" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="7" Margin="6">
                    <TextBlock Text="Frames" Foreground="#404040" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.FrameCount}" Foreground="#101010" />
                    <TextBlock Grid.Row="1" Text="Average" Foreground="#404040" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.AverageFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="2" Text="Max" Foreground="#404040" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="3" Text="Budget" Foreground="#404040" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.TargetFrameTimeText}" Foreground="#101010" />
                    <TextBlock Grid.Row="4" Text="Threads" Foreground="#404040" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.ThreadCount}" Foreground="#101010" />
                    <TextBlock Grid.Row="5" Text="Source" Foreground="#404040" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="#101010" TextWrapping="Wrap" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="6" ColumnSpacing="4" RowSpacing="4">
                    <Button Classes="toolbox-action" Content="Connect..." Command="{Binding OpenConnectionCommand}" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Android..." Command="{Binding OpenAndroidCommand}" />
                    <Button Grid.Row="1" Grid.ColumnSpan="2" Classes="toolbox-action" Content="Disconnect" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Frame Navigation" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="6" ColumnSpacing="4" RowSpacing="4">
                    <Button Classes="toolbox-action" Content="Start" Command="{Binding ResetTimelineCommand}" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Track" Command="{Binding TrackSelectedFrameCommand}" />
                    <Button Grid.Column="2" Classes="toolbox-action" Content="End" Command="{Binding SelectLastFrameCommand}" />
                    <Button Grid.Row="1" Classes="toolbox-action" Content="Prev Spike" Command="{Binding SelectPreviousSpikeCommand}" />
                    <Button Grid.Row="1" Grid.Column="1" Classes="toolbox-action" Content="Max" Command="{Binding SelectSlowestFrameCommand}" />
                    <Button Grid.Row="1" Grid.Column="2" Classes="toolbox-action" Content="Next Spike" Command="{Binding SelectNextSpikeCommand}" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Window Layout" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="6" Spacing="3">
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}">Threads View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" Foreground="{Binding CoresViewBrush}">Cores View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" Foreground="{Binding ScopesViewBrush}">Scopes View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" Foreground="{Binding CustomStatsViewBrush}">Custom Stats View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" Foreground="{Binding LogViewBrush}">Log View</Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Threads View Panels" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="6" Spacing="3">
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="Info" Foreground="{Binding ThreadsViewBrush}">Info</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="FrameGraph" Foreground="{Binding ThreadsViewBrush}">Frame Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="ScopeGraph" Foreground="{Binding ThreadsViewBrush}">Scope Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CoreGraph" Foreground="{Binding CoresViewBrush}">Core Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CustomStats" Foreground="{Binding CustomStatsViewBrush}">Custom Stats Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="DataGrid" Foreground="{Binding ThreadsViewBrush}">Data Grid</Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Find Scope" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="6" RowSpacing="4">
                    <TextBox Text="{Binding ScopeFilterText}" Watermark="scope text" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="4">
                      <Button Classes="toolbox-action" Content="Prev" Command="{Binding FindPreviousScopeCommand}" />
                      <Button Grid.Column="1" Classes="toolbox-action" Content="Next" Command="{Binding FindNextScopeCommand}" />
                      <Button Grid.Column="2" Classes="toolbox-action" Content="Clear" Command="{Binding ClearScopeFindCommand}" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="#101010" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="6" Spacing="4">
                    <TextBlock Text="Captured root" Foreground="#404040" />
                    <TextBox Text="{Binding CapturedSourceRoot}" Watermark="/buildbot/workspace/project" />
                    <TextBlock Text="Local root" Foreground="#404040" Margin="0,4,0,0" />
                    <TextBox Text="{Binding LocalSourceRoot}" Watermark="/Users/me/project" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1"
                    Grid.Column="1"
                    Background="#9A9A9A"
                    BorderBrush="#767676"
                    BorderThickness="1,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding IsToolboxVisible}"
                    ResizeDirection="Columns" />

      <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="0,*,31" Margin="0" Background="#C8C8C8">
        <Border Background="#CFCFCF" BorderBrush="#7D7D7D" BorderThickness="1" Margin="0,0,0,4">
          <Grid RowDefinitions="24,Auto,Auto">
            <Border Grid.Row="0" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="0,0,0,1" Padding="6,0">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Content="_" Width="22" Height="18" Padding="0" FontSize="10" Command="{Binding ShowFeatureStatusCommand}" CommandParameter="Minimize Dock" />
                  <Button Content="□" Width="22" Height="18" Padding="0" FontSize="10" Command="{Binding ShowFeatureStatusCommand}" CommandParameter="Float Dock" />
                  <Button Content="x" Width="22" Height="18" Padding="0" FontSize="10" Command="{Binding ToggleOutputWindowCommand}" />
                </StackPanel>
                <TextBlock Text="Main Session View" Foreground="#101010" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="#D7D7D7" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="4,3">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Button Content="Threads" Width="86" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}" />
                <Button Content="Cores" Width="76" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" Foreground="{Binding CoresViewBrush}" />
                <Button Content="Scopes" Width="82" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" Foreground="{Binding ScopesViewBrush}" />
                <Button Content="Custom Stats" Width="112" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" Foreground="{Binding CustomStatsViewBrush}" />
                <Button Content="Log" Width="64" Padding="6,2" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" Foreground="{Binding LogViewBrush}" />
              </StackPanel>
            </Border>
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="6,4">
              <TextBlock Text="{Binding ActiveSessionViewTitle}" Foreground="#101010" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#404040" VerticalAlignment="Center" FontSize="11" />
              <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*" ColumnSpacing="8" Margin="0,5,0,0">
                <TextBlock Text="Info" Foreground="#5A5A5A" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Summary.RangeText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="Frame Graph" Foreground="#5A5A5A" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="{Binding TimelineRangeText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="Scope Graph" Foreground="#5A5A5A" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="{Binding SelectedFrameScopeSummaryText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="6" Text="Custom Stats" Foreground="#5A5A5A" FontWeight="SemiBold" />
                <TextBlock Grid.Column="7" Text="{Binding SelectedFrameCounterSummaryText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="150,24,4,*" IsVisible="{Binding IsThreadsViewActive}" Background="#C8C8C8">
          <Grid Grid.Row="0" ColumnDefinitions="32,210,*" IsVisible="{Binding IsThreadsFrameGraphVisible}">
            <Border Grid.Column="0" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
              <TextBlock Text="Frame"
                         Foreground="#202020"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </Border>

            <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="{Binding IsThreadsInfoPanelVisible}">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*,46">
                <Button Grid.Column="0"
                        Content="Filter Threads..."
                        HorizontalContentAlignment="Left"
                        Padding="6,2"
                        Command="{Binding SelectSessionViewCommand}"
                        CommandParameter="Threads" />
                <Button Grid.Column="1"
                        Content="Name"
                        Padding="0"
                        ToolTip.Tip="Show threads by name or by id" />
                <TextBox Grid.Row="1"
                         Grid.Column="0"
                         Text="{Binding ThreadFilterText}"
                         Watermark="thread or scope text"
                         Margin="0,3,2,0" />
                <Button Grid.Row="1"
                        Grid.Column="1"
                        Content="X"
                        Padding="0"
                        Margin="0,3,0,0"
                        Command="{Binding ClearThreadFilterCommand}" />
                <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,4" />
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding TimelineRangeText}" Foreground="#404040" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding Selection.SelectedFrameLabel}" Foreground="#101010" />
              </Grid>
            </Border>

            <Border Grid.Column="1" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="{Binding IsThreadsInfoPanelCollapsed}">
              <TextBlock Text="Info hidden" Foreground="#303030" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Grid.Column="2" Background="#C8C8C8" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1" MinHeight="120">
              <local:FrameTimelineControl
                  Samples="{Binding FrameSamples}"
                  TargetFrameMs="{Binding Summary.TargetFrameTimeMs}"
                  Selection="{Binding Selection}"
                  Viewport="{Binding Viewport}" />
            </Border>
          </Grid>

          <Border Grid.Row="0" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsFrameGraphCollapsed}">
            <Grid ColumnDefinitions="32,*">
              <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                <TextBlock Text="Frame" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
              </Border>
              <TextBlock Grid.Column="1" Text="Frame Graph hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" ColumnDefinitions="32,210,*" IsVisible="{Binding IsThreadsFrameGraphVisible}">
            <Border Grid.Column="0" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1,0,0,1" />
            <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1,0,1,1" Padding="4,2">
              <Grid ColumnDefinitions="22,22,*,22,22" ColumnSpacing="3">
                <Button Content="◀" Padding="0" Command="{Binding PanTimelineLeftCommand}" />
                <Button Grid.Column="1" Content="-" Padding="0" Command="{Binding ZoomTimelineOutCommand}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding TimelineRangeText}"
                           Foreground="#303030"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="3" Content="+" Padding="0" Command="{Binding ZoomTimelineInCommand}" />
                <Button Grid.Column="4" Content="▶" Padding="0" Command="{Binding PanTimelineRightCommand}" />
            </Grid>
          </Border>

          <Border Grid.Row="1" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1,0,1,1" IsVisible="{Binding IsThreadsFrameGraphCollapsed}">
            <TextBlock Text="Session scrollbar hidden with Frame Graph" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
          </Border>
            <Border Grid.Column="2" Background="#CFCFCF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,1" Padding="8,4">
              <local:SessionScrollbarControl Viewport="{Binding Viewport}" />
            </Border>
          </Grid>

          <GridSplitter Grid.Row="2"
                        Background="#9A9A9A"
                        BorderBrush="#767676"
                        BorderThickness="0,1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Rows"
                        IsVisible="{Binding IsThreadsFrameGraphVisible}" />

          <Grid Grid.Row="3" RowDefinitions="260,4,88,4,*,4,156,4,140,4,128" Margin="0,3,0,0" Background="#C8C8C8">
            <Grid Grid.Row="0" ColumnDefinitions="32,210,*,17" IsVisible="{Binding IsThreadsScopeGraphVisible}">
              <Border Grid.Column="0" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
                <TextBlock Text="Threads"
                           Foreground="#202020"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </Border>

              <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6">
                <StackPanel Spacing="4">
                  <TextBlock Text="Thread Activity" Foreground="#101010" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ThreadTimelineSummaryText}" Foreground="#404040" TextWrapping="Wrap" />
                  <Separator Margin="0,4" />
                  <TextBlock Text="{Binding TimelineRangeText}" Foreground="#404040" />
                  <TextBlock Text="{Binding Summary.ThreadCountLabel}" Foreground="#404040" />
                  <TextBlock Text="{Binding Summary.CoreCountLabel}" Foreground="#404040" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="0,1,0,1">
                <local:ThreadTimelineLaneControl
                    Rows="{Binding VisibleThreadScopes}"
                    Samples="{Binding FrameSamples}"
                    Viewport="{Binding Viewport}"
                    Selection="{Binding Selection}"
                    ColorMode="{Binding ScopeColorMode}"
                    OpenScopeSourceCommand="{Binding OpenScopeSourceCommand}"
                    FocusThreadCommand="{Binding FocusThreadCommand}">
                  <local:ThreadTimelineLaneControl.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Hide" Command="{Binding HideFocusedThreadCommand}" />
                      <Separator />
                      <MenuItem Header="Collapse All" Command="{Binding CollapseAllThreadsCommand}" />
                      <MenuItem Header="Expand All" Command="{Binding ExpandAllThreadsCommand}" />
                      <Separator />
                      <MenuItem Header="Move Up" Command="{Binding MoveFocusedThreadUpCommand}" />
                      <MenuItem Header="Move Down" Command="{Binding MoveFocusedThreadDownCommand}" />
                      <Separator />
                      <MenuItem Header="Settings..." Command="{Binding ThreadSettingsCommand}" />
                    </ContextMenu>
                  </local:ThreadTimelineLaneControl.ContextMenu>
                </local:ThreadTimelineLaneControl>
              </Border>

              <Border Grid.Column="3" Background="#D7D7D7" BorderBrush="#7D7D7D" BorderThickness="1">
                <Grid RowDefinitions="18,*,18">
                  <Button Content="▲"
                          FontSize="8"
                          Padding="0"
                          BorderThickness="0"
                          Background="#D7D7D7"
                          Command="{Binding ScrollThreadTimelineUpCommand}" />
                  <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1" Margin="2,20,2,20" />
                  <Button Grid.Row="2"
                          Content="▼"
                          FontSize="8"
                          Padding="0"
                          BorderThickness="0"
                          Background="#D7D7D7"
                          Command="{Binding ScrollThreadTimelineDownCommand}" />
                </Grid>
              </Border>
            </Grid>

            <Border Grid.Row="0" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsScopeGraphCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                  <TextBlock Text="Threads" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Border>
                <TextBlock Grid.Column="1" Text="Scope Graph hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="1"
                          Background="#9A9A9A"
                          BorderBrush="#767676"
                          BorderThickness="0,1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsScopeGraphVisible}" />

            <Grid Grid.Row="2" ColumnDefinitions="32,210,*" IsVisible="{Binding IsThreadsCoreGraphVisible}">
              <Border Grid.Column="0" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
                <TextBlock Text="Cores"
                           Foreground="#202020"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </Border>

              <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6">
                <StackPanel Spacing="4">
                  <TextBlock Text="Core Activity" Foreground="#101010" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CoreSummaryText}" Foreground="#404040" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1">
                <local:CoreTimelineStripControl
                    Rows="{Binding CoreRows}"
                    SummaryText="{Binding CoreSummaryText}" />
              </Border>
            </Grid>

            <Border Grid.Row="2" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsCoreGraphCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                  <TextBlock Text="Cores" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Border>
                <TextBlock Grid.Column="1" Text="Core Graph hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="3"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsCoreGraphVisible}" />

            <Grid Grid.Row="4" ColumnDefinitions="32,210,*" IsVisible="{Binding IsThreadsCustomStatsVisible}">
              <Border Grid.Column="0" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1,1,0,1">
                <TextBlock Text="Stats"
                           Foreground="#202020"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </Border>

              <Border Grid.Column="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6">
                <StackPanel Spacing="4">
                  <TextBlock Text="Custom Stats" Foreground="#101010" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameCounterSummaryText}" Foreground="#404040" TextWrapping="Wrap" />
                  <Separator Margin="0,4" />
                  <TextBlock Text="Scope Hotspots" Foreground="#101010" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ScopeHotspotSummaryText}" Foreground="#404040" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="0,1,1,1">
                <stats:ucProfilerStats x:Name="ProfilerStatsControl" MinHeight="260" />
              </Border>
            </Grid>

            <Border Grid.Row="4" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsCustomStatsCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                  <TextBlock Text="Stats" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Border>
                <TextBlock Grid.Column="1" Text="Custom Stats hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="7"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsDataGridVisible}" />

            <Border Grid.Row="8" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="{Binding IsThreadsDataGridVisible}">
              <Grid RowDefinitions="Auto,96,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Scope Hotspots"
                             Foreground="#101010"
                             FontSize="12"
                             FontWeight="SemiBold" />
                  <TextBox DockPanel.Dock="Right"
                           Text="{Binding ScopeFilterText}"
                           Width="180"
                           Margin="10,0,0,0"
                           Watermark="Filter scopes" />
                  <TextBlock Text="{Binding ScopeHotspotSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="5,3">
                  <Grid ColumnDefinitions="*,90,90,90,90,90">
                    <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Total ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Avg ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Average" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Max/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="5" Content="Calls/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxCount" Padding="0" HorizontalContentAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,3">
                          <Grid ColumnDefinitions="*,90,90,90,90,90">
                            <TextBlock Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding AverageTimeText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding MaxTimePerFrameText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{Binding MaxCountPerFrameText}" Foreground="#101010" TextAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="5"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsDataGridVisible}" />

            <Border Grid.Row="6" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="{Binding IsThreadsDataGridVisible}">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Scopes"
                             Foreground="#101010"
                             FontSize="12"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameScopeSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#CFCFCF" BorderBrush="#7D7D7D" BorderThickness="1" Margin="0,5,0,5">
                  <local:SelectedFrameThreadLaneControl Rows="{Binding SelectedFrameScopes}" ColorMode="{Binding ScopeColorMode}" />
                </Border>

                <Border Grid.Row="2" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="5,3">
                  <Grid ColumnDefinitions="140,*,80,80,220,64">
                    <Button Content="Thread" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Thread" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Scope" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Start ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Start" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Dur ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Duration" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Source" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Source" Padding="0" HorizontalContentAlignment="Left" />
                    <TextBlock Grid.Column="5" Text="Open" Foreground="#202020" FontWeight="SemiBold" TextAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameScopes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,3">
                          <Grid ColumnDefinitions="140,*,80,80,220,64">
                            <TextBlock Text="{Binding ThreadName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding IndentedName}" Foreground="#101010" TextTrimming="CharacterEllipsis" FontFamily="Menlo,Consolas,monospace" />
                            <TextBlock Grid.Column="2" Text="{Binding StartOffsetText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding SourceText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="5"
                                    Content="Open"
                                    Padding="6,1"
                                    HorizontalAlignment="Right"
                                    IsEnabled="{Binding CanOpenSource}"
                                    Command="{Binding $parent[Window].DataContext.OpenScopeSourceCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <Border Grid.Row="6" Background="#BDBDBD" BorderBrush="#7D7D7D" BorderThickness="1" IsVisible="{Binding IsThreadsDataGridCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="#AFAFAF" BorderBrush="#7D7D7D" BorderThickness="0,0,1,0">
                  <TextBlock Text="Data" Foreground="#202020" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Border>
                <TextBlock Grid.Column="1" Text="Data Grid hidden" Foreground="#303030" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="9"
                          Background="#9A9A9A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsDataGridVisible}" />

            <Border Grid.Row="10" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="6" IsVisible="{Binding IsThreadsDataGridVisible}">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Counters"
                             Foreground="#101010"
                             FontSize="12"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameCounterSummaryText}"
                             Foreground="#404040"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="5,3">
                  <Grid ColumnDefinitions="150,*,90,90,80">
                    <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Count" Command="{Binding SortTableCommand}" CommandParameter="Counter:Count" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Unit" Command="{Binding SortTableCommand}" CommandParameter="Counter:Unit" Padding="0" HorizontalContentAlignment="Left" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="6,3">
                          <Grid ColumnDefinitions="150,*,90,90,80">
                            <TextBlock Text="{Binding GraphName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="#101010" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding UnitText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Border Grid.Row="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="12" IsVisible="{Binding IsCoresViewActive}">
          <Grid RowDefinitions="Auto,Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Cores View" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CoreSummaryText}" Foreground="#404040" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,8,0,0" Padding="6,4">
              <Grid ColumnDefinitions="150,*">
                <TextBlock Text="Core" Foreground="#202020" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Context switches in visible range" Foreground="#202020" FontWeight="SemiBold" TextAlignment="Right" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding CoreRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,3">
                      <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{Binding CoreText}" Foreground="#101010" />
                        <TextBlock Grid.Column="1" Text="{Binding ContextSwitchCount}" Foreground="#101010" TextAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="12" IsVisible="{Binding IsScopesViewActive}">
          <Grid RowDefinitions="Auto,Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Scopes View" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
              <TextBox DockPanel.Dock="Right"
                       Text="{Binding ScopeFilterText}"
                       Width="220"
                       Margin="10,0,0,0"
                       Watermark="Filter scopes" />
              <TextBlock Text="{Binding ScopeHotspotSummaryText}" Foreground="#404040" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,8,0,0" Padding="6,4">
              <Grid ColumnDefinitions="*,90,90,90,90,90">
                <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="Total ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="3" Content="Avg ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Average" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="4" Content="Max/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxTime" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="5" Content="Calls/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxCount" Padding="0" HorizontalContentAlignment="Right" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,3">
                      <Grid ColumnDefinitions="*,90,90,90,90,90">
                        <TextBlock Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding AverageTimeText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding MaxTimePerFrameText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{Binding MaxCountPerFrameText}" Foreground="#101010" TextAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="12" IsVisible="{Binding IsCustomStatsViewActive}">
          <Grid RowDefinitions="Auto,Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Custom Stats View" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedFrameCounterSummaryText}" Foreground="#404040" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,8,0,0" Padding="6,4">
              <Grid ColumnDefinitions="150,*,90,90,80">
                <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="3" Content="Count" Command="{Binding SortTableCommand}" CommandParameter="Counter:Count" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="4" Content="Unit" Command="{Binding SortTableCommand}" CommandParameter="Counter:Unit" Padding="0" HorizontalContentAlignment="Left" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,3">
                      <Grid ColumnDefinitions="150,*,90,90,80">
                        <TextBlock Text="{Binding GraphName}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="#101010" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding UnitText}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#D0D0D0" BorderBrush="#7D7D7D" BorderThickness="1" Padding="12" IsVisible="{Binding IsLogViewActive}">
          <Grid RowDefinitions="Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Log View" Foreground="#101010" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LogSummaryText}" Foreground="#404040" HorizontalAlignment="Right" />
            </DockPanel>
            <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,8,0,0">
              <Border Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Padding="6,4">
                <Grid ColumnDefinitions="58,130,*">
                  <TextBlock Text="#" Foreground="#202020" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="Time" Foreground="#202020" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="Message" Foreground="#202020" FontWeight="SemiBold" />
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" Background="#EFEFEF" BorderBrush="#8A8A8A" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LogRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,3">
                        <Grid ColumnDefinitions="58,130,*">
                          <TextBlock Text="{Binding Index}" Foreground="#101010" />
                          <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#101010" />
                          <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#101010" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#D4D0C8" BorderBrush="#8A8A8A" BorderThickness="1,1,1,0" Margin="0,4,0,0">
          <Grid RowDefinitions="1,8,*" ColumnDefinitions="104,82,96,176,72,*">
            <Border Grid.Row="0" Grid.ColumnSpan="6" Background="#8A8A8A" />
            <Polygon Grid.Row="1" Grid.Column="0" Points="42,0 62,0 52,8" Fill="#8A8A8A" IsVisible="{Binding IsThreadsViewActive}" />
            <Polygon Grid.Row="1" Grid.Column="1" Points="28,0 48,0 38,8" Fill="#8A8A8A" IsVisible="{Binding IsCoresViewActive}" />
            <Polygon Grid.Row="1" Grid.Column="2" Points="34,0 54,0 44,8" Fill="#8A8A8A" IsVisible="{Binding IsScopesViewActive}" />
            <Polygon Grid.Row="1" Grid.Column="3" Points="72,0 92,0 82,8" Fill="#8A8A8A" IsVisible="{Binding IsCustomStatsViewActive}" />
            <Polygon Grid.Row="1" Grid.Column="4" Points="22,0 42,0 32,8" Fill="#8A8A8A" IsVisible="{Binding IsLogViewActive}" />

            <Button Grid.Row="2" Grid.Column="0"
                    Content="Threads"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Threads"
                    FontSize="12"
                    Foreground="{Binding ThreadsViewBrush}"
                    Background="#D4D0C8"
                    BorderBrush="#8A8A8A"
                    BorderThickness="0,0,1,0"
                    Padding="8,0" />
            <Button Grid.Row="2" Grid.Column="1"
                    Content="Cores"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Cores"
                    FontSize="12"
                    Foreground="{Binding CoresViewBrush}"
                    Background="#D4D0C8"
                    BorderBrush="#8A8A8A"
                    BorderThickness="0,0,1,0"
                    Padding="8,0" />
            <Button Grid.Row="2" Grid.Column="2"
                    Content="Scopes"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Scopes"
                    FontSize="12"
                    Foreground="{Binding ScopesViewBrush}"
                    Background="#D4D0C8"
                    BorderBrush="#8A8A8A"
                    BorderThickness="0,0,1,0"
                    Padding="8,0" />
            <Button Grid.Row="2" Grid.Column="3"
                    Content="Custom Stats"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Custom Stats"
                    FontSize="12"
                    Foreground="{Binding CustomStatsViewBrush}"
                    Background="#D4D0C8"
                    BorderBrush="#8A8A8A"
                    BorderThickness="0,0,1,0"
                    Padding="8,0" />
            <Button Grid.Row="2" Grid.Column="4"
                    Content="Log"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Log"
                    FontSize="12"
                    Foreground="{Binding LogViewBrush}"
                    Background="#D4D0C8"
                    BorderBrush="#8A8A8A"
                    BorderThickness="0,0,1,0"
                    Padding="8,0" />
            <DockPanel Grid.Row="2" Grid.Column="5" LastChildFill="True" Margin="8,0,8,0">
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding SessionStatusText}"
                         Foreground="#505050"
                         FontSize="11"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding ActiveSessionViewTitle}"
                         Foreground="#707070"
                         FontSize="11"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsSettingsPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Settings" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseSettingsCommand}" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="#101010" />
          <TextBlock Text="These settings are used when opening captured source paths from profiler scope rows." Foreground="#404040" TextWrapping="Wrap" />
          <TextBlock Text="Captured root" Foreground="#303030" Margin="0,4,0,0" />
          <TextBox Text="{Binding CapturedSourceRoot}" Watermark="/buildbot/workspace/project" />
          <TextBlock Text="Local root" Foreground="#303030" />
          <TextBox Text="{Binding LocalSourceRoot}" Watermark="/Users/me/project" />
          <Border Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8" Margin="0,6,0,0">
            <TextBlock Text="Changes are saved automatically and reused by the source navigation commands." Foreground="#303030" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" Width="86" Command="{Binding CloseSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsCallstacksPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Callstacks" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseCallstacksCommand}" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Callstack Tools" FontWeight="SemiBold" Foreground="#101010" />
          <TextBlock Text="Enable or disable callstack capture for a live session, then request a module symbol reload for captured sessions." Foreground="#404040" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,4,0,0">
            <Border Width="42" Height="34" Background="#B0B0B0" BorderBrush="#606060" BorderThickness="1">
              <TextBlock Text="stk" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#303030" />
            </Border>
            <Button Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Toggle Live Callstack Recording"
                    Command="{Binding CallstacksActionCommand}"
                    CommandParameter="Capture" />
            <Border Grid.Row="1" Width="42" Height="34" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1">
              <TextBlock Text="sym" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#202020" />
            </Border>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Reload Module Symbols"
                    Command="{Binding CallstacksActionCommand}"
                    CommandParameter="Resolve" />
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8">
              <TextBlock Text="{Binding CallstacksPanelStatusText}" Foreground="#303030" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" Width="86" Command="{Binding CloseCallstacksCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsConnectionPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseConnectionCommand}" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="FramePro Connection" FontWeight="SemiBold" Foreground="#101010" />
          <TextBlock Text="Connection controls are represented here so the Avalonia shell matches the original profiler entry points." Foreground="#404040" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="84,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,4,0,0">
            <TextBlock Text="Host" Foreground="#303030" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ConnectionHost}" Watermark="localhost" />
            <TextBlock Grid.Row="1" Text="Port" Foreground="#303030" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionPort}" Watermark="8428" />
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8">
              <TextBlock Text="{Binding ConnectionPanelStatusText}" Foreground="#303030" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="New" Width="74" Command="{Binding ConnectionActionCommand}" CommandParameter="New" />
            <Button Content="Connect" Width="86" Command="{Binding ConnectionActionCommand}" CommandParameter="Connect" />
            <Button Content="Disconnect" Width="92" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
            <Button Content="Close" Width="74" Command="{Binding CloseConnectionCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsAndroidPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Android" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseAndroidCommand}" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Context Switch Tools" FontWeight="SemiBold" Foreground="#101010" />
          <TextBlock Text="Connect to the FramePro socket exposed by the Android app, or load a recorded context switch file into the active session." Foreground="#404040" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,4,0,0">
            <Border Width="42" Height="34" Background="#9EBB9C" BorderBrush="#4E6F4D" BorderThickness="1">
              <TextBlock Text="ADB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#253725" />
            </Border>
            <Grid Grid.Column="1" ColumnDefinitions="*,64,68" ColumnSpacing="6">
              <TextBox Text="{Binding AndroidEndpoint}" Watermark="localfilesystem:/data/user_de/0/.../files/framepro" />
              <Button Grid.Column="1"
                      Content="Debug"
                      Command="{Binding AndroidActionCommand}"
                      CommandParameter="UseDebugEndpoint" />
              <Button Grid.Column="2"
                      Content="Release"
                      Command="{Binding AndroidActionCommand}"
                      CommandParameter="UseReleaseEndpoint" />
            </Grid>
            <Border Grid.Row="1" Width="42" Height="34" Background="#9EBB9C" BorderBrush="#4E6F4D" BorderThickness="1">
              <TextBlock Text="tcp" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#253725" />
            </Border>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Connect Android"
                    Command="{Binding AndroidActionCommand}"
                    CommandParameter="ConnectAndroid" />
            <Border Grid.Row="2" Width="42" Height="34" Background="#9EBB9C" BorderBrush="#4E6F4D" BorderThickness="1">
              <TextBlock Text="rec" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#253725" />
            </Border>
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,72,*" ColumnSpacing="6">
              <TextBlock Text="Duration (seconds)" Foreground="#303030" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding AndroidRecordingDuration}" />
              <Button Grid.Column="2"
                      HorizontalContentAlignment="Left"
                      Content="Start Recording Context Switches..."
                      Command="{Binding AndroidActionCommand}"
                      CommandParameter="RecordContextSwitches" />
            </Grid>
            <Border Grid.Row="3" Width="42" Height="34" Background="#BDBDBD" BorderBrush="#606060" BorderThickness="1">
              <TextBlock Text="ctx" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#202020" />
            </Border>
            <Button Grid.Row="3"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Load Context Switch File"
                    Command="{Binding AndroidActionCommand}"
                    CommandParameter="LoadContextSwitchFile" />
            <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="8">
              <TextBlock Text="{Binding AndroidPanelStatusText}" Foreground="#303030" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" Width="86" Command="{Binding CloseAndroidCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#D2D2D2"
            BorderBrush="#676767"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000"
            Padding="0"
            IsVisible="{Binding IsAboutPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BDBDBD" BorderBrush="#777777" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel LastChildFill="True">
            <TextBlock Text="About" FontWeight="SemiBold" Foreground="#101010" />
            <Button DockPanel.Dock="Right"
                    Content="x"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Command="{Binding CloseAboutCommand}" />
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
            <Border Width="64" Height="64" Background="#8DA6C4" BorderBrush="#395978" BorderThickness="1">
              <TextBlock Text="FP"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="#203246" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Binding AboutProductText}" FontSize="20" FontWeight="SemiBold" Foreground="#101010" />
              <TextBlock Text="FramePro profiler viewer" Foreground="#303030" />
              <TextBlock Text="{Binding AboutCopyrightText}" Foreground="#303030" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Background="#C5C5C5" BorderBrush="#888888" BorderThickness="1" Padding="10">
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
              <TextBlock Text="Version" Foreground="#404040" />
              <TextBlock Grid.Column="1" Text="{Binding AboutVersionText}" Foreground="#101010" />
              <TextBlock Grid.Row="1" Text="Website" Foreground="#404040" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AboutWebsiteText}" Foreground="#101010" />
              <TextBlock Grid.Row="2" Text="E-mail" Foreground="#404040" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AboutEmailText}" Foreground="#101010" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="2"
                     Text="This Avalonia shell reuses the legacy FramePro session core and preserves the original profiler entry points while bringing the UI to macOS."
                     Foreground="#404040"
                     TextWrapping="Wrap" />

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Close" Width="86" Command="{Binding CloseAboutCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,1,0,0" MinHeight="120" IsVisible="{Binding IsOutputWindowVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#BEBEBE" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1" Padding="7,3">
          <TextBlock Text="Output Window" FontWeight="SemiBold" Foreground="#101010" />
        </Border>
        <TextBox Grid.Row="1"
                 Text="{Binding OutputLogText}"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="#EFEFEF"
                 Foreground="#101010"
                 FontFamily="Menlo,Consolas,monospace"
                 FontSize="11" />
      </Grid>
    </Border>

    <Border Grid.Row="4" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,1,0,0" Padding="2">
      <Grid ColumnDefinitions="2*,150,170,230,150,220,180" ColumnSpacing="2" MinHeight="20">
        <Border Classes="status-cell">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Classes="status-label" Text="Status" />
            <TextBlock Classes="status-value" Text="{Binding StatusText}" />
          </DockPanel>
        </Border>
        <Border Grid.Column="1" Classes="status-cell">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Classes="status-label" Text="Session" />
            <TextBlock Classes="status-value" Text="{Binding SessionStatusText}" />
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Classes="status-cell">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Classes="status-label" Text="Frame" />
            <TextBlock Classes="status-value" Text="{Binding SelectedFrameStatusText}" />
          </DockPanel>
        </Border>
        <Border Grid.Column="3" Classes="status-cell">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Classes="status-label" Text="Range" />
            <TextBlock Classes="status-value" Text="{Binding TimelineRangeText}" />
          </DockPanel>
        </Border>
        <Border Grid.Column="4" Classes="status-cell">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Classes="status-label" Text="View" />
            <TextBlock Classes="status-value" Text="{Binding ActiveSessionView}" />
          </DockPanel>
        </Border>
        <Border Grid.Column="5" Classes="status-cell">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Classes="status-label" Text="Connection" />
            <TextBlock Classes="status-value" Text="{Binding ConnectionPanelStatusText}" />
          </DockPanel>
        </Border>
        <Border Grid.Column="6" Classes="status-cell">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Classes="status-label" Text="Source" />
            <TextBlock Classes="status-value" Text="{Binding FooterText}" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
