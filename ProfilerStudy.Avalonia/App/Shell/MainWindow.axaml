<suki:SukiWindow
    x:Class="ProfilerStudy.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProfilerStudy.Avalonia"
    xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:stats="clr-namespace:ProfilerStudy.Avalonia.ProfilerStats"
    Title="ProfilerStudy"
    Width="1180"
    Height="760"
    WindowStartupLocation="CenterScreen"
    IsMenuVisible="False"
    MinWidth="860"
    MinHeight="560">
  <suki:SukiWindow.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenSessionCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSessionCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenFindScopeCommand}" />
    <KeyBinding Gesture="Home" Command="{Binding ResetTimelineCommand}" />
    <KeyBinding Gesture="End" Command="{Binding SelectLastFrameCommand}" />
    <KeyBinding Gesture="PageUp" Command="{Binding SelectPreviousSpikeCommand}" />
    <KeyBinding Gesture="PageDown" Command="{Binding SelectNextSpikeCommand}" />
    <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding PanTimelineLeftCommand}" />
    <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding PanTimelineRightCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomTimelineInCommand}" />
    <KeyBinding Gesture="Ctrl+-" Command="{Binding ZoomTimelineOutCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding TrackSelectedFrameCommand}" />
  </suki:SukiWindow.KeyBindings>
  <suki:SukiWindow.Styles>
    <Style Selector="Button.toolbar-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.toolbar-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
    </Style>
    <Style Selector="Button.toolbar-button:pressed">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
    </Style>
    <Style Selector="Button.toolbar-button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.toolbar-button StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar-button Border">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:checked">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="Foreground" Value="{DynamicResource SukiBackground}" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.toolbar-button Border">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.toolbar-gap">
      <Setter Property="Background" Value="{DynamicResource SukiBorderBrush}" />
    </Style>
    <Style Selector="Border.toolbar-panel">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.toolbox-section">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.toolbox-section-header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Button.toolbox-action">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.toolbox-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
    </Style>
    <Style Selector="Button.panel-command">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.panel-command:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiBackground}" />
    </Style>
    <Style Selector="TextBlock.panel-caption">
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.panel-title">
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.startup-action">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource TimelineScopeSubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TimelineScopePanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FontFamily" Value="Microsoft Sans Serif, Segoe UI" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.startup-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource TimelineScopeCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TimelineScopePanelBorderBrush}" />
    </Style>
    <Style Selector="Border.status-cell">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,0,0" />
      <Setter Property="Padding" Value="5,1" />
    </Style>
    <Style Selector="TextBlock.status-label">
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.status-value">
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.document-tab">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.document-info-cell">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="TextBlock.document-label">
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="TextBlock.document-value">
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.overlay-panel">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="0 12 32 0 #66000000" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.overlay-header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Border.overlay-card">
      <Setter Property="Background" Value="{DynamicResource SukiBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9" />
    </Style>
    <Style Selector="Border.overlay-icon">
      <Setter Property="Background" Value="{DynamicResource SukiBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.overlay-close">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
    </Style>
    <Style Selector="Button.overlay-close:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="Foreground" Value="{DynamicResource SukiBackground}" />
    </Style>
    <Style Selector="Button.overlay-action">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </suki:SukiWindow.Styles>
  <Grid Background="{DynamicResource SukiBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="{Binding OutputWindowHeight}" />
      <RowDefinition Height="22" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,0,1" MinHeight="24">
      <Menu Background="Transparent" FontSize="12" Padding="2,0">
        <MenuItem Header="File">
          <MenuItem Header="Open" InputGesture="Ctrl+O" Command="{Binding OpenSessionCommand}" />
          <MenuItem Header="Save" InputGesture="Ctrl+S" Command="{Binding SaveSessionCommand}" />
          <MenuItem Header="Save As..." Command="{Binding SaveSessionAsCommand}" />
          <MenuItem Header="Close" Command="{Binding CloseSessionCommand}" />
          <MenuItem Header="Close All" Command="{Binding CloseSessionCommand}" />
          <Separator />
          <MenuItem Header="Export to CSV" Command="{Binding ExportFramesToCsvCommand}" />
          <MenuItem Header="Export Frame Graph to CSV" Command="{Binding ExportFramesToCsvCommand}" />
          <Separator />
          <MenuItem Header="Recent Files" ItemsSource="{Binding RecentFiles}">
            <MenuItem.ItemTemplate>
              <DataTemplate>
                <MenuItem Header="{Binding}"
                          Command="{Binding $parent[Window].DataContext.OpenRecentSessionCommand}"
                          CommandParameter="{Binding}" />
              </DataTemplate>
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
        </MenuItem>
        <MenuItem Header="View">
          <MenuItem Header="Threads View" ToggleType="Radio" IsChecked="{Binding IsThreadsViewActive, Mode=OneWay}" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" />
          <MenuItem Header="Cores View" ToggleType="Radio" IsChecked="{Binding IsCoresViewActive, Mode=OneWay}" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" />
          <MenuItem Header="Scopes View" ToggleType="Radio" IsChecked="{Binding IsScopesViewActive, Mode=OneWay}" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" />
          <Separator />
          <MenuItem Header="Threads View">
            <MenuItem Header="Info" ToggleType="CheckBox" IsChecked="{Binding IsThreadsInfoPanelVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="Info" />
            <MenuItem Header="Frame Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsFrameGraphVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="FrameGraph" />
            <MenuItem Header="Scope Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsScopeGraphVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="ScopeGraph" />
            <MenuItem Header="CPU Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsCoreGraphVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CoreGraph" />
            <MenuItem Header="Custom Stats Graph" ToggleType="CheckBox" IsChecked="{Binding IsThreadsCustomStatsVisible, Mode=OneWay}" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CustomStats" />
          </MenuItem>
          <MenuItem Header="Scope Colouring">
            <MenuItem Header="Colour by Thread" ToggleType="Radio" IsChecked="{Binding IsScopeColorModeThread, Mode=OneWay}" Command="{Binding SetScopeColorModeCommand}" CommandParameter="Thread" />
            <MenuItem Header="Colour by Scope" ToggleType="Radio" IsChecked="{Binding IsScopeColorModeScope, Mode=OneWay}" Command="{Binding SetScopeColorModeCommand}" CommandParameter="Scope" />
          </MenuItem>
          <Separator />
          <MenuItem Header="Output Window" ToggleType="CheckBox" IsChecked="{Binding IsOutputWindowVisible, Mode=OneWay}" Command="{Binding ToggleOutputWindowCommand}" />
        </MenuItem>
        <MenuItem Header="Theme">
          <MenuItem Header="Base Skin">
            <MenuItem Header="Light" ToggleType="Radio" IsChecked="{Binding IsLightThemeActive, Mode=OneWay}" Command="{Binding SetLightThemeCommand}">
              <MenuItem.Icon>
                <material:MaterialIcon Kind="Lightbulb" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Dark" ToggleType="Radio" IsChecked="{Binding IsDarkThemeActive, Mode=OneWay}" Command="{Binding SetDarkThemeCommand}">
              <MenuItem.Icon>
                <material:MaterialIcon Kind="MoonWaningCrescent" />
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <MenuItem Header="Color Theme" ItemsSource="{Binding ThemeColorOptions}">
            <MenuItem.Icon>
              <material:MaterialIcon Kind="Palette" />
            </MenuItem.Icon>
            <MenuItem.ItemTemplate>
              <DataTemplate>
                <MenuItem Header="{Binding Name}"
                          Command="{Binding $parent[Window].DataContext.SetThemeColorCommand}"
                          CommandParameter="{Binding}">
                  <MenuItem.Icon>
                    <Border Width="12" Height="12" CornerRadius="6" Background="{Binding PrimaryBrush}" />
                  </MenuItem.Icon>
                </MenuItem>
              </DataTemplate>
            </MenuItem.ItemTemplate>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="Connection">
          <MenuItem Header="New Connection..." Command="{Binding OpenConnectionCommand}" />
          <MenuItem Header="Connect..." Command="{Binding OpenConnectionCommand}" />
          <MenuItem Header="Disconnect" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
        </MenuItem>
        <MenuItem Header="Tools">
          <Separator />
          <MenuItem Header="Find" InputGesture="Ctrl+F" Command="{Binding OpenFindScopeCommand}" />
          <Separator />
          <MenuItem Header="Create Session from Selection" Command="{Binding CreateSessionFromSelectionCommand}" />
          <Separator />
          <MenuItem Header="Android">
            <MenuItem Header="Start Recording Context Switches..." Command="{Binding AndroidActionCommand}" CommandParameter="RecordContextSwitches" />
            <MenuItem Header="Load Context Switch File" Command="{Binding AndroidActionCommand}" CommandParameter="LoadContextSwitchFile" />
          </MenuItem>
          <Separator />
          <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}" />
        </MenuItem>
        <MenuItem Header="Help">
          <MenuItem Header="Registration..." Command="{Binding OpenRegistrationCommand}" />
          <MenuItem Header="Check for Updates" Command="{Binding OpenUpdateCheckCommand}" />
          <Separator />
          <MenuItem Header="Demo">
            <MenuItem Header="Launch ProfilerStudy Game Simulator" Command="{Binding DemoActionCommand}" CommandParameter="LaunchGameSimulator" />
            <MenuItem Header="Playback Recording File..." Command="{Binding DemoActionCommand}" CommandParameter="PlaybackRecordingFile" />
          </MenuItem>
          <MenuItem Header="Show Startup Page" Command="{Binding ShowStartupPageCommand}" />
          <Separator />
          <MenuItem Header="About" Command="{Binding OpenAboutCommand}" />
        </MenuItem>
      </Menu>
    </Border>
    <Border Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,0,1" Height="54">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="10,5" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <material:MaterialIcon Kind="Speedometer" Width="24" Height="24" Foreground="{DynamicResource SukiPrimaryColor}" />
          <TextBlock Text="Profiler" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SukiText}" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource SukiBorderBrush}" Margin="2,6" />
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding OpenConnectionCommand}" ToolTip.Tip="Connect to ProfilerStudy">
              <material:MaterialIcon Kind="LanConnect" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding OpenAndroidCommand}" ToolTip.Tip="Android profiler tools">
              <material:MaterialIcon Kind="Android" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" ToolTip.Tip="Disconnect active session">
              <material:MaterialIcon Kind="LanDisconnect" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Border Classes="toolbar-gap" Width="1" Margin="6,8" />
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding ResetTimelineCommand}" ToolTip.Tip="Jump to the start of the frame timeline">
              <material:MaterialIcon Kind="FirstPage" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding TrackSelectedFrameCommand}" ToolTip.Tip="Track selected frame">
              <material:MaterialIcon Kind="CrosshairsGps" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding SelectLastFrameCommand}" ToolTip.Tip="Jump to the latest frame in the session">
              <material:MaterialIcon Kind="LastPage" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding SelectPreviousSpikeCommand}" ToolTip.Tip="Select the previous frame spike">
              <material:MaterialIcon Kind="Undo" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding SelectSlowestFrameCommand}" ToolTip.Tip="Select slowest frame">
              <material:MaterialIcon Kind="SpeedometerSlow" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding SelectNextSpikeCommand}" ToolTip.Tip="Select the next frame spike">
              <material:MaterialIcon Kind="Redo" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Border Classes="toolbar-gap" Width="1" Margin="6,8" />
            <ToggleButton Classes="toolbar-button" Height="40" Width="40" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="Info" IsChecked="{Binding IsThreadsInfoPanelVisible, Mode=OneWay}" ToolTip.Tip="Thread info panel">
              <material:MaterialIcon Kind="InformationOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ToggleButton>
            <ToggleButton Classes="toolbar-button" Height="40" Width="40" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="FrameGraph" IsChecked="{Binding IsThreadsFrameGraphVisible, Mode=OneWay}" ToolTip.Tip="Frame graph panel">
              <material:MaterialIcon Kind="ChartTimelineVariant" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ToggleButton>
            <ToggleButton Classes="toolbar-button" Height="40" Width="40" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CoreGraph" IsChecked="{Binding IsThreadsCoreGraphVisible, Mode=OneWay}" ToolTip.Tip="CPU core graph panel">
              <material:MaterialIcon Kind="Cpu64Bit" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ToggleButton>
            <ToggleButton Classes="toolbar-button" Height="40" Width="40" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="DataGrid" IsChecked="{Binding IsThreadsDataGridVisible, Mode=OneWay}" ToolTip.Tip="Profiler data grids">
              <material:MaterialIcon Kind="Table" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ToggleButton>
            <Border Classes="toolbar-gap" Width="1" Margin="6,8" />
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding ToggleScopeColorModeCommand}" ToolTip.Tip="Toggle scope colouring mode">
              <material:MaterialIcon Kind="Palette" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="toolbar-button" Height="40" Width="40" Command="{Binding OpenCallstacksCommand}" ToolTip.Tip="Callstack capture and symbols">
              <material:MaterialIcon Kind="SourceBranch" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="3" Classes="toolbar-panel" Padding="8,5" MinWidth="280">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
            <material:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ScopeFilterText}" Watermark="Find scope" MinWidth="110" />
            <Button Grid.Column="2" Classes="panel-command" Command="{Binding FindPreviousScopeCommand}" ToolTip.Tip="Previous match">
              <material:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Grid.Column="3" Classes="panel-command" Command="{Binding FindNextScopeCommand}" ToolTip.Tip="Next match">
              <material:MaterialIcon Kind="ChevronRight" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Grid.Column="4" Classes="panel-command" Command="{Binding ClearScopeFindCommand}" ToolTip.Tip="Clear search">
              <material:MaterialIcon Kind="CloseCircleOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Background="Transparent" Margin="8,6,8,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="0" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding ToolboxColumnWidth}" />
        <ColumnDefinition Width="{Binding ToolboxSplitterWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="document-tab" Margin="3,3,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="Profiler Session" Classes="document-value" FontWeight="SemiBold" />
              <TextBlock Text="-" Classes="document-label" />
              <TextBlock Text="{Binding ActiveSessionView}" Classes="document-value" />
            </StackPanel>
          </Border>
          <Grid Grid.Column="1" ColumnDefinitions="2*,Auto,Auto,Auto" Height="26" Margin="0,1,3,0">
            <Border Classes="document-info-cell">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Session:" Classes="document-label" />
                <TextBlock Text="{Binding Summary.SourceName}" Classes="document-value" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="document-info-cell" MinWidth="210">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Range:" Classes="document-label" />
                <TextBlock Text="{Binding TimelineRangeText}" Classes="document-value" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="document-info-cell" MinWidth="175">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Frame:" Classes="document-label" />
                <TextBlock Text="{Binding SelectedFrameStatusText}" Classes="document-value" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{DynamicResource SukiCardBackground}" Padding="7,2">
              <TextBlock Text="{Binding StatusText}" Classes="document-value" />
            </Border>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,1,0" IsVisible="{Binding IsToolboxMinimizedTabVisible}">
        <Button
            Background="{DynamicResource SukiCardBackground}"
            BorderBrush="{DynamicResource SukiBorderBrush}"
            BorderThickness="0"
            Padding="2"
            Command="{Binding RestoreToolboxCommand}"
            ToolTip.Tip="Restore toolbox">
          <TextBlock Text="Toolbox" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SukiText}" FontSize="10" />
        </Button>
      </Border>
      <Border Grid.Row="1" Grid.Column="0" Background="Transparent" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,1,0" IsVisible="{Binding IsToolboxExpanded}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,0,1" Padding="5,3" IsVisible="False">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                <TextBlock Text="{Binding ActiveSessionView}" Foreground="{DynamicResource SukiLowText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="_" Width="22" Height="20" Padding="0" FontSize="10" Command="{Binding MinimizeToolboxCommand}" ToolTip.Tip="Minimize toolbox" />
                <Button Content="□" Width="22" Height="20" Padding="0" FontSize="10" Command="{Binding FloatToolboxCommand}" ToolTip.Tip="Float toolbox" />
                <Button Content="x" Width="22" Height="20" Padding="0" FontSize="11" Command="{Binding ToggleToolboxCommand}" ToolTip.Tip="Close toolbox" />
              </StackPanel>
              <TextBlock Text="Toolbox" Foreground="{DynamicResource SukiText}" FontSize="12" FontWeight="SemiBold" />
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5" Spacing="5">
              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Session Info" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="7" Margin="6">
                    <TextBlock Text="Frames" Foreground="{DynamicResource SukiLowText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.FrameCount}" Foreground="{DynamicResource SukiText}" />
                    <TextBlock Grid.Row="1" Text="Average" Foreground="{DynamicResource SukiLowText}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.AverageFrameTimeText}" Foreground="{DynamicResource SukiText}" />
                    <TextBlock Grid.Row="2" Text="Max" Foreground="{DynamicResource SukiLowText}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Foreground="{DynamicResource SukiText}" />
                    <TextBlock Grid.Row="3" Text="Budget" Foreground="{DynamicResource SukiLowText}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.TargetFrameTimeText}" Foreground="{DynamicResource SukiText}" />
                    <TextBlock Grid.Row="4" Text="Threads" Foreground="{DynamicResource SukiLowText}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.ThreadCount}" Foreground="{DynamicResource SukiText}" />
                    <TextBlock Grid.Row="5" Text="Source" Foreground="{DynamicResource SukiLowText}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="{DynamicResource SukiText}" TextWrapping="Wrap" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="6" ColumnSpacing="4" RowSpacing="4">
                    <Button Classes="toolbox-action" Content="Connect..." Command="{Binding OpenConnectionCommand}" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Android..." Command="{Binding OpenAndroidCommand}" />
                    <Button Grid.Row="1" Grid.ColumnSpan="2" Classes="toolbox-action" Content="Disconnect" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Frame Navigation" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="6" ColumnSpacing="4" RowSpacing="4">
                    <Button Classes="toolbox-action" Content="Start" Command="{Binding ResetTimelineCommand}" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Track" Command="{Binding TrackSelectedFrameCommand}" />
                    <Button Grid.Column="2" Classes="toolbox-action" Content="End" Command="{Binding SelectLastFrameCommand}" />
                    <Button Grid.Row="1" Classes="toolbox-action" Content="Prev Spike" Command="{Binding SelectPreviousSpikeCommand}" />
                    <Button Grid.Row="1" Grid.Column="1" Classes="toolbox-action" Content="Max" Command="{Binding SelectSlowestFrameCommand}" />
                    <Button Grid.Row="1" Grid.Column="2" Classes="toolbox-action" Content="Next Spike" Command="{Binding SelectNextSpikeCommand}" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Window Layout" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="6" Spacing="3">
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}">Threads View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" Foreground="{Binding CoresViewBrush}">Cores View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" Foreground="{Binding ScopesViewBrush}">Scopes View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" Foreground="{Binding CustomStatsViewBrush}">Custom Stats View</Button>
                    <Button Classes="toolbox-action" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" Foreground="{Binding LogViewBrush}">Log View</Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Dock Windows" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="6" ColumnSpacing="4" RowSpacing="4">
                    <TextBlock Text="Main" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreMainSessionDockCommand}" />
                    <Button Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatMainSessionDockCommand}" />
                    <Button Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockMainSessionDockCommand}" />
                    <TextBlock Grid.Row="1" Text="Toolbox" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
                    <Button Grid.Row="1" Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreToolboxCommand}" />
                    <Button Grid.Row="1" Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatToolboxCommand}" />
                    <Button Grid.Row="1" Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockToolboxCommand}" />
                    <TextBlock Grid.Row="2" Text="Output" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
                    <Button Grid.Row="2" Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreOutputWindowCommand}" />
                    <Button Grid.Row="2" Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatOutputWindowCommand}" />
                    <Button Grid.Row="2" Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockOutputWindowCommand}" />
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Threads View Panels" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="6" Spacing="3">
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="Info" Foreground="{Binding ThreadsViewBrush}">Info</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="FrameGraph" Foreground="{Binding ThreadsViewBrush}">Frame Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="ScopeGraph" Foreground="{Binding ThreadsViewBrush}">Scope Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CoreGraph" Foreground="{Binding CoresViewBrush}">Core Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="CustomStats" Foreground="{Binding CustomStatsViewBrush}">Custom Stats Graph</Button>
                    <Button Classes="toolbox-action" Command="{Binding ToggleThreadsPanelCommand}" CommandParameter="DataGrid" Foreground="{Binding ThreadsViewBrush}">Data Grid</Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Find Scope" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  </Border>
                  <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="6" RowSpacing="4">
                    <TextBox Text="{Binding ScopeFilterText}" Watermark="scope text" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="4">
                      <Button Classes="toolbox-action" Content="Prev" Command="{Binding FindPreviousScopeCommand}" />
                      <Button Grid.Column="1" Classes="toolbox-action" Content="Next" Command="{Binding FindNextScopeCommand}" />
                      <Button Grid.Column="2" Classes="toolbox-action" Content="Clear" Command="{Binding ClearScopeFindCommand}" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>

              <Border Classes="toolbox-section">
                <Grid RowDefinitions="Auto,*">
                  <Border Classes="toolbox-section-header">
                    <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  </Border>
                  <StackPanel Grid.Row="1" Margin="6" Spacing="4">
                    <TextBlock Text="Captured root" Foreground="{DynamicResource SukiLowText}" />
                    <TextBox Text="{Binding CapturedSourceRoot}" Watermark="/buildbot/workspace/project" />
                    <TextBlock Text="Local root" Foreground="{DynamicResource SukiLowText}" Margin="0,4,0,0" />
                    <TextBox Text="{Binding LocalSourceRoot}" Watermark="/Users/me/project" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1"
                    Grid.Column="1"
                    Background="{DynamicResource SukiBorderBrush}"
                    BorderBrush="{DynamicResource SukiBorderBrush}"
                    BorderThickness="1,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsVisible="False"
                    ResizeDirection="Columns" />

      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1" Height="28" VerticalAlignment="Top" IsVisible="{Binding IsMainSessionDockMinimizedBarVisible}">
        <DockPanel LastChildFill="True" Margin="7,3">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding ActiveSessionViewTitle}" Foreground="{DynamicResource SukiLowText}" FontSize="11" VerticalAlignment="Center" />
            <Button Content="Restore" Width="70" Height="20" Padding="0" Command="{Binding RestoreMainSessionDockCommand}" />
            <Button Content="x" Width="22" Height="20" Padding="0" Command="{Binding ToggleMainSessionDockCommand}" />
          </StackPanel>
          <TextBlock Text="Main Session View" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" RowDefinitions="*,47" Margin="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" IsVisible="{Binding IsMainSessionDockExpanded}">
        <Grid Grid.Row="0" IsVisible="{Binding IsThreadsViewActive}" Background="{DynamicResource TimelineScopePanelBackgroundBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="{Binding ThreadsInfoPanelHeight}" />
            <RowDefinition Height="{Binding ThreadsFrameScrollbarHeight}" />
            <RowDefinition Height="{Binding ThreadsFrameGraphHeight}" />
            <RowDefinition Height="{Binding ThreadsFrameGraphSplitterHeight}" />
            <RowDefinition Height="{Binding ThreadsScopeGraphHeight}" />
            <RowDefinition Height="{Binding ThreadsScopeGraphSplitterHeight}" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding ThreadsDataGridSplitterWidth}" />
            <ColumnDefinition Width="{Binding ThreadsDataGridColumnWidth}" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Row="0" ColumnDefinitions="32,*" IsVisible="{Binding IsThreadsInfoPanelVisible}">
            <Border Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1">
              <TextBlock Text="INFO"
                         Foreground="{DynamicResource SukiText}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Width="96"
                         TextAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource TimelineScopeCardBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="8,6">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="6" RowSpacing="5">
                <TextBlock Text="Session" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="Frames" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="{Binding StatusBarSessionText}" Foreground="{DynamicResource SukiText}" />
                <TextBlock Grid.Column="4" Text="Threads" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="{Binding Summary.ThreadCount}" Foreground="{DynamicResource SukiText}" />

                <TextBlock Grid.Row="1" Text="Range" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.RangeText}" Foreground="{DynamicResource SukiText}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Avg" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Summary.AverageFrameTimeText}" Foreground="{DynamicResource SukiText}" />
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Max" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding Summary.MaxFrameTimeText}" Foreground="{DynamicResource SukiText}" />

                <TextBlock Grid.Row="2" Text="Target" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.TargetFrameTimeText}" Foreground="{DynamicResource SukiText}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Selected" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedFrameStatusText}" Foreground="{DynamicResource SukiText}" />
                <TextBlock Grid.Row="2" Grid.Column="4" Text="Visible" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding TimelineRangeText}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Row="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" IsVisible="{Binding IsThreadsInfoPanelCollapsed}">
            <Grid ColumnDefinitions="32,*">
              <Border Background="{DynamicResource TimelineScopeSeparatorBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,1,0">
                <TextBlock Text="INFO" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>
              <TextBlock Grid.Column="1" Text="Info hidden" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" Margin="8,0" />
            </Grid>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsFrameGraphVisible}">
            <Border Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1">
              <TextBlock Text="Frame"
                         Foreground="{DynamicResource SukiText}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Width="96"
                         TextAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="0">
              <Grid ColumnDefinitions="193,32">
                <Grid RowDefinitions="60,*">
                  <Border Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" Padding="6,5">
                    <StackPanel Spacing="1">
                      <TextBlock Text="Average Frame" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Text="{Binding Summary.AverageFrameTimeText}" Foreground="{DynamicResource SukiText}" FontFamily="Consolas,Menlo" FontSize="12" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Background="{DynamicResource TimelineScopeCardBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,58">
                      <TextBlock Text="FPS" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Column="1" Text="{Binding Summary.AverageFpsText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Row="1" Text="Max" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Row="2" Text="In Budget" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.FramesInBudgetText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                    </Grid>
                  </Border>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource SukiText}" BorderThickness="0,0,1,0">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="ms" Foreground="{DynamicResource SukiText}" FontFamily="Arial" FontSize="9" HorizontalAlignment="Right" Margin="0,2,5,0" />
                    <Canvas Grid.Row="1">
                      <Line StartPoint="27,4" EndPoint="31,4" Stroke="{DynamicResource SukiText}" StrokeThickness="1" />
                      <Line StartPoint="27,44" EndPoint="31,44" Stroke="{DynamicResource SukiText}" StrokeThickness="1" />
                      <Line StartPoint="27,84" EndPoint="31,84" Stroke="{DynamicResource SukiText}" StrokeThickness="1" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource TimelineScopeRemovedBrush}" Canvas.Left="26" Canvas.Top="56" />
                    </Canvas>
                    <TextBlock Grid.Row="2" Text="0" Foreground="{DynamicResource SukiText}" FontFamily="Arial" FontSize="9" HorizontalAlignment="Right" Margin="0,0,5,2" />
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,1,1" MinHeight="120">
              <stats:ucProfilerStats x:Name="ThreadsProfilerStatsControl"
                                     IsCompactMode="True" />
            </Border>
          </Grid>

          <Border Grid.Row="2" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" IsVisible="{Binding IsThreadsFrameGraphCollapsed}">
            <Grid ColumnDefinitions="32,*">
              <Border Background="{DynamicResource TimelineScopeSeparatorBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,1,0">
                <TextBlock Text="Frame" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>
              <TextBlock Grid.Column="1" Text="Frame Graph hidden" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" Margin="8,0" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsFrameGraphVisible}">
            <Border Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,0,0,1" />
            <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,0,1,1" Padding="3,1">
              <Grid ColumnDefinitions="22,22,*,22,22" ColumnSpacing="3">
                <Button Content="◀" Padding="0" Command="{Binding PanTimelineLeftCommand}" />
                <Button Grid.Column="1" Content="-" Padding="0" Command="{Binding ZoomTimelineOutCommand}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding TimelineRangeText}"
                           Foreground="{DynamicResource SukiLowText}"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="3" Content="+" Padding="0" Command="{Binding ZoomTimelineInCommand}" />
                <Button Grid.Column="4" Content="▶" Padding="0" Command="{Binding PanTimelineRightCommand}" />
            </Grid>
          </Border>

            <Border Grid.Column="2" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,1,1" Padding="3,1">
              <local:SessionScrollbarControl
                  Samples="{Binding FrameSamples}"
                  TargetFrameMs="{Binding Summary.TargetFrameTimeMs}"
                  Viewport="{Binding Viewport}" />
            </Border>
          </Grid>

          <Border Grid.Row="1" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,0,1,1" IsVisible="{Binding IsThreadsFrameGraphCollapsed}">
            <TextBlock Text="Session scrollbar hidden with Frame Graph" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" Margin="8,0" />
          </Border>

          <GridSplitter Grid.Row="3"
                        Background="{DynamicResource TimelineScopeSeparatorBrush}"
                        BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}"
                        BorderThickness="0,1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Rows"
                        IsVisible="{Binding IsThreadsFrameGraphVisible}" />

          <Grid Grid.Row="4" ColumnDefinitions="34,225,*,17" IsVisible="{Binding IsThreadsScopeGraphVisible}">
            <Border Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1">
              <TextBlock Text="Time"
                         Foreground="{DynamicResource SukiText}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Width="96"
                         TextAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.RenderTransform>
              </TextBlock>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="5">
              <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Text="Time Spans" Foreground="{DynamicResource SukiText}" FontFamily="Microsoft Sans Serif, Segoe UI" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="{Binding SelectedFrameScopeSummaryText}" Foreground="{DynamicResource SukiLowText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                <TextBlock Grid.Row="2" Text="{Binding TimelineRangeText}" Foreground="{DynamicResource SukiLowText}" FontSize="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,0,1">
              <local:ThreadTimelineLaneControl
                  Rows="{Binding VisibleThreadScopes}"
                  Samples="{Binding FrameSamples}"
                  Viewport="{Binding Viewport}"
                  Selection="{Binding Selection}"
                  ColorMode="{Binding ScopeColorMode}"
                  OpenScopeSourceCommand="{Binding OpenScopeSourceCommand}"
                  FocusThreadCommand="{Binding FocusThreadCommand}" />
            </Border>

            <Border Grid.Column="3" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" />
          </Grid>

          <Border Grid.Row="4" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" IsVisible="{Binding IsThreadsScopeGraphCollapsed}">
            <Grid ColumnDefinitions="32,*">
              <Border Background="{DynamicResource TimelineScopeSeparatorBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,1,0">
                <TextBlock Text="Time" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>
              <TextBlock Grid.Column="1" Text="Time Spans hidden" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" Margin="8,0" />
            </Grid>
          </Border>

          <GridSplitter Grid.Row="5"
                        Background="{DynamicResource TimelineScopeSeparatorBrush}"
                        BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}"
                        BorderThickness="0,1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Rows"
                        IsVisible="{Binding IsThreadsScopeGraphVisible}" />

          <Grid Grid.Row="6" RowDefinitions="88,4,32,4,69,4,*,0,0,0,0,0,0" Margin="0,3,0,0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}">
            <Grid Grid.Row="4" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsScopeGraphVisible}">
              <Border Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1" />

              <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="0">
                <Grid RowDefinitions="39,30" ColumnDefinitions="*,46">
                  <Button Grid.Column="0"
                          Content="Filter Threads..."
                          HorizontalContentAlignment="Left"
                          Padding="6,2"
                          Command="{Binding SelectSessionViewCommand}"
                          CommandParameter="Threads" />
                  <Button Grid.Column="1"
                          Content="Name"
                          Padding="0"
                          ToolTip.Tip="Show threads by name or by id" />
                  <TextBox Grid.Row="1"
                           Grid.Column="0"
                           Text="{Binding ThreadFilterText}"
                           Margin="0,2,1,0" />
                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Content="X"
                          Padding="0"
                          Margin="0,2,0,0"
                          Command="{Binding ClearThreadFilterCommand}" />
                </Grid>
              </Border>

              <Border Grid.Column="2" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,1,1">
                <local:FrameTimelineControl
                    Samples="{Binding FrameSamples}"
                    TargetFrameMs="{Binding Summary.TargetFrameTimeMs}"
                    Selection="{Binding Selection}"
                    Viewport="{Binding Viewport}" />
              </Border>
            </Grid>

            <GridSplitter Grid.Row="5"
                          Background="{DynamicResource TimelineScopeSeparatorBrush}"
                          BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}"
                          BorderThickness="0,1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsScopeGraphVisible}" />

            <Grid Grid.Row="6" ColumnDefinitions="34,225,*,17" IsVisible="{Binding IsThreadsScopeGraphVisible}">
              <Border Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1">
                <TextBlock Text="Threads"
                           Foreground="{DynamicResource SukiText}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="120"
                           TextAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>

              <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="5">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                  <TextBlock Text="Thread Activity" Foreground="{DynamicResource SukiText}" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Text="{Binding ThreadTimelineSummaryText}" Foreground="{DynamicResource SukiLowText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="2" Text="{Binding Summary.ThreadCountLabel}" Foreground="{DynamicResource SukiLowText}" FontSize="10" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="4" Text="{Binding TimelineRangeText}" Foreground="{DynamicResource SukiLowText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>

              <Border Grid.Column="2" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,0,1">
                <local:ThreadTimelineLaneControl
                    Rows="{Binding VisibleThreadScopes}"
                    Samples="{Binding FrameSamples}"
                    Viewport="{Binding Viewport}"
                    Selection="{Binding Selection}"
                    ColorMode="{Binding ScopeColorMode}"
                    OpenScopeSourceCommand="{Binding OpenScopeSourceCommand}"
                    FocusThreadCommand="{Binding FocusThreadCommand}">
                  <local:ThreadTimelineLaneControl.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Hide" Command="{Binding HideFocusedThreadCommand}" />
                      <Separator />
                      <MenuItem Header="Collapse All" Command="{Binding CollapseAllThreadsCommand}" />
                      <MenuItem Header="Expand All" Command="{Binding ExpandAllThreadsCommand}" />
                      <Separator />
                      <MenuItem Header="Move Up" Command="{Binding MoveFocusedThreadUpCommand}" />
                      <MenuItem Header="Move Down" Command="{Binding MoveFocusedThreadDownCommand}" />
                      <Separator />
                      <MenuItem Header="Settings..." Command="{Binding ThreadSettingsCommand}" />
                    </ContextMenu>
                  </local:ThreadTimelineLaneControl.ContextMenu>
                </local:ThreadTimelineLaneControl>
              </Border>

              <Border Grid.Column="3" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1">
                <Grid RowDefinitions="18,*,18">
                  <Button Content="▲"
                          FontSize="8"
                          Padding="0"
                          BorderThickness="0"
                          Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}"
                          Command="{Binding ScrollThreadTimelineUpCommand}" />
                  <Border Grid.Row="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Margin="2,20,2,20" />
                  <Button Grid.Row="2"
                          Content="▼"
                          FontSize="8"
                          Padding="0"
                          BorderThickness="0"
                          Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}"
                          Command="{Binding ScrollThreadTimelineDownCommand}" />
                </Grid>
              </Border>
            </Grid>

            <Border Grid.Row="6" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" IsVisible="{Binding IsThreadsScopeGraphCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="{DynamicResource TimelineScopeSeparatorBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,1,0">
                  <TextBlock Text="Threads" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <TextBlock Grid.Column="1" Text="Scope Graph hidden" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="7"
                          Background="{DynamicResource TimelineScopeSeparatorBrush}"
                          BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}"
                          BorderThickness="0,1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="False" />

            <Grid Grid.Row="0" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsCoreGraphVisible}">
              <Border Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1">
                <TextBlock Text="Cores"
                           Foreground="{DynamicResource SukiText}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="96"
                           TextAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>

              <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Core Activity" Foreground="{DynamicResource SukiText}" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Text="{Binding CoreSummaryText}" Foreground="{DynamicResource SukiLowText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  <ItemsControl Grid.Row="2" ItemsSource="{Binding CoreRows}" Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding CoreText}" Foreground="{DynamicResource SukiText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>

              <Border Grid.Column="2" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,1,1">
                <local:CoreTimelineStripControl
                    Rows="{Binding CoreRows}"
                    SummaryText="{Binding CoreSummaryText}" />
              </Border>
            </Grid>

            <Border Grid.Row="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" IsVisible="{Binding IsThreadsCoreGraphCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="{DynamicResource TimelineScopeSeparatorBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,1,0">
                  <TextBlock Text="Cores" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <TextBlock Grid.Column="1" Text="Core Graph hidden" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="1"
                          Background="{DynamicResource TimelineScopeSeparatorBrush}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsCoreGraphVisible}" />

            <Grid Grid.Row="2" ColumnDefinitions="34,225,*" IsVisible="{Binding IsThreadsCustomStatsVisible}">
              <Border Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1">
                <TextBlock Text="" />
              </Border>

              <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1">
                <Button Content="Custom Stat..."
                        Padding="6,0"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Command="{Binding SelectSessionViewCommand}"
                        CommandParameter="CustomStats" />
              </Border>

              <Border Grid.Column="2" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,1,1" Padding="6,0">
                <Grid ColumnDefinitions="*,120,120">
                  <stats:ucProfilerStats x:Name="ProfilerStatsControl"
                                          IsVisible="False"
                                          Width="0"
                                          Height="0" />
                  <TextBlock Text="{Binding SelectedFrameCounterSummaryText}"
                             Foreground="{DynamicResource SukiText}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding TimelineRangeText}"
                             Foreground="{DynamicResource SukiLowText}"
                             VerticalAlignment="Center"
                             TextAlignment="Right"
                             TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2"
                          Background="{DynamicResource TimelineScopeSeparatorBrush}"
                          BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}"
                          BorderThickness="1"
                          Margin="8,7,0,7" />
                </Grid>
              </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" IsVisible="{Binding IsThreadsCustomStatsCollapsed}">
              <Grid ColumnDefinitions="32,*">
                <Border Background="{DynamicResource TimelineScopeSeparatorBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,1,0">
                  <TextBlock Text="Stats" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <TextBlock Grid.Column="1" Text="Custom Stats hidden" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="9"
                          Background="{DynamicResource TimelineScopeSeparatorBrush}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="False" />

            <Border Grid.Row="10" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="6" IsVisible="False">
              <Grid RowDefinitions="Auto,96,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Scope Hotspots"
                             Foreground="{DynamicResource SukiText}"
                             FontSize="12"
                             FontWeight="SemiBold" />
                  <TextBox DockPanel.Dock="Right"
                           Text="{Binding ScopeFilterText}"
                           Width="180"
                           Margin="10,0,0,0"
                           Watermark="Filter scopes" />
                  <TextBlock Text="{Binding ScopeHotspotSummaryText}"
                             Foreground="{DynamicResource SukiLowText}"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="5,3">
                  <Grid ColumnDefinitions="*,90,90,90,90,90">
                    <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Total ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Avg ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Average" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Max/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxTime" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="5" Content="Calls/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxCount" Padding="0" HorizontalContentAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource TimelineScopeSeparatorBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                          <Grid ColumnDefinitions="*,90,90,90,90,90">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding AverageTimeText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding MaxTimePerFrameText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{Binding MaxCountPerFrameText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="3"
                          Background="{DynamicResource TimelineScopeSeparatorBrush}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="{Binding IsThreadsCustomStatsVisible}" />

            <Border Grid.Row="8" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="6" IsVisible="False">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Scopes"
                             Foreground="{DynamicResource SukiText}"
                             FontSize="12"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameScopeSummaryText}"
                             Foreground="{DynamicResource SukiLowText}"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Margin="0,5,0,5">
                  <local:SelectedFrameThreadLaneControl Rows="{Binding SelectedFrameScopes}" ColorMode="{Binding ScopeColorMode}" />
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,0,1" Padding="5,3">
                  <Grid ColumnDefinitions="140,*,80,80,220,64">
                    <Button Content="Thread" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Thread" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Scope" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Start ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Start" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Dur ms" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Duration" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Source" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Source" Padding="0" HorizontalContentAlignment="Left" />
                    <TextBlock Grid.Column="5" Text="Open" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" TextAlignment="Right" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameScopes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource TimelineScopeSeparatorBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                          <Grid ColumnDefinitions="140,*,80,80,220,64">
                            <TextBlock Text="{Binding ThreadName}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding IndentedName}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" FontFamily="Menlo,Consolas,monospace" />
                            <TextBlock Grid.Column="2" Text="{Binding StartOffsetText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding SourceText}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="5"
                                    Content="Open"
                                    Padding="6,1"
                                    HorizontalAlignment="Right"
                                    IsEnabled="{Binding CanOpenSource}"
                                    Command="{Binding $parent[Window].DataContext.OpenScopeSourceCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <Border Grid.Row="8" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" IsVisible="False">
              <Grid ColumnDefinitions="32,*">
                <Border Background="{DynamicResource TimelineScopeSeparatorBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,1,0">
                  <TextBlock Text="Data" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <TextBlock Grid.Column="1" Text="Data Grid hidden" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" Margin="8,0" />
              </Grid>
            </Border>

            <GridSplitter Grid.Row="11"
                          Background="{DynamicResource TimelineScopeSeparatorBrush}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          IsVisible="False" />

            <Border Grid.Row="12" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="6" IsVisible="False">
              <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left"
                             Text="Selected Frame Counters"
                             Foreground="{DynamicResource SukiText}"
                             FontSize="12"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedFrameCounterSummaryText}"
                             Foreground="{DynamicResource SukiLowText}"
                             HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="5,3">
                  <Grid ColumnDefinitions="150,*,90,90,80">
                    <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                    <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="Count" Command="{Binding SortTableCommand}" CommandParameter="Counter:Count" Padding="0" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Content="Unit" Command="{Binding SortTableCommand}" CommandParameter="Counter:Unit" Padding="0" HorizontalContentAlignment="Left" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource TimelineScopeSeparatorBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                          <Grid ColumnDefinitions="150,*,90,90,80">
                            <TextBlock Text="{Binding GraphName}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding UnitText}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <GridSplitter Grid.Column="1"
                        Grid.RowSpan="7"
                        Width="4"
                        Background="{DynamicResource TimelineScopeSeparatorBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Columns"
                        IsVisible="{Binding IsThreadsDataGridVisible}" />

          <Border Grid.Column="2"
                  Grid.RowSpan="7"
                  Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}"
                  BorderThickness="1"
                  IsVisible="{Binding IsThreadsDataGridVisible}">
            <Grid RowDefinitions="28,*,4,*,4,*">
              <Border Grid.Row="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                <DockPanel LastChildFill="True">
                  <TextBox DockPanel.Dock="Right"
                           Text="{Binding ScopeFilterText}"
                           Width="140"
                           Margin="6,0,0,0" />
                  <TextBlock Text="Scope Data Grid" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>

              <Border Grid.Row="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Scope Hotspots" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" />
                  <Border Grid.Row="1" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="3,1">
                    <Grid ColumnDefinitions="*,70,64">
                      <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="1" Content="Total" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                      <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{DynamicResource TimelineScopeSeparatorBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                            <Grid ColumnDefinitions="*,70,64">
                              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                              <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <GridSplitter Grid.Row="2" Background="{DynamicResource TimelineScopeSeparatorBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

              <Border Grid.Row="3" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Selected Frame Scopes" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" />
                  <Border Grid.Row="1" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="3,1">
                    <Grid ColumnDefinitions="110,*,70">
                      <Button Content="Thread" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Thread" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="1" Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Scope" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="2" Content="Dur" Command="{Binding SortTableCommand}" CommandParameter="FrameScope:Duration" Padding="0" HorizontalContentAlignment="Right" />
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedFrameScopes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{DynamicResource TimelineScopeSeparatorBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                            <Grid ColumnDefinitions="110,*,70">
                              <TextBlock Text="{Binding ThreadName}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding IndentedName}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" FontFamily="Menlo,Consolas,monospace" />
                              <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <GridSplitter Grid.Row="4" Background="{DynamicResource TimelineScopeSeparatorBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

              <Border Grid.Row="5" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Selected Frame Counters" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" />
                  <Border Grid.Row="1" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,0,1" Margin="0,5,0,0" Padding="3,1">
                    <Grid ColumnDefinitions="120,*,70">
                      <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                      <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{DynamicResource TimelineScopeSeparatorBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                            <Grid ColumnDefinitions="120,*,70">
                              <TextBlock Text="{Binding GraphName}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="0" RowDefinitions="139,24,4,*" ColumnDefinitions="34,225,*" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" IsVisible="{Binding IsCoresViewActive}">
          <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1">
            <TextBlock Text="Frame" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform Angle="-90" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="0">
            <Grid ColumnDefinitions="193,32">
              <Grid RowDefinitions="60,*">
                <Border Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" Padding="6,5">
                  <StackPanel Spacing="1">
                    <TextBlock Text="Average Frame" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Text="{Binding Summary.AverageFrameTimeText}" Foreground="{DynamicResource SukiText}" FontFamily="Consolas,Menlo" FontSize="12" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource TimelineScopeCardBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,0,0">
                  <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,58">
                    <TextBlock Text="FPS" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary.AverageFpsText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Row="1" Text="Max" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Row="2" Text="In Budget" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.FramesInBudgetText}" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SukiText}" FontFamily="Monaco,Consolas" FontSize="10" />
                  </Grid>
                </Border>
              </Grid>
              <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource SukiText}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                  <TextBlock Text="ms" Foreground="{DynamicResource SukiText}" FontFamily="Arial" FontSize="9" HorizontalAlignment="Right" Margin="0,2,5,0" />
                  <Canvas Grid.Row="1">
                    <Line StartPoint="27,4" EndPoint="31,4" Stroke="{DynamicResource SukiText}" StrokeThickness="1" />
                    <Line StartPoint="27,44" EndPoint="31,44" Stroke="{DynamicResource SukiText}" StrokeThickness="1" />
                    <Line StartPoint="27,84" EndPoint="31,84" Stroke="{DynamicResource SukiText}" StrokeThickness="1" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TimelineScopeRemovedBrush}" Canvas.Left="26" Canvas.Top="56" />
                  </Canvas>
                  <TextBlock Grid.Row="2" Text="0" Foreground="{DynamicResource SukiText}" FontFamily="Arial" FontSize="9" HorizontalAlignment="Right" Margin="0,0,5,2" />
                </Grid>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,1,1">
            <stats:ucProfilerStats x:Name="CoresProfilerStatsControl"
                                   IsCompactMode="True" />
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,0,0,1" />
          <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,0,1,1" Padding="3,1">
            <Grid ColumnDefinitions="22,22,*,22,22" ColumnSpacing="3">
              <Button Content="◀" Padding="0" Command="{Binding PanTimelineLeftCommand}" />
              <Button Grid.Column="1" Content="-" Padding="0" Command="{Binding ZoomTimelineOutCommand}" />
              <TextBlock Grid.Column="2" Text="{Binding TimelineRangeText}" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="3" Content="+" Padding="0" Command="{Binding ZoomTimelineInCommand}" />
              <Button Grid.Column="4" Content="▶" Padding="0" Command="{Binding PanTimelineRightCommand}" />
            </Grid>
          </Border>
          <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,0,1,1" Padding="3,1">
            <local:SessionScrollbarControl
                Samples="{Binding FrameSamples}"
                TargetFrameMs="{Binding Summary.TargetFrameTimeMs}"
                Viewport="{Binding Viewport}" />
          </Border>

          <GridSplitter Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource TimelineScopeSeparatorBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

          <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1">
            <TextBlock Text="Cores" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform Angle="-90" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Border>
          <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="5">
            <Grid RowDefinitions="Auto,Auto,*">
              <TextBlock Text="Cores" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" FontSize="11" />
              <TextBlock Grid.Row="1" Text="{Binding CoreSummaryText}" Foreground="{DynamicResource SukiLowText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
              <ItemsControl Grid.Row="2" ItemsSource="{Binding CoreRows}" Margin="0,5,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding CoreText}" Foreground="{DynamicResource SukiText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
          <Border Grid.Row="3" Grid.Column="2" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,1,1">
            <local:CoreTimelineStripControl Rows="{Binding CoreRows}" SummaryText="{Binding CoreSummaryText}" />
          </Border>
        </Grid>

        <Border Grid.Row="0" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="0" IsVisible="{Binding IsScopesViewActive}">
          <Grid RowDefinitions="196,4,*">
            <Grid Grid.Row="0" ColumnDefinitions="34,225,*">
              <Border Grid.Column="0" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,0,1">
                <TextBlock Text="Scopes" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="5">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Scope Graph" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" FontSize="11" />
                  <TextBlock Grid.Row="1" Text="{Binding ScopeHotspotSummaryText}" Foreground="{DynamicResource SukiLowText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="2" Text="{Binding TimelineRangeText}" Foreground="{DynamicResource SukiLowText}" FontSize="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
              <Border Grid.Column="2" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1,1,1">
                <stats:ucProfilerStats x:Name="ScopesProfilerStatsControl"
                                       IsCompactMode="True" />
              </Border>
            </Grid>
            <GridSplitter Grid.Row="1" Background="{DynamicResource TimelineScopeSeparatorBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="0,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" Margin="6">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Scopes" Foreground="{DynamicResource SukiText}" FontSize="11" FontWeight="SemiBold" />
              <TextBox DockPanel.Dock="Right"
                       Text="{Binding ScopeFilterText}"
                       Width="220"
                       Margin="10,0,0,0"
                       />
              <TextBlock Text="{Binding ScopeHotspotSummaryText}" Foreground="{DynamicResource SukiLowText}" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,1,0" Margin="0,4,0,0" Padding="3,1">
              <Grid ColumnDefinitions="*,90,90,90,90,90">
                <Button Content="Scope" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Name" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="Total ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:TotalTime" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="2" Content="Calls" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Calls" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="3" Content="Avg ms" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:Average" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="4" Content="Max/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxTime" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="5" Content="Calls/frame" Command="{Binding SortTableCommand}" CommandParameter="Hotspot:MaxCount" Padding="0" HorizontalContentAlignment="Right" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="{DynamicResource TimelineScopeCardBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ScopeHotspots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                      <Grid ColumnDefinitions="*,90,90,90,90,90">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding TotalCountText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding AverageTimeText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding MaxTimePerFrameText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{Binding MaxCountPerFrameText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="0" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="6" IsVisible="{Binding IsCustomStatsViewActive}">
          <Grid RowDefinitions="Auto,Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Custom Stats" Foreground="{DynamicResource SukiText}" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedFrameCounterSummaryText}" Foreground="{DynamicResource SukiLowText}" FontSize="11" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Grid.Row="1" Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,1,0" Margin="0,4,0,0" Padding="3,1">
              <Grid ColumnDefinitions="150,*,90,90,80">
                <Button Content="Graph" Command="{Binding SortTableCommand}" CommandParameter="Counter:Graph" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="Counter" Command="{Binding SortTableCommand}" CommandParameter="Counter:Counter" Padding="0" HorizontalContentAlignment="Left" />
                <Button Grid.Column="2" Content="Value" Command="{Binding SortTableCommand}" CommandParameter="Counter:Value" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="3" Content="Count" Command="{Binding SortTableCommand}" CommandParameter="Counter:Count" Padding="0" HorizontalContentAlignment="Right" />
                <Button Grid.Column="4" Content="Unit" Command="{Binding SortTableCommand}" CommandParameter="Counter:Unit" Padding="0" HorizontalContentAlignment="Left" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Background="{DynamicResource TimelineScopeCardBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding SelectedFrameCounters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                      <Grid ColumnDefinitions="150,*,90,90,80">
                        <TextBlock Text="{Binding GraphName}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="{DynamicResource SukiText}" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding UnitText}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="0" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" Padding="6" IsVisible="{Binding IsLogViewActive}">
          <Grid RowDefinitions="Auto,*">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Log" Foreground="{DynamicResource SukiText}" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LogSummaryText}" Foreground="{DynamicResource SukiLowText}" FontSize="11" HorizontalAlignment="Right" />
            </DockPanel>
            <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,4,0,0">
              <Border Background="{DynamicResource TimelineScopePanelBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1,1,1,0" Padding="3,1">
                <Grid ColumnDefinitions="58,130,*">
                  <TextBlock Text="#" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="Time" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="Message" Foreground="{DynamicResource SukiText}" FontWeight="SemiBold" />
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" Background="{DynamicResource TimelineScopeCardBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopePanelBorderBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LogRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderThickness="0,0,0,1" Padding="3,1">
                        <Grid ColumnDefinitions="58,130,*">
                          <TextBlock Text="{Binding Index}" Foreground="{DynamicResource SukiText}" />
                          <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{DynamicResource SukiText}" />
                          <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource TimelineScopeSubtleBackgroundBrush}" BorderBrush="{DynamicResource TimelineScopeSeparatorBrush}" BorderThickness="0,1,0,0" Margin="0">
          <Grid RowDefinitions="8,*" ColumnDefinitions="Auto,Auto,Auto,*">
            <Polygon Grid.Row="0" Grid.Column="0" Points="53,0 71,0 62,8" Fill="{DynamicResource TimelineScopeSeparatorBrush}" IsVisible="{Binding IsThreadsViewActive}" />
            <Polygon Grid.Row="0" Grid.Column="1" Points="42,0 60,0 51,8" Fill="{DynamicResource TimelineScopeSeparatorBrush}" IsVisible="{Binding IsCoresViewActive}" />
            <Polygon Grid.Row="0" Grid.Column="2" Points="47,0 65,0 56,8" Fill="{DynamicResource TimelineScopeSeparatorBrush}" IsVisible="{Binding IsScopesViewActive}" />

            <Button Grid.Row="1" Grid.Column="0"
                    Content="Threads"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Threads"
                    Width="124"
                    Padding="10,0"
                    FontFamily="Monaco,Consolas"
                    FontSize="12"
                    Foreground="{Binding ThreadsViewBrush}"
                    Background="Transparent"
                    BorderThickness="0" />
            <Button Grid.Row="1" Grid.Column="1"
                    Content="Cores"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Cores"
                    Width="102"
                    Padding="10,0"
                    FontFamily="Monaco,Consolas"
                    FontSize="12"
                    Foreground="{Binding CoresViewBrush}"
                    Background="Transparent"
                    BorderThickness="0" />
            <Button Grid.Row="1" Grid.Column="2"
                    Content="Scopes"
                    Command="{Binding SelectSessionViewCommand}"
                    CommandParameter="Scopes"
                    Width="112"
                    Padding="10,0"
                    FontFamily="Monaco,Consolas"
                    FontSize="12"
                    Foreground="{Binding ScopesViewBrush}"
                    Background="Transparent"
                    BorderThickness="0" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Background="{DynamicResource SukiBackground}"
            IsVisible="{Binding IsStartupPageVisible}">
      <Grid Margin="12">
        <Border
            Width="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel">
          <Grid RowDefinitions="Auto,1,Auto" ColumnDefinitions="*,220">
            <Border Grid.ColumnSpan="2" Classes="overlay-header">
              <DockPanel>
                <TextBlock Text="ProfilerStudy" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Startup Page" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
                  <Button Classes="overlay-close" Command="{Binding CloseStartupPageCommand}">
                    <material:MaterialIcon Kind="Close" Width="16" Height="16" />
                  </Button>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SukiBorderBrush}" />

            <Grid Grid.Row="2" ColumnDefinitions="*,220">
              <StackPanel Margin="10" Spacing="6">
                <TextBlock Text="Open a profiler capture." Foreground="{DynamicResource SukiText}" FontSize="11" TextWrapping="Wrap" />
                <Button Classes="startup-action" Content="Open Profiler Session..." Command="{Binding OpenSessionCommand}" />
                <Button Classes="startup-action" Content="Load Generated Sample" Command="{Binding LoadSampleCommand}" />
                <Button Classes="startup-action" Content="Connect to ProfilerStudy..." Command="{Binding OpenConnectionCommand}" />
                <Button Classes="startup-action" Content="Connect to Android..." Command="{Binding OpenAndroidCommand}" />
                <Button Classes="startup-action" Content="Close Startup Page" Command="{Binding CloseStartupPageCommand}" />
                <TextBlock Text="Views are available after a session is loaded." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>

              <Border Grid.Column="1" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1,0,0,0" Padding="8">
                <Grid RowDefinitions="Auto,*">
                  <TextBlock Text="Recent Files" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  <ScrollViewer Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Recent profiler captures." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button
                                Classes="startup-action"
                                Content="{Binding}"
                                Command="{Binding $parent[Window].DataContext.OpenRecentSessionCommand}"
                                CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="330"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="36,38,0,0"
            Classes="overlay-panel"
            IsVisible="{Binding IsToolboxFloatingVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
              <Button Content="Dock" Width="48" Height="20" Padding="0" Command="{Binding DockToolboxCommand}" />
              <Button Classes="overlay-close" Command="{Binding ToggleToolboxCommand}">
                <material:MaterialIcon Kind="Close" Width="16" Height="16" />
              </Button>
            </StackPanel>
            <TextBlock Text="Toolbox" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8" Spacing="6">
            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveSessionView}" Foreground="{DynamicResource SukiLowText}" FontSize="11" />
                    <TextBlock Text="Session Info" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                  </DockPanel>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="7" Margin="6">
                  <TextBlock Text="Frames" Foreground="{DynamicResource SukiLowText}" />
                  <TextBlock Grid.Column="1" Text="{Binding Summary.FrameCount}" Foreground="{DynamicResource SukiText}" />
                  <TextBlock Grid.Row="1" Text="Average" Foreground="{DynamicResource SukiLowText}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.AverageFrameTimeText}" Foreground="{DynamicResource SukiText}" />
                  <TextBlock Grid.Row="2" Text="Max" Foreground="{DynamicResource SukiLowText}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.MaxFrameTimeText}" Foreground="{DynamicResource SukiText}" />
                  <TextBlock Grid.Row="3" Text="Threads" Foreground="{DynamicResource SukiLowText}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.ThreadCount}" Foreground="{DynamicResource SukiText}" />
                  <TextBlock Grid.Row="4" Text="Source" Foreground="{DynamicResource SukiLowText}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="{DynamicResource SukiText}" TextWrapping="Wrap" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="6" ColumnSpacing="5" RowSpacing="5">
                  <Button Classes="toolbox-action" Content="Connect..." Command="{Binding OpenConnectionCommand}" />
                  <Button Grid.Column="1" Classes="toolbox-action" Content="Android..." Command="{Binding OpenAndroidCommand}" />
                  <Button Grid.Row="1" Grid.ColumnSpan="2" Classes="toolbox-action" Content="Disconnect" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Frame Navigation" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="6" ColumnSpacing="5" RowSpacing="5">
                  <Button Classes="toolbox-action" Content="Start" Command="{Binding ResetTimelineCommand}" />
                  <Button Grid.Column="1" Classes="toolbox-action" Content="Track" Command="{Binding TrackSelectedFrameCommand}" />
                  <Button Grid.Column="2" Classes="toolbox-action" Content="End" Command="{Binding SelectLastFrameCommand}" />
                  <Button Grid.Row="1" Classes="toolbox-action" Content="Prev Spike" Command="{Binding SelectPreviousSpikeCommand}" />
                  <Button Grid.Row="1" Grid.Column="1" Classes="toolbox-action" Content="Max" Command="{Binding SelectSlowestFrameCommand}" />
                  <Button Grid.Row="1" Grid.Column="2" Classes="toolbox-action" Content="Next Spike" Command="{Binding SelectNextSpikeCommand}" />
                  <Button Grid.Row="2" Classes="toolbox-action" Content="Pan Left" Command="{Binding PanTimelineLeftCommand}" />
                  <Button Grid.Row="2" Grid.Column="1" Classes="toolbox-action" Content="Zoom In" Command="{Binding ZoomTimelineInCommand}" />
                  <Button Grid.Row="2" Grid.Column="2" Classes="toolbox-action" Content="Pan Right" Command="{Binding PanTimelineRightCommand}" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Window Layout" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                </Border>
                <UniformGrid Grid.Row="1" Columns="2" Margin="6" RowSpacing="5" ColumnSpacing="5">
                  <Button Classes="toolbox-action" Content="Threads" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}" />
                  <Button Classes="toolbox-action" Content="Cores" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" Foreground="{Binding CoresViewBrush}" />
                  <Button Classes="toolbox-action" Content="Scopes" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" Foreground="{Binding ScopesViewBrush}" />
                  <Button Classes="toolbox-action" Content="Stats" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" Foreground="{Binding CustomStatsViewBrush}" />
                  <Button Classes="toolbox-action" Content="Log" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" Foreground="{Binding LogViewBrush}" />
                  <Button Classes="toolbox-action" Content="Output" Command="{Binding ToggleOutputWindowCommand}" />
                </UniformGrid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Dock Windows" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="6" ColumnSpacing="5" RowSpacing="5">
                  <TextBlock Text="Main" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreMainSessionDockCommand}" />
                  <Button Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatMainSessionDockCommand}" />
                  <Button Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockMainSessionDockCommand}" />
                  <TextBlock Grid.Row="1" Text="Toolbox" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
                  <Button Grid.Row="1" Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreToolboxCommand}" />
                  <Button Grid.Row="1" Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatToolboxCommand}" />
                  <Button Grid.Row="1" Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockToolboxCommand}" />
                  <TextBlock Grid.Row="2" Text="Output" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
                  <Button Grid.Row="2" Grid.Column="1" Classes="toolbox-action" Content="Restore" Command="{Binding RestoreOutputWindowCommand}" />
                  <Button Grid.Row="2" Grid.Column="2" Classes="toolbox-action" Content="Float" Command="{Binding FloatOutputWindowCommand}" />
                  <Button Grid.Row="2" Grid.Column="3" Classes="toolbox-action" Content="Dock" Command="{Binding DockOutputWindowCommand}" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Find Scope" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                </Border>
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="6" RowSpacing="5">
                  <TextBox Text="{Binding ScopeFilterText}" Watermark="scope text" />
                  <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="5">
                    <Button Classes="toolbox-action" Content="Prev" Command="{Binding FindPreviousScopeCommand}" />
                    <Button Grid.Column="1" Classes="toolbox-action" Content="Next" Command="{Binding FindNextScopeCommand}" />
                    <Button Grid.Column="2" Classes="toolbox-action" Content="Clear" Command="{Binding ClearScopeFindCommand}" />
                  </Grid>
                </Grid>
              </Grid>
            </Border>

            <Border Classes="toolbox-section">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="toolbox-section-header">
                  <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                </Border>
                <StackPanel Grid.Row="1" Margin="6" Spacing="4">
                  <TextBlock Text="Captured root" Foreground="{DynamicResource SukiLowText}" />
                  <TextBox Text="{Binding CapturedSourceRoot}" Watermark="/buildbot/workspace/project" />
                  <TextBlock Text="Local root" Foreground="{DynamicResource SukiLowText}" Margin="0,4,0,0" />
                  <TextBox Text="{Binding LocalSourceRoot}" Watermark="/Users/me/project" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsRegistrationPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Registration" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
            <Button DockPanel.Dock="Right"
                    Classes="overlay-close"
                    Command="{Binding CloseRegistrationCommand}">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="ProfilerStudy Registration" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          <Border Grid.Row="1" Classes="overlay-card">
            <StackPanel Spacing="7">
              <TextBlock Text="This viewer preserves the original ProfilerStudy registration entry point." Foreground="{DynamicResource SukiText}" TextWrapping="Wrap" />
              <TextBlock Text="No license verification service is bundled with this macOS shell. Existing profiler files and sample data can be opened without registration." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="About" Width="86" Command="{Binding OpenAboutCommand}" />
            <Button Content="Close" Width="86" Command="{Binding CloseRegistrationCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsUpdateCheckPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Check for Updates" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
            <Button DockPanel.Dock="Right"
                    Classes="overlay-close"
                    Command="{Binding CloseUpdateCheckCommand}">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="Update Status" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          <Border Grid.Row="1" Classes="overlay-card">
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
              <TextBlock Text="Current version" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Column="1" Text="{Binding AboutVersionText}" Foreground="{DynamicResource SukiText}" />
              <TextBlock Grid.Row="1" Text="Update channel" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="Manual builds from this workspace" Foreground="{DynamicResource SukiText}" />
              <TextBlock Grid.Row="2" Text="Network check" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="Not configured in this build" Foreground="{DynamicResource SukiText}" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="About" Width="86" Command="{Binding OpenAboutCommand}" />
            <Button Content="Close" Width="86" Command="{Binding CloseUpdateCheckCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="560"
            Height="300"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsMainSessionDockFloatingVisible}">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
              <Button Content="Dock" Width="48" Height="20" Padding="0" Command="{Binding DockMainSessionDockCommand}" />
              <Button Classes="overlay-close" Command="{Binding ToggleMainSessionDockCommand}">
                <material:MaterialIcon Kind="Close" Width="16" Height="16" />
              </Button>
            </StackPanel>
            <TextBlock Text="Main Session View" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SukiBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Button Content="Threads" Width="70" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Threads" Foreground="{Binding ThreadsViewBrush}" />
            <Button Content="Cores" Width="58" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Cores" Foreground="{Binding CoresViewBrush}" />
            <Button Content="Scopes" Width="64" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Scopes" Foreground="{Binding ScopesViewBrush}" />
            <Button Content="Custom Stats" Width="92" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Custom Stats" Foreground="{Binding CustomStatsViewBrush}" />
            <Button Content="Log" Width="44" Padding="3,1" Command="{Binding SelectSessionViewCommand}" CommandParameter="Log" Foreground="{Binding LogViewBrush}" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="6" RowSpacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ActiveSessionViewTitle}" Foreground="{DynamicResource SukiText}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource SukiLowText}" FontSize="11" />
          </Grid>
          <Border Grid.Row="1" Classes="overlay-card">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="7">
              <TextBlock Text="Session" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Summary.SourceName}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Text="Range" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TimelineRangeText}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Text="Frame" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFrameStatusText}" Foreground="{DynamicResource SukiText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="3" Text="Scope Graph" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedFrameScopeSummaryText}" Foreground="{DynamicResource SukiText}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="Custom Stats" Foreground="{DynamicResource SukiLowText}" FontWeight="SemiBold" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedFrameCounterSummaryText}" Foreground="{DynamicResource SukiText}" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            Height="220"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,36,36"
            Classes="overlay-panel"
            IsVisible="{Binding IsOutputWindowFloatingVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
              <Button Content="Dock" Width="48" Height="20" Padding="0" Command="{Binding DockOutputWindowCommand}" />
              <Button Classes="overlay-close" Command="{Binding ToggleOutputWindowCommand}">
                <material:MaterialIcon Kind="Close" Width="16" Height="16" />
              </Button>
            </StackPanel>
            <TextBlock Text="Output Window" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          </DockPanel>
        </Border>
        <TextBox Grid.Row="1"
                 Text="{Binding OutputLogText}"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="{DynamicResource SukiBackground}"
                 Foreground="{DynamicResource SukiText}"
                 FontFamily="Microsoft Sans Serif, Segoe UI"
                 FontSize="11" />
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsHelpPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <TextBlock Text="ProfilerStudy Help" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
            <Button DockPanel.Dock="Right"
                    Classes="overlay-close"
                    Command="{Binding CloseHelpCommand}">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="Common actions" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />

          <Border Grid.Row="1" Classes="overlay-card">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
              <TextBlock Text="Open session" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Column="1" Text="File > Open or Ctrl+O" Foreground="{DynamicResource SukiText}" />
              <TextBlock Grid.Row="1" Text="Save session" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="File > Save or Ctrl+S" Foreground="{DynamicResource SukiText}" />
              <TextBlock Grid.Row="2" Text="Find scope" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="Tools > Find or Ctrl+F" Foreground="{DynamicResource SukiText}" />
              <TextBlock Grid.Row="3" Text="Switch views" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="Use the View menu, toolbar, or bottom tabs" Foreground="{DynamicResource SukiText}" />
              <TextBlock Grid.Row="4" Text="Timeline" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="Mouse wheel zooms; drag pans in the ScottPlot timeline controls" Foreground="{DynamicResource SukiText}" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="2"
                     Text="This viewer reuses the legacy ProfilerStudy session core. The toolbar, startup page, and timeline controls map to the original profiler entry points."
                     Foreground="{DynamicResource SukiLowText}"
                     TextWrapping="Wrap" />

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Startup Page" Width="104" Command="{Binding ShowStartupPageCommand}" />
            <Button Content="Close" Width="86" Command="{Binding CloseHelpCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsSettingsPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Settings" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
            <Button DockPanel.Dock="Right"
                    Classes="overlay-close"
                    Command="{Binding CloseSettingsCommand}">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Source Mapping" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          <TextBlock Text="These settings are used when opening captured source paths from profiler scope rows." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
          <TextBlock Text="Captured root" Foreground="{DynamicResource SukiLowText}" Margin="0,4,0,0" />
          <TextBox Text="{Binding CapturedSourceRoot}" Watermark="/buildbot/workspace/project" />
          <TextBlock Text="Local root" Foreground="{DynamicResource SukiLowText}" />
          <TextBox Text="{Binding LocalSourceRoot}" Watermark="/Users/me/project" />
          <Border Classes="overlay-card" Margin="0,6,0,0">
            <TextBlock Text="Changes are saved automatically and reused by the source navigation commands." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" Width="86" Command="{Binding CloseSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsThreadSettingsPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Thread View Settings" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
            <Button DockPanel.Dock="Right"
                    Classes="overlay-close"
                    Command="{Binding CloseThreadSettingsCommand}">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Threads View Panels" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          <TextBlock Text="Show or hide the docked panels used by the Threads view. These controls mirror the View menu and toolbar buttons." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
          <UniformGrid Columns="2" RowSpacing="7" ColumnSpacing="7" Margin="0,4,0,0">
            <ToggleButton Content="Info"
                          IsChecked="{Binding IsThreadsInfoPanelVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="Info" />
            <ToggleButton Content="Frame Graph"
                          IsChecked="{Binding IsThreadsFrameGraphVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="FrameGraph" />
            <ToggleButton Content="Scope Graph"
                          IsChecked="{Binding IsThreadsScopeGraphVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="ScopeGraph" />
            <ToggleButton Content="CPU Graph"
                          IsChecked="{Binding IsThreadsCoreGraphVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="CoreGraph" />
            <ToggleButton Content="Custom Stats Graph"
                          IsChecked="{Binding IsThreadsCustomStatsVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="CustomStats" />
            <ToggleButton Content="Data Grid"
                          IsChecked="{Binding IsThreadsDataGridVisible, Mode=OneWay}"
                          Command="{Binding ToggleThreadsPanelCommand}"
                          CommandParameter="DataGrid" />
          </UniformGrid>
          <Border Classes="overlay-card" Margin="0,6,0,0">
            <TextBlock Text="Lane context commands still operate from the thread graph right-click menu: Hide, Move Up, Move Down, Collapse All, and Expand All." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Collapse All" Width="92" Command="{Binding CollapseAllThreadsCommand}" />
            <Button Content="Expand All" Width="88" Command="{Binding ExpandAllThreadsCommand}" />
            <Button Content="Close" Width="86" Command="{Binding CloseThreadSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsCallstacksPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Callstacks" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
            <Button DockPanel.Dock="Right"
                    Classes="overlay-close"
                    Command="{Binding CloseCallstacksCommand}">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Callstack Tools" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          <TextBlock Text="Enable or disable callstack capture for a live session, then request a module symbol reload for captured sessions." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,4,0,0">
            <Border Width="42" Height="36" Classes="overlay-icon">
              <material:MaterialIcon Kind="CodeBraces" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" />
            </Border>
            <Button Grid.Column="1"
                    Classes="overlay-action"
                    HorizontalContentAlignment="Left"
                    Content="Toggle Live Callstack Recording"
                    Command="{Binding CallstacksActionCommand}"
                    CommandParameter="Capture" />
            <Border Grid.Row="1" Width="42" Height="36" Classes="overlay-icon">
              <material:MaterialIcon Kind="DatabaseEdit" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" />
            </Border>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Classes="overlay-action"
                    HorizontalContentAlignment="Left"
                    Content="Reload Module Symbols"
                    Command="{Binding CallstacksActionCommand}"
                    CommandParameter="Resolve" />
            <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="overlay-card">
              <TextBlock Text="{Binding CallstacksPanelStatusText}" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" Width="86" Command="{Binding CloseCallstacksCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsConnectionPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
            <Button DockPanel.Dock="Right"
                    Classes="overlay-close"
                    Command="{Binding CloseConnectionCommand}">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="ProfilerStudy Connection" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          <TextBlock Text="Connection controls are represented here to match the original profiler entry points." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="84,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,4,0,0">
            <TextBlock Text="Host" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ConnectionHost}" Watermark="localhost" />
            <TextBlock Grid.Row="1" Text="Port" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionPort}" Watermark="8428" />
            <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="overlay-card">
              <TextBlock Text="{Binding ConnectionPanelStatusText}" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="New" Width="74" Command="{Binding ConnectionActionCommand}" CommandParameter="New" />
            <Button Content="Connect" Width="86" Command="{Binding ConnectionActionCommand}" CommandParameter="Connect" />
            <Button Content="Disconnect" Width="92" Command="{Binding ConnectionActionCommand}" CommandParameter="Disconnect" />
            <Button Content="Close" Width="74" Command="{Binding CloseConnectionCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsAndroidPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Android" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
            <Button DockPanel.Dock="Right"
                    Classes="overlay-close"
                    Command="{Binding CloseAndroidCommand}">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="14" Spacing="10">
          <TextBlock Text="Context Switch Tools" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
          <TextBlock Text="Connect to the ProfilerStudy socket exposed by the Android app, or load a recorded context switch file into the active session." Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,4,0,0">
            <Border Width="42" Height="36" Classes="overlay-icon">
              <material:MaterialIcon Kind="Android" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" />
            </Border>
            <Grid Grid.Column="1" ColumnDefinitions="*,64,68" ColumnSpacing="6">
              <TextBox Text="{Binding AndroidEndpoint}" Watermark="localfilesystem:/data/user_de/0/.../files/framepro" />
              <Button Grid.Column="1"
                      Content="Debug"
                      Command="{Binding AndroidActionCommand}"
                      CommandParameter="UseDebugEndpoint" />
              <Button Grid.Column="2"
                      Content="Release"
                      Command="{Binding AndroidActionCommand}"
                      CommandParameter="UseReleaseEndpoint" />
            </Grid>
            <Border Grid.Row="1" Width="42" Height="36" Classes="overlay-icon">
              <material:MaterialIcon Kind="LanConnect" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" />
            </Border>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Connect Android"
                    Command="{Binding AndroidActionCommand}"
                    CommandParameter="ConnectAndroid" />
            <Border Grid.Row="2" Width="42" Height="36" Classes="overlay-icon">
              <material:MaterialIcon Kind="RecordCircle" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" />
            </Border>
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,72,*" ColumnSpacing="6">
              <TextBlock Text="Duration (seconds)" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding AndroidRecordingDuration}" />
              <Button Grid.Column="2"
                      HorizontalContentAlignment="Left"
                      Content="Start Recording Context Switches..."
                      Command="{Binding AndroidActionCommand}"
                      CommandParameter="RecordContextSwitches" />
            </Grid>
            <Border Grid.Row="3" Width="42" Height="36" Classes="overlay-icon">
              <material:MaterialIcon Kind="FileDocument" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" />
            </Border>
            <Button Grid.Row="3"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    Content="Load Context Switch File"
                    Command="{Binding AndroidActionCommand}"
                    CommandParameter="LoadContextSwitchFile" />
            <Border Grid.Row="4" Grid.ColumnSpan="2" Classes="overlay-card">
              <TextBlock Text="{Binding AndroidPanelStatusText}" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" Width="86" Command="{Binding CloseAndroidCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="overlay-panel"
            IsVisible="{Binding IsAboutPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="overlay-header">
          <DockPanel LastChildFill="True">
            <TextBlock Text="About" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
            <Button DockPanel.Dock="Right"
                    Classes="overlay-close"
                    Command="{Binding CloseAboutCommand}">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
            <Border Width="64" Height="64" Classes="overlay-icon">
              <TextBlock Text="FP"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="{DynamicResource SukiText}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Binding AboutProductText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
              <TextBlock Text="ProfilerStudy profiler viewer" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Text="{Binding AboutCopyrightText}" Foreground="{DynamicResource SukiLowText}" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Classes="overlay-card" Padding="10">
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
              <TextBlock Text="Version" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Column="1" Text="{Binding AboutVersionText}" Foreground="{DynamicResource SukiText}" />
              <TextBlock Grid.Row="1" Text="Website" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AboutWebsiteText}" Foreground="{DynamicResource SukiText}" />
              <TextBlock Grid.Row="2" Text="E-mail" Foreground="{DynamicResource SukiLowText}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AboutEmailText}" Foreground="{DynamicResource SukiText}" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="2"
                     Text="This Avalonia shell reuses the legacy ProfilerStudy session core and preserves the original profiler entry points while bringing the UI to macOS."
                     Foreground="{DynamicResource SukiLowText}"
                     TextWrapping="Wrap" />

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Close" Width="86" Command="{Binding CloseAboutCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,1,0,0" IsVisible="{Binding IsOutputWindowMinimizedBarVisible}">
      <DockPanel LastChildFill="True" Margin="7,3">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding SessionStatusText}" Foreground="{DynamicResource SukiLowText}" FontSize="11" VerticalAlignment="Center" />
          <Button Content="Restore" Width="70" Height="20" Padding="0" Command="{Binding RestoreOutputWindowCommand}" />
          <Button Content="x" Width="22" Height="20" Padding="0" Command="{Binding ToggleOutputWindowCommand}" />
        </StackPanel>
        <TextBlock Text="Output Window" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,1,0,0" MinHeight="120" IsVisible="{Binding IsOutputWindowExpanded}">
      <TextBox Text="{Binding OutputLogText}"
               AcceptsReturn="True"
               IsReadOnly="True"
               BorderThickness="0"
               Background="{DynamicResource SukiCardBackground}"
               Foreground="{DynamicResource SukiText}"
               FontFamily="Consolas,Menlo"
               FontSize="11"
               TextWrapping="NoWrap"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Border>

    <Border Grid.Row="4" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="2*,160,180,180,240">
        <Border Classes="status-cell">
          <TextBlock Text="{Binding StatusText}" Classes="status-value" />
        </Border>
        <Border Grid.Column="1" Classes="status-cell">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Session:" Classes="status-label" />
            <TextBlock Text="{Binding StatusBarSessionText}" Classes="status-value" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="status-cell">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Selected:" Classes="status-label" />
            <TextBlock Text="{Binding StatusBarSelectedFrameText}" Classes="status-value" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="status-cell">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Hovered:" Classes="status-label" />
            <TextBlock Text="{Binding StatusBarHoveredFrameText}" Classes="status-value" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="status-cell" BorderThickness="1,1,1,0">
          <TextBlock Text="{Binding TimelineRangeText}" Classes="status-value" TextAlignment="Right" />
        </Border>
      </Grid>
    </Border>

  </Grid>
</suki:SukiWindow>
