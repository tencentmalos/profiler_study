<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>11.0</LangVersion>
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
    <AvaloniaBuildTasksLocation Condition="'$(AvaloniaBuildTasksLocation)' == '' and '$(PkgAvalonia)' != ''">$([System.IO.Path]::Combine('$(PkgAvalonia)', 'tools', 'netstandard2.0', 'Avalonia.Build.Tasks.dll'))</AvaloniaBuildTasksLocation>
    <AvaloniaBuildTasksLocation Condition="'$(AvaloniaBuildTasksLocation)' == '' and '$(NuGetPackageRoot)' != ''">$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'avalonia', '11.3.17', 'tools', 'netstandard2.0', 'Avalonia.Build.Tasks.dll'))</AvaloniaBuildTasksLocation>
    <AssemblyTitle>ProfilerStudy</AssemblyTitle>
    <Product>ProfilerStudy</Product>
    <Description>Cross-platform ProfilerStudy profiler viewer built with Avalonia.</Description>
    <Company>ProfilerStudy</Company>
    <Copyright>Copyright (c) 2026 ProfilerStudy contributors</Copyright>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == 'win-x64'">Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProfilerStudyCore\ProfilerStudyCore.csproj" Properties="TargetFramework=net8.0;TargetFrameworks=net8.0" />
    <ProjectReference Include="..\third_party\ScottPlot\src\ScottPlot5\ScottPlot5 Controls\ScottPlot.Avalonia\ScottPlot.Avalonia.csproj" Properties="TargetFramework=net8.0;TargetFrameworks=net8.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.3.1" />
    <PackageReference Include="SukiUI" Version="6.1.1" />
  </ItemGroup>
</Project>
