<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>11.0</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyTitle>ProfilerStudy</AssemblyTitle>
    <Product>ProfilerStudy</Product>
    <Description>Cross-platform FramePro profiler viewer built with Avalonia.</Description>
    <Company>ProfilerStudy</Company>
    <Copyright>Copyright (c) 2026 ProfilerStudy contributors</Copyright>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProfilerStudyCore\ProfilerStudyCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.0.55" />
  </ItemGroup>
</Project>
