<Application
    x:Class="ProfilerStudy.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:suki="https://github.com/kikipoulet/SukiUI">
  <Application.Styles>
    <FluentTheme />
    <suki:SukiTheme ThemeColor="Blue" />
    <material:MaterialIconStyles />
    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource TimelineScopeTooltipBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TimelineScopeTooltipBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource TimelineScopeTooltipTextBrush}" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
    </Style>
    <Style Selector="MenuItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.timeline-popup-tooltip">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ProfilerStudy.Avalonia/TimelineScope/TimelineScopeThemeResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
